# EditorConfig — https://editorconfig.org

root = true

# Все файлы
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# — Unity-стиль
[*.cs]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_space_after_cast = false
csharp_prefer_braces = true

# Использование var (не заставляем var на int/float/string/bool примитивах)
dotnet_style_predefined_type_for_member_access = true:suggestion
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:silent

# Expression-bodied members (короткий синтаксис =>)
csharp_style_expression_bodied_methods = true:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# Pattern matching
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion

# ── Правила именования (Naming Conventions) ───────────────────────────────
dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_style.camel.capitalization = camel_case

dotnet_naming_style.private_field.required_prefix = _
dotnet_naming_style.private_field.capitalization = camel_case

dotnet_naming_style.static_field.required_prefix = s_
dotnet_naming_style.static_field.capitalization = camel_case

dotnet_naming_style.interface.required_prefix = I
dotnet_naming_style.interface.capitalization = pascal_case

dotnet_naming_style.generic_type.required_prefix = T
dotnet_naming_style.generic_type.capitalization = pascal_case

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_rule.interfaces.symbols = interfaces
dotnet_naming_rule.interfaces.style = interface
dotnet_naming_rule.interfaces.severity = warning

dotnet_naming_symbols.pascal_members.applicable_kinds = namespace, class, struct, enum, delegate, property, method, event, local_function
dotnet_naming_symbols.pascal_members.applicable_accessibilities = *
dotnet_naming_rule.pascal_members.symbols = pascal_members
dotnet_naming_rule.pascal_members.style = pascal
dotnet_naming_rule.pascal_members.severity = warning

dotnet_naming_symbols.locals.applicable_kinds = local, parameter
dotnet_naming_symbols.locals.applicable_accessibilities = *
dotnet_naming_rule.locals.symbols = locals
dotnet_naming_rule.locals.style = camel
dotnet_naming_rule.locals.severity = warning

dotnet_naming_symbols.non_public_fields.applicable_kinds = field
dotnet_naming_symbols.non_public_fields.applicable_accessibilities = private, protected, internal, private_protected, protected_internal
dotnet_naming_rule.non_public_fields.symbols = non_public_fields
dotnet_naming_rule.non_public_fields.style = private_field
dotnet_naming_rule.non_public_fields.severity = warning

dotnet_naming_symbols.non_public_static_fields.applicable_kinds = field
dotnet_naming_symbols.non_public_static_fields.applicable_accessibilities = private, protected, internal, private_protected, protected_internal
dotnet_naming_symbols.non_public_static_fields.required_modifiers = static
dotnet_naming_rule.non_public_static_fields.symbols = non_public_static_fields
dotnet_naming_rule.non_public_static_fields.style = static_field
dotnet_naming_rule.non_public_static_fields.severity = warning

dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.constants.symbols = constants
dotnet_naming_rule.constants.style = pascal
dotnet_naming_rule.constants.severity = warning

# Пересечение: const имеет приоритет над правилом non-public static.
dotnet_naming_symbols.non_public_constants.applicable_kinds = field
dotnet_naming_symbols.non_public_constants.applicable_accessibilities = private, protected, internal, private_protected, protected_internal
dotnet_naming_symbols.non_public_constants.required_modifiers = const
dotnet_naming_rule.non_public_constants.symbols = non_public_constants
dotnet_naming_rule.non_public_constants.style = pascal
dotnet_naming_rule.non_public_constants.severity = warning

dotnet_naming_symbols.public_fields.applicable_kinds = field
dotnet_naming_symbols.public_fields.applicable_accessibilities = public
dotnet_naming_rule.public_fields.symbols = public_fields
dotnet_naming_rule.public_fields.style = pascal
dotnet_naming_rule.public_fields.severity = warning

dotnet_naming_symbols.generic_parameters.applicable_kinds = type_parameter
dotnet_naming_symbols.generic_parameters.applicable_accessibilities = *
dotnet_naming_rule.generic_parameters.symbols = generic_parameters
dotnet_naming_rule.generic_parameters.style = generic_type
dotnet_naming_rule.generic_parameters.severity = warning

# ── Линтер: StyleCop (SA) ──────────────────────────────────────────────────
# Намеренные послабления стиля (не дефекты): file header, XML-доки,
# this.-префикс, _, SNAKE_CASE, порядок членов и туплы не считаем ошибкой.
# Нет file header
dotnet_diagnostic.SA1633.severity = none
# Не требуем this. prefix (стиль)
dotnet_diagnostic.SA1101.severity = none
# using вне namespace — ок
dotnet_diagnostic.SA1200.severity = none
# _underscore поля разрешены
dotnet_diagnostic.SA1309.severity = none
# Подчёркивания (_) в полях/константах
dotnet_diagnostic.SA1310.severity = none
# UPPER_SNAKE_CASE для локальных констант
dotnet_diagnostic.SA1312.severity = none
# Block statements with embedded comments
dotnet_diagnostic.SA1108.severity = none
# Parameter placement on same line
dotnet_diagnostic.SA1117.severity = none
# Tuple element names casing
dotnet_diagnostic.SA1316.severity = none
# Tuple types signature element names
dotnet_diagnostic.SA1414.severity = none
# Одиночный комментарий разрешён
dotnet_diagnostic.SA1512.severity = none
# Пустые строки между элементами не обязательны
dotnet_diagnostic.SA1516.severity = none
# XML-доки не обязательны
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1604.severity = none
dotnet_diagnostic.SA1611.severity = none
dotnet_diagnostic.SA1615.severity = none
dotnet_diagnostic.SA1618.severity = none
dotnet_diagnostic.SA1623.severity = none
dotnet_diagnostic.SA1642.severity = none
dotnet_diagnostic.SA1643.severity = none
# Parameter casing (стиль)
dotnet_diagnostic.SA1313.severity = none
# Multiple blank lines in a row
dotnet_diagnostic.SA1507.severity = none
# Type/field ordering
dotnet_diagnostic.SA1201.severity = none
# Member ordering (public before private)
dotnet_diagnostic.SA1202.severity = none
# Constant field ordering
dotnet_diagnostic.SA1203.severity = none
# Static member ordering
dotnet_diagnostic.SA1204.severity = none
# Readonly field ordering
dotnet_diagnostic.SA1214.severity = none

# ── Линтер: NetAnalyzers (CA) ─────────────────────────────────────────────
# Unity-специфичные none остаются: движок гарантирует null / инжектит поля.
# Unity объекты — null уже гарантирует движок
dotnet_diagnostic.CA1062.severity = none
# Не локализуем строки
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1310.severity = none
# ConfigureAwait — UniTask не требует
dotnet_diagnostic.CA2007.severity = none
# Не глотать все исключения → ОШИБКА
dotnet_diagnostic.CA1031.severity = error
# Не публичные поля → ОШИБКА
dotnet_diagnostic.CA1051.severity = error

# ── Dead code detection (утяжелено до ОШИБКИ) ──────────────────────────────
# Неиспользуемые приватные члены → ОШИБКА
dotnet_diagnostic.IDE0051.severity = error
# Неиспользуемые приватные поля → ОШИБКА
dotnet_diagnostic.IDE0052.severity = error
# Неиспользуемые приватные поля → ОШИБКА
dotnet_diagnostic.CA1823.severity = error
# Метод может быть static → ОШИБКА
dotnet_diagnostic.CA1822.severity = error

# ── Линтер: Roslynator (RCS) ─────────────────────────────────────────────
# Blank lines (стиль)
dotnet_diagnostic.RCS1036.severity = none
# Trailing whitespace в комментарии → ОШИБКА
dotnet_diagnostic.RCS1037.severity = error
# Неиспользуемый параметр → ОШИБКА
dotnet_diagnostic.RCS1118.severity = error
# XML-доки не обязательны
dotnet_diagnostic.RCS1138.severity = none
dotnet_diagnostic.RCS1139.severity = none

# ── Линтер: SonarAnalyzer (S) ─────────────────────────────────────────────
# Unity-коллбеки (S1172/S1186/S101) остаются none: подпись задаёт движок.
# Type naming (стиль)
dotnet_diagnostic.S101.severity = none
# Empty block — пустой catch/if → ОШИБКА
dotnet_diagnostic.S108.severity = error
# Commented out code → warning
dotnet_diagnostic.S125.severity = warning
# Merge if statements
dotnet_diagnostic.S1066.severity = warning

# Unused parameters (Unity callbacks)
dotnet_diagnostic.S1172.severity = none
# Empty methods (Unity callbacks)
dotnet_diagnostic.S1186.severity = none

# Unused local variables → ОШИБКА
dotnet_diagnostic.S1481.severity = error
# Useless assignment → ОШИБКА
dotnet_diagnostic.S1854.severity = error
# Unnecessary cast
dotnet_diagnostic.S1905.severity = warning
# Shift by 0
dotnet_diagnostic.S2183.severity = warning
# Parameter name ordering
dotnet_diagnostic.S2234.severity = warning
# Auto property
dotnet_diagnostic.S2292.severity = warning
# Flags suffix
dotnet_diagnostic.S2344.severity = warning
# Unreachable condition → ОШИБКА
dotnet_diagnostic.S2583.severity = error
# Constant condition → ОШИБКА
dotnet_diagnostic.S2589.severity = error
# Generic static field
dotnet_diagnostic.S2743.severity = warning
# Readonly field можно сделать readonly → ОШИБКА
dotnet_diagnostic.S2933.severity = error
# Member shadowing
dotnet_diagnostic.S3218.severity = warning
# Unused event → ОШИБКА
dotnet_diagnostic.S3264.severity = error
# Nested ternary
dotnet_diagnostic.S3358.severity = warning
# Empty case
dotnet_diagnostic.S3458.severity = warning
# Array creation params
dotnet_diagnostic.S3878.severity = warning
# IDisposable pattern → ОШИБКА
dotnet_diagnostic.S3881.severity = error
# Named namespace for types
dotnet_diagnostic.S3903.severity = warning
# Flags attribute
dotnet_diagnostic.S4070.severity = warning
# Method overloads adjacent
dotnet_diagnostic.S4136.severity = warning
# Find vs FirstOrDefault
dotnet_diagnostic.S6602.severity = warning
# TrueForAll vs All
dotnet_diagnostic.S6603.severity = warning
# Exists vs Any
dotnet_diagnostic.S6605.severity = warning

# ── Линтер: Unity Analyzers (UNT) ────────────────────────────────────────
# Исключения и кастомные переопределения для Unity (остаются none — ложные срабатывания).
# [retired] Time.deltaTime в FixedUpdate
dotnet_diagnostic.UNT0005.severity = none
# Unity null coalescing check
dotnet_diagnostic.UNT0007.severity = none
# Unity null propagation check
dotnet_diagnostic.UNT0008.severity = none
# SetPixels vs SetPixels32
dotnet_diagnostic.UNT0017.severity = none
# Unity-сообщения (Start, Awake) не обязаны быть protected
dotnet_diagnostic.UNT0021.severity = none
# Vector3 -> Vector2 не спамить подсказкой
dotnet_diagnostic.UNT0034.severity = none
# Vector2 -> Vector3 не спамить подсказкой
dotnet_diagnostic.UNT0035.severity = none
# Mesh array access in loop — слишком шумно
dotnet_diagnostic.UNT0042.severity = none
# Опечатка в conditional compilation symbol в НАШЕМ коде → ОШИБКА
dotnet_diagnostic.UNT0043.severity = error

# Vendored VContainer — полностью отключаем внешние анализаторы
[Assets/Scripts/VContainer/**/*.cs]
