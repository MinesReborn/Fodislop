# Third-party packages — подавляем warnings от чужого кода
[Packages/**/*.cs]
# 'new' keyword not required
dotnet_diagnostic.CS0109.severity = none
# Obsolete API usage
dotnet_diagnostic.CS0618.severity = none
# Missing [Serializable]
dotnet_diagnostic.UAC1001.severity = none
dotnet_diagnostic.UNT0043.severity = none
dotnet_diagnostic.UNT0006.severity = none

# Шейдеры
[*.{shader,hlsl,cginc,compute}]
indent_size = 4

# Unity YAML (сцены, префабы, ассеты)
[*.{unity,prefab,asset,mat,anim,controller,mask}]
indent_size = 2
trim_trailing_whitespace = false

# UI Toolkit
[*.{uxml,uss}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# JSON
[*.json]
indent_size = 2
