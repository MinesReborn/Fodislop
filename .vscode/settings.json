{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*": "$(capture).meta",
    "*.cs": "$(capture).g.cs, $(capture).designer.cs, $(capture).generated.cs",
    "*.uxml": "$(capture).uss, $(capture).uxml.cs, $(capture).tss",
    "*.prefab": "$(capture).prefab.meta",
    "*.unity": "$(capture).unity.meta",
    "*.sln": "*.slnx, *.csproj",
    "*.slnx": "*.csproj, *.sln",
    "package.json": "package-lock.json, .yarnrc*, yarn.lock, .npmrc",
    "README*": "AUTHORS, BACKERS*, CHANGELOG*, CITATION*, CODE_OF_CONDUCT*, CONTRIBUTING*, CONTRIBUTORS, DESIGN*, LICENSE*, OPT-IN*, OPT-OUT*, README*, TRADEMARK*, SECURITY*"
  },
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "files.eol": "\n",
  "files.encoding": "utf8",
  "editor.trimAutoWhitespace": true,
  "files.associations": {
    "*.uxml": "xml",
    "*.uss": "css",
    "*.tss": "css",
    "*.compute": "hlsl",
    "*.shader": "hlsl",
    "*.cginc": "hlsl",
    "*.hlsl": "hlsl",
    "*.asmdef": "json",
    "*.asmref": "json"
  },
  "files.watcherExclude": {
    "**/Library/**": true,
    "**/Temp/**": true,
    "**/obj/**": true,
    "**/Build/**": true,
    "**/Logs/**": true,
    "**/ProfilerCaptures/**": true,
    "**/.vs/**": true,
    "**/.git/**": true,
    "**/UserSettings/**": true,
    "**/KernAudio/.cache/**": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/Library": true,
    "**/Temp": true,
    "**/obj": true,
    "**/Build": true,
    "**/Logs": true,
    "**/ProfilerCaptures": true,
    "**/.vs": true,
    "**/UserSettings": true
  },
  "search.exclude": {
    "**/Library": true,
    "**/Temp": true,
    "**/obj": true,
    "**/Build": true,
    "**/Logs": true,
    "**/ProfilerCaptures": true,
    "**/.vs": true,
    "**/*.meta": true,
    "**/*.mapb": true,
    "**/UserSettings": true
  },
  "dotnet.defaultSolution": "Fodislop.slnx",
  "csharp.analyzerDiagnosticScope": "openFiles",
  "csharp.enableImportCompletion": true,
  "csharp.format.enable": true,
  "csharp.enableEditorConfigSupport": true,
  "csharp.suppressHiddenDiagnostics": false,
  "dotnet.server.useOmnisharp": false,
  "vstuc.useInfiniteLoopTimeout": true
}
