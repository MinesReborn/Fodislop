#pragma target 5.0

// ============================================================================
// Lighting Architecture
// ============================================================================
//
// This file is the entry point for the lighting compute shader.
// All stage implementations are in separate .hlsl files included below.
//
// Architecture documentation: docs/architecture/LIGHTING_ARCHITECTURE.md
//
// Stage dependency flow:
//
//   GeometryCache → Cascades → CascadeResolve → Composite
//       ↓              ↓                         ↑
//       └─────────────→ DynamicLight →──────────┘
//
// ============================================================================
// Types & Constants
// ============================================================================

#include "Assets/Resources/Shaders/Lighting/LightingTypes.hlsl"

// ============================================================================
// Shared Variable Declarations
// ============================================================================
//
// All variables used by lighting stages are declared here before includes.
// Each stage accesses only its declared inputs/outputs (see docs/architecture/LIGHTING_ARCHITECTURE.md).

// ============================================================================
// Field Textures
// ============================================================================

Texture2D<float4> _ReanchorMaterial;
Texture2D<float4> _ReanchorEmission;
RWStructuredBuffer<uint> _ReanchorChangeRowsOutput;
StructuredBuffer<uint> _ReanchorChangeRows;
RWStructuredBuffer<uint> _ReanchorChangesOutput;
StructuredBuffer<uint> _ReanchorChanges;
Texture2D<float4> _MaterialField;
Texture2D<float4> _EmissionField;
RWStructuredBuffer<uint3> _RadianceAtlas;
StructuredBuffer<uint3> _RadianceAtlasInput;
RWStructuredBuffer<uint3> _RadianceAtlasOutput;
RWTexture2D<float4> _DirectTexture;
Texture2D<float4> _DirectInput;

// Resolved radiance from the terrain's own emitters, solved separately and kept
// across frames.
//
// Light transport is linear in emission and the medium does not depend on it, so
// solve(terrain + dynamic lights) is exactly solve(terrain) + solve(dynamic lights). Splitting the
// two lets the terrain half survive until geometry actually changes, instead of
// being recomputed every time a dynamic light moves a fraction of a cell - which is what
// made walking cost a full cascade solve per frame.
Texture2D<float4> _StaticDirectInput;

RWTexture2D<float4> _Result;

// ============================================================================
// Geometry Caches
// ============================================================================
//
// Each holds values that depend only on the material field and are rebuilt with
// it, so per-frame kernels read the stored result instead of repeating the same
// marching. They are caches, not approximations: every entry is computed by the
// same expressions the uncached path used.

Texture2D<float4> _CellSolidMask;
RWTexture2D<float4> _CellSolidMaskOutput;
Texture2D<float4> _SurfaceAirCache;
RWTexture2D<float4> _SurfaceAirCacheOutput;
// Summed-area table over the cell grid counting cells that are not clean air.
// Summed-area counts per cell: x = cells that are not clean air, y = cells
// that are not clean stone (BuildCleanCellRows / NonCleanCellCount).
RWStructuredBuffer<uint2> _CleanCellRowsOutput;
StructuredBuffer<uint2> _CleanCellRows;
RWStructuredBuffer<uint2> _CleanCellPrefixOutput;
StructuredBuffer<uint2> _CleanCellPrefix;

RWStructuredBuffer<uint> _LightingCounters;
int _LightingCountersEnabled;
int _UniformCellTraversalEnabled;
StructuredBuffer<int4> _DirtyRegions;
RWStructuredBuffer<uint> _CascadeChangedMask;
int _CascadeChangedMaskCount;
int _DirtyRegionCount;
int _CascadeMaskEnabled;
// Reanchor state is local to a recorded static solve; zero for ordinary solves.
int _CascadeReanchorEnabled;
int _CascadePhaseMatches;
int2 _ReanchorDeltaTexels;
int2 _ReanchorFarDeltaProbes;
int _ReanchorFarPhaseMatches;

// ============================================================================
// Dynamic Lights
// ============================================================================

StructuredBuffer<DynamicLight> _DynamicLights;

int2 _DynamicDispatchOrigin;
int2 _DynamicDispatchSize;
int _DynamicLightIndex;
int _WriteDynamicDirect;
int2 _DynamicTileOffset;
RWTexture2DArray<float4> _DynamicTiles;
Texture2DArray<float4> _DynamicTilesInput;

StructuredBuffer<DynamicTileInfo> _DynamicTileInfos;
int _DynamicTileCount;
int2 _ComposeOrigin;
int2 _ComposeSize;

int2 _DynamicPolarSize;
int2 _DynamicPolarTextureSize;
int _DynamicPolarScalarExtinction;
int _NeutralExtinction;
int _DynamicTilesScalarRadiance;
RWTexture2DArray<float4> _DynamicPolar;
Texture2DArray<float4> _DynamicPolarInput;
int _DynamicPolarLayerOffset;
// Persistent source slot: tile layer of SolveDynamicLighting.
int _DynamicReachIndex;

// Angular horizon per source slot: one radius (transport texels) per polar
// direction and emitter point, [base + point * stride + direction]. Each fan
// thread owns exactly one entry and overwrites it on every trace: no CPU clear,
// no atomics (a SetBufferData clear + InterlockedMax scheme read back zeros and
// cut every light at the near zone). Written by TraceDynamicPolar through the RW
// binding; SolveDynamicLighting reads the read-only binding. `_DynamicHorizonBase`
// = slot * points * stride, `_DynamicHorizonStride` = direction stride.
RWStructuredBuffer<uint> _DynamicHorizon;
StructuredBuffer<uint> _DynamicHorizonInput;
int _DynamicHorizonBase;
int _DynamicHorizonStride;

// ============================================================================
// Shared Parameters
// ============================================================================

// Transport lattice: material, emission, DDA, cascade probes and polar fans.
int2 _FieldSize;
// Receiver lattice: static/dynamic direct, surface cache and the published
// lightmap. Same world rect; an integer number of field texels per light
// texel, so every receiver centre maps to one transport position exactly.
int2 _LightSize;
int _FieldTexelsPerLightTexel;
int2 _CompositeDispatchOrigin;
int2 _CompositeDispatchSize;
int2 _CellGridSize;
float4 _WorldRect;
float4 _AmbientColor;
float4 _EmptyExtinctionRGB;
float4 _SolidExtinctionRGB;
float _EmissionScale;
// One dynamic light below this absolute radiance cannot move any display
// level of the active output (LightingComputeBinder.InvisibleDynamicRadiance).
float _InvisibleDynamicRadiance;
float _MaximumLightMultiplier;
float _CellSize;
float _TransmittanceDebugDistanceCells;
int _DebugView;
int _MaterialYFlip;
int _EnableBilinearFix;

// Плечо отражения поверхности и параметры динамического света: значения живут
// в VisualTuning.cs, объявляются здесь и приходят из LightingComputeBinder.
float _SurfaceReflectionReachCells;
float _DynamicNearCells;
int _DynamicAngularSampleCount;

// Плотность эмиттера по оси: число точек сетки на сторону фонаря. Авторское
// значение живёт в VisualTuning.cs.
int _DynamicEmitterPointsPerAxis;

// Пороги solidity поля материала: авторские значения в VisualTuning.cs.
float _SolidOccupancyThreshold;
float _TransportSolidThreshold;

// ============================================================================
// Cascade Parameters
// ============================================================================

int _CascadeOffset;
int2 _CascadeProbeSize;
int _CascadeProbeSpacing;
int _CascadeDirectionCount;
float2 _CascadeInterval;
float2 _FarCascadeInterval;
int _FarCascadeOffset;
int2 _FarCascadeProbeSize;
int _FarCascadeProbeSpacing;
int _FarCascadeDirectionCount;
int _HasFarCascade;
int _CascadeEntryCount;
int _CascadeDispatchRowWidth;
int2 _CascadeDispatchOrigin;
int2 _CascadeDispatchSize;
int _ScrollCascadeOffset;
int _ScrollCascadeEntryCount;
int2 _ScrollProbeSize;
int _ScrollDirectionCount;
int2 _ScrollDeltaProbes;

// ============================================================================
// Samplers
// ============================================================================

SamplerState sampler_LinearClamp;

// ============================================================================
// Terrain AO (shared with TerrainLook)
// ============================================================================
//
// Числа окклюзии приезжают из TerrainLook — теми же, что уходят в террейн.
// Дублировать их здесь нельзя: отладочный вид разошёлся бы с картинкой молча,
// и врал бы ровно тогда, когда им проверяют подобранное значение.

