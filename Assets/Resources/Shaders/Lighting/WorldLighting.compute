// ============================================================================
// Geometry Cache
// ============================================================================

#include "Assets/Resources/Shaders/Lighting/GeometryCache/GeometryCache.hlsl"

// ============================================================================
// Radiance Cascades
// ============================================================================

#include "Assets/Resources/Shaders/Lighting/Cascades/CascadeTrace.hlsl"
#include "Assets/Resources/Shaders/Lighting/Cascades/CascadeResolve.hlsl"

// ============================================================================
// Dynamic Lights
// ============================================================================

#include "Assets/Resources/Shaders/Lighting/Dynamic/DynamicPolar.hlsl"
#include "Assets/Resources/Shaders/Lighting/Dynamic/DynamicLightTrace.hlsl"

// ============================================================================
// ============================================================================


// ============================================================================
// Composite
// ============================================================================

#include "Assets/Resources/Shaders/Lighting/Composite/CompositeLighting.hlsl"

// Exact dependencies of the newly rasterized transport inputs, on the world
// texel lattice. Two scans form an integral image; each ray-box query is four
// reads regardless of field size. This runs only on a region reanchor.
[numthreads(64, 1, 1)]
void BuildReanchorChangeRows(uint3 id : SV_DispatchThreadID)
{
    int y = (int)id.x;
    if (y >= _FieldSize.y)
    {
        return;
    }
    uint sum = 0u;
    for (int x = 0; x < _FieldSize.x; x++)
    {
        int2 current = int2(x, y);
        int2 previous = current + _ReanchorDeltaTexels;
        bool changed = any(previous < 0) || any(previous >= _FieldSize);
        if (!changed)
        {
            int2 rasterCurrent = current;
            int2 rasterPrevious = previous;
            if (_MaterialYFlip != 0)
            {
                rasterCurrent.y = _FieldSize.y - 1 - rasterCurrent.y;
                rasterPrevious.y = _FieldSize.y - 1 - rasterPrevious.y;
            }
            changed = any(_MaterialField.Load(int3(rasterCurrent, 0)) !=
                _ReanchorMaterial.Load(int3(rasterPrevious, 0))) ||
                any(_EmissionField.Load(int3(rasterCurrent, 0)) !=
                _ReanchorEmission.Load(int3(rasterPrevious, 0)));
        }
        sum += changed ? 1u : 0u;
        _ReanchorChangeRowsOutput[y * _FieldSize.x + x] = sum;
    }
}

[numthreads(64, 1, 1)]
void BuildReanchorChangeColumns(uint3 id : SV_DispatchThreadID)
{
    int x = (int)id.x;
    if (x >= _FieldSize.x)
    {
        return;
    }
    uint sum = 0u;
    for (int y = 0; y < _FieldSize.y; y++)
    {
        int index = y * _FieldSize.x + x;
        sum += _ReanchorChangeRows[index];
        _ReanchorChangesOutput[index] = sum;
    }
}
