#pragma kernel BloomPrefilter
#pragma kernel BloomDownsample
#pragma kernel BloomUpsample
#pragma kernel CompositeFinal

Texture2D<float4> _InputTex;
Texture2D<float4> _SourceTex;
Texture2D<float4> _BaseTex;
Texture2D<float4> _BloomTex;
Texture2D<float4> _HistoryTex;

RWTexture2D<float4> _DestTex;
RWTexture2D<float4> _OutputTex;

SamplerState sampler_LinearClamp;
SamplerState sampler_PointClamp;

float4 _ScreenSize; // x=width, y=height, z=1/width, w=1/height
float4 _SourceTexelSize; // xy=1/source size, zw=source size
float _BloomThreshold;
float _BloomSoftKnee;
float _BloomRadius;
float _BloomScatter;
float4 _BloomTint;
float _BloomIntensity;

float _VignetteIntensity;
float4 _VignetteColor;
float _VignetteSmoothness;
float2 _VignetteCenter;

float _ChromaticAberrationIntensity;

float _Exposure;
float4 _ColorFilter;
float _Contrast;
float _Saturation;
float _Gamma;
float _HdrPaperWhiteScale;
int _ToneMappingEnabled;
float _ToneMappingWhitePoint;

float _EigengrauIntensity;
float4 _EigengrauColor;
float _EigengrauDarknessThreshold;
float _EigengrauNoiseScale;
float _EigengrauAnimationSpeed;
float _Time;

float4 _Advanced0; // local contrast, lens dirt intensity/scale, anamorphic intensity
float4 _Advanced1; // anamorphic length, diffraction, heat intensity/scale
float4 _Advanced2; // glint intensity/threshold, dust intensity/scale
float4 _Advanced3; // dust speed, phosphor mask, dithering, reserved
float4 _Temporal; // persistence intensity/decay, stability, temporal motion blur

float Luminance(float3 color)
{
    return dot(color, float3(0.2126, 0.7152, 0.0722));
}

float LinearToPerceptual(float linearValue)
{
    linearValue = max(linearValue, 0.0);
    return linearValue <= 0.0031308
        ? linearValue * 12.92
        : 1.055 * pow(linearValue, 1.0 / 2.4) - 0.055;
}

// ВНИМАНИЕ при сверке с референсом AgX: он написан на GLSL, а там mat3(...)
// заполняется ПО СТОЛБЦАМ, тогда как в HLSL float3x3(...) — ПО СТРОКАМ.
// Литералы, перенесённые из GLSL один в один, дают транспонированную матрицу.
// Так тут и было: суммы строк выходили [0.927, 1.035, 1.038] вместо единиц,
// то есть матрица переставала сохранять белое, и каждый нейтрально-серый
// уезжал в красноту тем сильнее, чем ярче — до 13/255 на входе 2.0.
// Проверка при любой правке: суммы строк обеих матриц обязаны быть 1.0.
float3 ToneMapAgX(float3 color, float whitePoint)
{
    color = max(color / max(whitePoint, 0.001), 0.0);
    const float3x3 inset = float3x3(
        0.842479, 0.078434, 0.079224,
        0.042328, 0.878469, 0.079166,
        0.042376, 0.078434, 0.879143);
    const float3x3 outset = float3x3(
         1.196879, -0.098021, -0.099030,
        -0.052897,  1.151903, -0.098961,
        -0.052972, -0.098043,  1.151074);
    color = mul(inset, color);
    color = clamp(log2(max(color, 1e-6)), -12.47393, 4.026069);
    color = (color + 12.47393) / 16.5;
    float3 x2 = color * color;
    float3 x4 = x2 * x2;
    color = 15.5 * x4 * x2 - 40.14 * x4 * color + 31.96 * x4 -
        6.868 * x2 * color + 0.4298 * x2 + 0.1191 * color - 0.00232;
    color = max(mul(outset, color), 0.0);
    // Кривая AgX выдаёт display-encoded значение, а camera target у URP линеен
    // и кодируется ещё раз при финальном блите. Без обратной линеаризации
    // кодирование происходит дважды: полутона всплывают, кадр становится
    // молочным. Возврат в линейное — часть тонмапа, не опция.
    //
    // Показатель здесь же и есть калибровочная гамма дисплея, и это её
    // единственное законное место: тут `color` лежит в 0..1, поэтому
    // изменение показателя двигает полутона и не может вынести света за
    // пределы диапазона. Раньше гамма стояла ОТДЕЛЬНЫМ блоком ПЕРЕД тонмапом,
    // над сцен-линейными значениями, где показатель степени не является
    // гаммой ничего: при 1.8 шейдер возводил кадр в степень 1.222, и всё
    // ярче единицы РАЗДУВАЛОСЬ — 8.0 превращалось в 12.7, а тени
    // одновременно давились. Ровно это и читалось как пересвет.
    return pow(color, max(_Gamma, 0.1));
}

float Hash31(float3 p)
{
    p = frac(p * float3(0.1031, 0.1030, 0.0973));
    p += dot(p, p.yzx + 33.33);
    return frac((p.x + p.y) * p.z);
}

float FilmGrain(float2 pixel)
{
    // Grain is defined directly in physical screen pixels. Old serialized
    // scale values are clamped here so they can never create giant cells.
    float grainSize = clamp(_EigengrauNoiseScale, 0.75, 2.0);
    float2 grainPixel = floor(pixel / grainSize);
    float frame = _Time * clamp(_EigengrauAnimationSpeed, 1.0, 60.0);
    float epoch = floor(frame);
    float phase = frac(frame);
    float blend = phase * phase * (3.0 - 2.0 * phase);

    float previous = Hash31(float3(grainPixel, epoch * 1.618 + 17.0));
    float next = Hash31(float3(grainPixel, (epoch + 1.0) * 1.618 + 17.0));
    return lerp(previous, next, blend) * 2.0 - 1.0;
}

[numthreads(8, 8, 1)]
void BloomPrefilter(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_ScreenSize.x || id.y >= (uint)_ScreenSize.y) return;

    float2 uv = (id.xy + 0.5) * _ScreenSize.zw;

    // Prefilter directly to half resolution. Four source taps retain small
    // emissive sprites without paying for a separate full-resolution pass.
    float2 halfTexel = _SourceTexelSize.xy * 0.5;
    float4 color =
        _InputTex.SampleLevel(sampler_LinearClamp, uv + float2(-halfTexel.x, -halfTexel.y), 0) +
        _InputTex.SampleLevel(sampler_LinearClamp, uv + float2( halfTexel.x, -halfTexel.y), 0) +
        _InputTex.SampleLevel(sampler_LinearClamp, uv + float2(-halfTexel.x,  halfTexel.y), 0) +
        _InputTex.SampleLevel(sampler_LinearClamp, uv + float2( halfTexel.x,  halfTexel.y), 0);
    color *= 0.25;

    float lum = Luminance(color.rgb);
    float knee = max(_BloomThreshold * _BloomSoftKnee, 0.0001);
    float soft = clamp(lum - _BloomThreshold + knee, 0.0, 2.0 * knee);
    soft = soft * soft / (4.0 * knee + 0.0001);
    float contribution = max(lum - _BloomThreshold, soft) / max(lum, 0.0001);
    float3 brightColor = color.rgb * contribution;

    // Потолок яркостного отбора. Без него вклад в пирамиду растёт линейно с
    // HDR и ничем не ограничен: эмиссия руды идёт до 8.0 линейных, при пороге
    // 1.5 в пирамиду уходит 6.5, тогда как освещённая земля стоит 0.1..0.3.
    // Один источник оказывается на порядок ярче фона, и после размытия
    // красит молочной вуалью весь кадр — при этом сам он всё равно уже упёрся
    // в верхушку кривой AgX, то есть от лишней яркости не становится ярче.
    // Четыре — примерно два стопа над порогом: света остаются светами, но
    // перестают быть источником общей засветки. Ограничение инженерное, как
    // и clamp размера зерна ниже, поэтому живёт здесь, а не в PostProcessLook.
    const float maxBloomSource = 4.0;
    float brightLuminance = Luminance(brightColor);
    if (brightLuminance > maxBloomSource)
    {
        brightColor *= maxBloomSource / brightLuminance;
    }

    _DestTex[id.xy] = float4(brightColor * _BloomTint.rgb, color.a);
}

[numthreads(8, 8, 1)]
void BloomDownsample(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_ScreenSize.x || id.y >= (uint)_ScreenSize.y) return;

    float2 uv = (id.xy + 0.5) * _ScreenSize.zw;

    float2 texel = _SourceTexelSize.xy;

    // Dual Kawase downsample: four bilinear taps cover a wider source area
    // than a same-cost point convolution and need no separate horizontal pass.
    float2 offset = texel * _BloomRadius;
    float4 color =
        _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2(-offset.x, -offset.y), 0) +
        _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2( offset.x, -offset.y), 0) +
        _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2(-offset.x,  offset.y), 0) +
        _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2( offset.x,  offset.y), 0);
    color *= 0.25;

    _DestTex[id.xy] = color;
}

[numthreads(8, 8, 1)]
void BloomUpsample(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_ScreenSize.x || id.y >= (uint)_ScreenSize.y) return;

    float2 uv = (id.xy + 0.5) * _ScreenSize.zw;
    float2 texel = _SourceTexelSize.xy;
    float4 highRes = _BaseTex.SampleLevel(sampler_LinearClamp, uv, 0);

    // Dual Kawase reconstruction. Bilinear filtering performs the interpolation
    // in hardware, so four taps replace the previous nine-tap tent kernel.
    float2 offset = texel * (_BloomRadius * 0.5);
    float4 lowRes =
        _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2(-offset.x, -offset.y), 0) +
        _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2( offset.x, -offset.y), 0) +
        _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2(-offset.x,  offset.y), 0) +
        _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2( offset.x,  offset.y), 0);
    lowRes *= 0.25;

    _DestTex[id.xy] = highRes + lowRes * _BloomScatter;
}

[numthreads(8, 8, 1)]
void CompositeFinal(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_ScreenSize.x || id.y >= (uint)_ScreenSize.y) return;

    float2 uv = (id.xy + 0.5) * _ScreenSize.zw;

    if (_Advanced1.z > 0.001)
    {
        float heatNoise = Hash31(float3(
            floor(uv * _ScreenSize.xy / max(_Advanced1.w, 0.25)),
            _Time * 7.0)) * 2.0 - 1.0;
        float sourceHeat = smoothstep(
            0.35,
            1.5,
            Luminance(_InputTex.SampleLevel(sampler_LinearClamp, uv, 0).rgb));
        uv = clamp(
            uv + float2(heatNoise, -heatNoise * 0.35) *
                _ScreenSize.zw * _Advanced1.z * sourceHeat * 24.0,
            0.0,
            1.0);
    }

    // 1. Chromatic Aberration
    // Alpha was previously discarded here and the final write below hardcoded
    // 1.0 - harmless for the opaque gameplay camera, but it meant any camera
    // relying on this pass for a transparent composite (e.g. an offscreen UI
    // render) always came out as a solid opaque block regardless of its own
    // clear settings.
    float3 color;
    float srcAlpha = _InputTex.SampleLevel(sampler_PointClamp, uv, 0).a;
    if (_ChromaticAberrationIntensity > 0.001)
    {
        float2 distFromCenter = uv - float2(0.5, 0.5);
        float2 offset = distFromCenter * _ChromaticAberrationIntensity * 0.02;

        float r = _InputTex.SampleLevel(sampler_PointClamp, uv - offset, 0).r;
        float g = _InputTex.SampleLevel(sampler_PointClamp, uv, 0).g;
        float b = _InputTex.SampleLevel(sampler_PointClamp, uv + offset, 0).b;
        color = float3(r, g, b);
    }
    else
    {
        color = _InputTex.SampleLevel(sampler_PointClamp, uv, 0).rgb;
    }

    // 2. Bloom Composition
    if (_BloomIntensity > 0.001 ||
        _Advanced0.y > 0.001 ||
        _Advanced0.w > 0.001 ||
        _Advanced1.y > 0.001)
    {
        float3 bloom = _BloomTex.SampleLevel(sampler_LinearClamp, uv, 0).rgb;
        float3 opticalContribution = 0.0;
        if (_Advanced0.w > 0.001)
        {
            float streakOffset = _Advanced1.x * _ScreenSize.z * 12.0;
            float3 streak =
                _BloomTex.SampleLevel(sampler_LinearClamp, uv + float2(streakOffset, 0.0), 0).rgb +
                _BloomTex.SampleLevel(sampler_LinearClamp, uv - float2(streakOffset, 0.0), 0).rgb +
                _BloomTex.SampleLevel(sampler_LinearClamp, uv + float2(streakOffset * 2.0, 0.0), 0).rgb +
                _BloomTex.SampleLevel(sampler_LinearClamp, uv - float2(streakOffset * 2.0, 0.0), 0).rgb;
            opticalContribution += streak * (0.125 * _Advanced0.w);
        }

        if (_Advanced1.y > 0.001)
        {
            float diffractionOffset = _Advanced1.y * _ScreenSize.z * 6.0;
            float diffractionWeight = saturate(_Advanced1.y) * 0.25;
            float diffractedR = _BloomTex.SampleLevel(
                sampler_LinearClamp,
                uv + float2(diffractionOffset, 0.0),
                0).r;
            float diffractedB = _BloomTex.SampleLevel(
                sampler_LinearClamp,
                uv - float2(diffractionOffset, 0.0),
                0).b;
            opticalContribution.r += diffractedR * diffractionWeight;
            opticalContribution.b += diffractedB * diffractionWeight;
        }

        if (_Advanced0.y > 0.001)
        {
            float2 dirtCell = floor(uv * _ScreenSize.xy / (64.0 * max(_Advanced0.z, 0.25)));
            float dirt = smoothstep(0.35, 0.85, Hash31(float3(dirtCell, 19.37)));
            opticalContribution += bloom * dirt * (_Advanced0.y * 0.35);
        }

        color += bloom * _BloomIntensity + opticalContribution;
    }

    if (_Advanced0.x > 0.001)
    {
        float2 contrastOffset = _ScreenSize.zw * 2.0;
        float3 localMean =
            _InputTex.SampleLevel(sampler_LinearClamp, uv + float2( contrastOffset.x,  contrastOffset.y), 0).rgb +
            _InputTex.SampleLevel(sampler_LinearClamp, uv + float2(-contrastOffset.x,  contrastOffset.y), 0).rgb +
            _InputTex.SampleLevel(sampler_LinearClamp, uv + float2( contrastOffset.x, -contrastOffset.y), 0).rgb +
            _InputTex.SampleLevel(sampler_LinearClamp, uv + float2(-contrastOffset.x, -contrastOffset.y), 0).rgb;
        // Нерезкая маска считается по ОТНОШЕНИЮ в логарифме, а не по разности
        // в линейном. Разность в сцен-линейном HDR ничем не ограничена: рядом с
        // источником в 8.0 линейных `color - mean` — это единицы, и добавка
        // выбивала кромку в белое вместо того, чтобы поднять локальный
        // контраст. В логарифме та же сила означает «столько-то долей стопа»
        // независимо от абсолютной яркости, и светлая кромка усиливается
        // ровно так же, как тёмная.
        float3 logColor = log2(max(color, 1e-4));
        float3 logMean = log2(max(localMean * 0.25, 1e-4));
        color = exp2(logColor + (logColor - logMean) * _Advanced0.x);
    }

    if (_Advanced2.x > 0.001)
    {
        float excess = saturate((Luminance(color) - _Advanced2.y) * 2.0);
        float2 glintCell = abs(frac((id.xy + 0.5) / 7.0) - 0.5);
        float cross = exp2(-80.0 * min(glintCell.x, glintCell.y));
        color += color * excess * cross * _Advanced2.x;
    }

    if (_Advanced2.z > 0.001)
    {
        float2 dustUv = uv * max(_Advanced2.w, 0.1) * 24.0;
        dustUv += float2(_Time * _Advanced3.x, -_Time * _Advanced3.x * 0.37);
        float dustEpoch = floor(_Time * _Advanced3.x * 4.0);
        float dust = Hash31(float3(floor(dustUv), dustEpoch));
        dust = smoothstep(0.82, 1.0, dust) * saturate(Luminance(color));
        color += dust * _Advanced2.z * float3(0.8, 0.9, 1.0);
    }

    // 4. Color Grading. Every neutral value is an exact no-op.
    color *= exp2(_Exposure) * _ColorFilter.rgb;

    // Contrast. Опорная точка — 0.18, средне-серый в ЛИНЕЙНОМ пространстве,
    // а не 0.5: до тонмапа кадр линейный и сцен-референсный, и 0.5 в нём не
    // середина ничего. С опорой на 0.5 любой ненулевой контраст утягивал всю
    // картинку в тень, потому что почти вся сцена лежит ниже опоры.
    if (abs(_Contrast) > 0.001)
    {
        const float contrastPivot = 0.18;
        color = (color - contrastPivot) * (1.0 + _Contrast) + contrastPivot;
    }

    // Saturation
    if (abs(_Saturation - 1.0) > 0.001)
    {
        float lum = Luminance(color);
        color = lerp(float3(lum, lum, lum), color, _Saturation);
    }
    color = max(0.0, color);

    // HDR Paper White scaling
    if (abs(_HdrPaperWhiteScale - 1.0) > 0.001 && _HdrPaperWhiteScale > 0.01)
    {
        color *= _HdrPaperWhiteScale;
    }

    // 5. Vignette
    if (_VignetteIntensity > 0.001)
    {
        float aspect = _ScreenSize.x / max(_ScreenSize.y, 1.0);
        float2 centeredUv = (uv - _VignetteCenter) * float2(aspect, 1.0);
        float distanceFromCenter = length(centeredUv);
        float feather = max(_VignetteSmoothness, 0.001);
        float edgeMask = smoothstep(0.5 - feather * 0.5, 0.5 + feather * 0.5, distanceFromCenter);
        color = lerp(color, _VignetteColor.rgb, saturate(edgeMask * _VignetteIntensity));
    }

    // SDR needs range reduction before display encoding. When HDR output is
    // active, C# disables this curve so scene-linear highlights survive for
    // URP's final HDR gamut/transfer encoding.
    if (_ToneMappingEnabled != 0)
    {
        color = ToneMapAgX(max(color, 0.0), _ToneMappingWhitePoint);
    }

    // 6. Eigengrau: fine, zero-mean film grain in dark areas. This is not a
    // bright overlay and contains no low-frequency or scrolling texture.
    if (_EigengrauIntensity > 0.001)
    {
        // The camera target is linear. Darkness Threshold is exposed in
        // perceptual space; comparing it directly to linear luminance made
        // ordinary lit pixels look "dark" and spread grain over the screen.
        float perceptualLuminance = LinearToPerceptual(Luminance(color));
        float threshold = max(_EigengrauDarknessThreshold, 0.0001);
        float darkness = 1.0 - smoothstep(threshold * 0.2, threshold, perceptualLuminance);
        darkness = darkness * darkness * darkness;

        float grain = FilmGrain(id.xy + 0.5);
        float amplitude = 0.01 * saturate(_EigengrauIntensity) * darkness;
        float maxTint = max(max(_EigengrauColor.r, _EigengrauColor.g), _EigengrauColor.b);
        float3 grainTint = maxTint > 0.0001
            ? lerp(float3(1.0, 1.0, 1.0), _EigengrauColor.rgb / maxTint, 0.35)
            : float3(1.0, 1.0, 1.0);
        color = max(0.0, color + grain * amplitude * grainTint);
    }

    // Физика дисплея. Оба эффекта описывают то, что происходит С СИГНАЛОМ НА
    // ПАНЕЛИ, поэтому оба заданы в кодах дисплея и оба обязаны применяться в
    // display-encoded пространстве. После тонмапа color вернулся в линейное,
    // так что кодируем один раз, применяем оба, возвращаем обратно.
    //
    // Для дизеринга это принципиально: бандинг возникает при квантовании в
    // 8 бит, квантуется display-encoded сигнал, отсюда деление на 255. У
    // чёрного наклон sRGB равен 12.92 — прибавка 1/255 прямо к линейному
    // значению дала бы в тенях шаг примерно в тринадцать раз крупнее и
    // видимый шум вместо снятия бандинга.
    //
    // Для фосфорной маски — вопрос силы: множитель 1.08 задан как доля кода
    // дисплея, а в линейном та же доля составляет 1.18, то есть маска
    // применялась вдвое сильнее задуманного.
    if (_Advanced3.y > 0.001 || _Advanced3.z > 0.001)
    {
        float3 encoded = pow(max(color, 0.0), 1.0 / 2.2);

        if (_Advanced3.y > 0.001)
        {
            uint channel = id.x % 3;
            float3 phosphor = channel == 0
                ? float3(1.08, 0.96, 0.96)
                : (channel == 1 ? float3(0.96, 1.08, 0.96) : float3(0.96, 0.96, 1.08));
            encoded *= lerp(1.0, phosphor, _Advanced3.y);
        }

        if (_Advanced3.z > 0.001)
        {
            float dither = Hash31(float3(id.xy, 43.17)) - 0.5;
            encoded += dither * (_Advanced3.z / 255.0);
        }

        color = pow(max(encoded, 0.0), 2.2);
    }

    if (_Temporal.x > 0.001 || _Temporal.z > 0.001 || _Temporal.w > 0.001)
    {
        float3 history = _HistoryTex.SampleLevel(sampler_LinearClamp, uv, 0).rgb;
        float2 texel = _ScreenSize.zw;
        float3 sourceCenter = _InputTex.SampleLevel(sampler_PointClamp, uv, 0).rgb;
        float3 left = _InputTex.SampleLevel(sampler_PointClamp, uv - float2(texel.x, 0.0), 0).rgb;
        float3 right = _InputTex.SampleLevel(sampler_PointClamp, uv + float2(texel.x, 0.0), 0).rgb;
        float3 down = _InputTex.SampleLevel(sampler_PointClamp, uv - float2(0.0, texel.y), 0).rgb;
        float3 up = _InputTex.SampleLevel(sampler_PointClamp, uv + float2(0.0, texel.y), 0).rgb;
        float3 sourceDeviation = max(
            max(abs(left - sourceCenter), abs(right - sourceCenter)),
            max(abs(down - sourceCenter), abs(up - sourceCenter)));

        // Отклонение соседей измерено по ИСХОДНОЙ сцене — линейный HDR, где
        // яркости уходят далеко за единицу. Границы клампа нужны в том
        // пространстве, где сейчас лежит color: после блума, грейдинга и
        // тонмапа. Складывать их напрямую нельзя, и раньше складывали:
        // в светах границы получались втрое шире нужного, кламп не держал
        // историю вовсе и давал шлейф, а в тенях — вчетверо у́же, и кламп
        // съедал эффект целиком. Переносим отклонение через конвейер первым
        // порядком: во сколько раз изменился сам пиксель, во столько же
        // масштабируется его окрестность.
        // Потолок 16 обязателен: на границе яркого объекта с чёрным фоном
        // sourceCenter уходит в ноль, а отклонение остаётся большим, и
        // отношение улетает в тысячи — кламп снова перестал бы работать.
        float3 pipelineTransfer = clamp(color / max(sourceCenter, 1e-4), 0.0, 16.0);
        float3 deviation = sourceDeviation * pipelineTransfer;

        float3 neighbourhoodMin = max(0.0, color - deviation);
        float3 neighbourhoodMax = color + deviation;

        float3 stableHistory = clamp(history, neighbourhoodMin, neighbourhoodMax);
        color = lerp(color, stableHistory, saturate(_Temporal.z));
        float3 persistence = max(color, history * saturate(_Temporal.y));
        color = lerp(color, persistence, saturate(_Temporal.x));

        float temporalDifference = Luminance(abs(color - history));
        float motionWeight = saturate(temporalDifference * 4.0) *
            saturate(_Temporal.w) * 0.5;
        color = lerp(color, stableHistory, motionWeight);
    }

    _OutputTex[id.xy] = float4(color, srcAlpha);
}
