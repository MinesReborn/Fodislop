#pragma kernel ScopesClear
#pragma kernel ScopesGather
#pragma kernel HistogramResolve
#pragma kernel WaveformResolve
#pragma kernel VectorscopeResolve
#pragma multi_compile _ HDR_COLORSPACE_CONVERSION

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Color.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/HDROutput.hlsl"

// ============================================================================
// Приборы разбора кадра: гистограмма, waveform, вектороскоп.
// ============================================================================
//
// ЗАЧЕМ. Кривую нельзя настраивать «на глаз»: глаз адаптируется, а отсечка в
// светах и подъём в тенях на глаз не видны вовсе, пока не станут грубыми.
// Колорист смотрит на приборы, а не на картинку, — и здесь то же самое.
//
// ГДЕ СНИМАЕТСЯ. По умолчанию после всего постпроцесса, с готового кадра.
// UI также может поставить pass перед грейдом, чтобы сравнить BEFORE и AFTER.
//
// ПОЧЕМУ БУФЕРЫ, А НЕ АТОМАРНЫЕ ТЕКСТУРЫ. Накопление идёт через
// InterlockedAdd по RWStructuredBuffer. Атомарные операции над RWTexture2D
// поддержаны не везде — на Metal, где проект и разрабатывается, их применимость
// ограничена, и прибор молча считал бы мусор. Буфер работает всюду одинаково.
//
// ЦЕНА. Три основных буфера и маленький буфер статистики — около полмегабайта.
// Разбор
// живёт только пока открыто рабочее место, и вне его ядра не запускаются.

#define SCOPE_BINS 256
#define SCOPE_SIZE 256
#define SCOPE_PLANE (SCOPE_SIZE * SCOPE_SIZE)

RWStructuredBuffer<uint> _HistogramBuffer;    // 4 * 256: R, G, B, яркость
RWStructuredBuffer<uint> _WaveformBuffer;     // 4 * 256 * 256: R, G, B, luma — столбец x уровень
RWStructuredBuffer<uint> _VectorscopeBuffer;  // 256 * 256, плоскость Cb/Cr
RWStructuredBuffer<uint> _ScopeStatsBuffer;   // [0] black, [1] highlight samples
RWStructuredBuffer<uint> _ExposureHistogramBuffer; // luma histogram in stops relative to paper white

Texture2D<float4> _ScopeSource;
RWTexture2D<float4> _ScopeOutput;
SamplerState sampler_LinearClamp;

float4 _ScopeSourceSize;  // xy = размер источника, zw = 1/размер
float4 _ScopeParams;      // x = histogram norm, y = шаг, z/w = waveform/vector norm
float _ScopeSignalScale;  // HDR: configured peak -> 1; SDR: 1
float _ScopeExposureScale; // scene-linear/paper-white units for exposure measurement
int _ScopeHistogramMode;  // 0 = RGB + luma, 1 = luma, 2 = RGB
float _ScopeVectorscopeScale;
int _ScopeShowSkinToneLine;
int _ScopeWaveformMode;   // 0 = RGB overlay, 1 = RGB parade, 2 = luma

float ScopeLuminance(float3 color)
{
    return dot(color, float3(0.2126, 0.7152, 0.0722));
}

// Перцептивное кодирование перед раскладкой по корзинам. Прибор в линейном
// свете бесполезен: девять десятых корзин пришлись бы на света, а тени, где и
// живут интересные решения, слиплись бы в первую корзину.
float ScopeEncode(float linearValue)
{
    linearValue = saturate(linearValue);
    return linearValue <= 0.0031308
        ? linearValue * 12.92
        : 1.055 * pow(linearValue, 1.0 / 2.4) - 0.055;
}

uint ScopeBin(float encoded)
{
    return (uint)clamp(encoded * (SCOPE_BINS - 1), 0.0, SCOPE_BINS - 1);
}

[numthreads(8, 8, 1)]
void ScopesClear(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= SCOPE_SIZE || id.y >= SCOPE_SIZE)
    {
        return;
    }

    uint index = id.y * SCOPE_SIZE + id.x;
    _WaveformBuffer[0 * SCOPE_PLANE + index] = 0;
    _WaveformBuffer[1 * SCOPE_PLANE + index] = 0;
    _WaveformBuffer[2 * SCOPE_PLANE + index] = 0;
    _WaveformBuffer[3 * SCOPE_PLANE + index] = 0;
    _VectorscopeBuffer[index] = 0;
    if (id.x == 0 && id.y == 0)
    {
        _ScopeStatsBuffer[0] = 0;
        _ScopeStatsBuffer[1] = 0;
    }

    if (id.y == 0)
    {
        _ExposureHistogramBuffer[id.x] = 0;
    }

    // Первые четыре строки сетки заодно накрывают все 4*256 корзин
    // гистограммы — отдельное ядро ради тысячи обнулений не нужно.
    if (id.y < 4)
    {
        _HistogramBuffer[id.y * SCOPE_BINS + id.x] = 0;
    }
}

[numthreads(8, 8, 1)]
void ScopesGather(uint3 id : SV_DispatchThreadID)
{
    uint step = (uint)max(_ScopeParams.y, 1.0);
    uint2 pixel = id.xy * step;
    if (pixel.x >= (uint)_ScopeSourceSize.x || pixel.y >= (uint)_ScopeSourceSize.y)
    {
        return;
    }

    float3 color = _ScopeSource[pixel].rgb * _ScopeSignalScale;
#if defined(HDR_COLORSPACE_CONVERSION)
    // These diagnostic axes are Rec.709, independent of the HDR output gamut.
    color = RotateOutputSpaceToRec709(color);
#endif
    float3 exposureColor = max(color * (_ScopeExposureScale / _ScopeSignalScale), 0.0);
    float exposureLuma = max(ScopeLuminance(exposureColor), exp2(-12.0));
    float exposureStops = log2(exposureLuma);
    uint exposureBin = (uint)clamp(
        ((exposureStops + 12.0) / 24.0) * SCOPE_BINS,
        0.0,
        SCOPE_BINS - 1);
    InterlockedAdd(_ExposureHistogramBuffer[exposureBin], 1);

    if (any(color <= 0.0))
    {
        InterlockedAdd(_ScopeStatsBuffer[0], 1);
    }
    if (any(color >= 1.0))
    {
        InterlockedAdd(_ScopeStatsBuffer[1], 1);
    }
    color = max(color, 0.0);
    float3 encoded = float3(
        ScopeEncode(color.r), ScopeEncode(color.g), ScopeEncode(color.b));
    float luma = ScopeEncode(ScopeLuminance(color));

    InterlockedAdd(_HistogramBuffer[0 * SCOPE_BINS + ScopeBin(encoded.r)], 1);
    InterlockedAdd(_HistogramBuffer[1 * SCOPE_BINS + ScopeBin(encoded.g)], 1);
    InterlockedAdd(_HistogramBuffer[2 * SCOPE_BINS + ScopeBin(encoded.b)], 1);
    InterlockedAdd(_HistogramBuffer[3 * SCOPE_BINS + ScopeBin(luma)], 1);

    // Waveform: горизонталь прибора — горизонталь кадра. Именно это отличает
    // его от гистограммы: видно не только что пересвет есть, но и где он.
    // Парад RGB, а не одна яркость: по яркостному waveform не увидеть, какой
    // канал упёрся в потолок первым, — а это и есть первый вопрос при разборе
    // пересвета и единственный способ поймать цветной сдвиг в светах.
    uint column = (uint)clamp(
        (pixel.x / max(_ScopeSourceSize.x, 1.0)) * (SCOPE_SIZE - 1), 0.0, SCOPE_SIZE - 1);
    InterlockedAdd(_WaveformBuffer[0 * SCOPE_PLANE + ScopeBin(encoded.r) * SCOPE_SIZE + column], 1);
    InterlockedAdd(_WaveformBuffer[1 * SCOPE_PLANE + ScopeBin(encoded.g) * SCOPE_SIZE + column], 1);
    InterlockedAdd(_WaveformBuffer[2 * SCOPE_PLANE + ScopeBin(encoded.b) * SCOPE_SIZE + column], 1);
    InterlockedAdd(_WaveformBuffer[3 * SCOPE_PLANE + ScopeBin(luma) * SCOPE_SIZE + column], 1);

    // Вектороскоп: плоскость цветности Cb/Cr по BT.709. Радиус — насыщенность,
    // угол — оттенок. На нём и видно, уводит ли кривая света по цвету.
    float y = ScopeLuminance(color);
    float cb = (color.b - y) * 0.5389;
    float cr = (color.r - y) * 0.6350;
    uint2 scopePixel = (uint2)clamp(
        float2(cb, cr) * (SCOPE_SIZE * 0.5) + (SCOPE_SIZE * 0.5),
        0.0,
        SCOPE_SIZE - 1);
    InterlockedAdd(_VectorscopeBuffer[scopePixel.y * SCOPE_SIZE + scopePixel.x], 1);
}

// Логарифмическая шкала отклика: в кадре почти всегда есть несколько корзин на
// порядки выше прочих (небо, фон), и по линейной шкале всё остальное легло бы
// в неразличимую полоску у нуля.
float ScopeResponse(uint count, float normalization)
{
    return saturate(log2(1.0 + count * normalization) / 8.0);
}

float ScopeLine(float distance, float width)
{
    return 1.0 - smoothstep(width, width * 2.0, distance);
}

float ScopeTargetDot(float2 centered, float2 target)
{
    return ScopeLine(distance(centered, target), 0.018);
}

float3 ScopeVectorscopeOverlay(float2 centered)
{
    float radius = length(centered);
    float3 overlay = 0.0;

    // Круги 75% и 100% насыщенности, плюс центральный crosshair.
    float ring75 = ScopeLine(abs(radius - 0.75), 0.012);
    float ring100 = ScopeLine(abs(radius - 1.0), 0.012);
    float cross = max(
        ScopeLine(abs(centered.x), 0.006),
        ScopeLine(abs(centered.y), 0.006));
    overlay += (ring75 + ring100) * 0.22;
    overlay += cross * 0.16;

    // Координаты target-плашек BT.709 в той же Cb/Cr системе, что и gather.
    float3 targetColors[6] = {
        float3(1.0, 0.0, 0.0), // R
        float3(1.0, 0.0, 1.0), // Mg
        float3(0.0, 0.0, 1.0), // B
        float3(0.0, 1.0, 1.0), // Cy
        float3(0.0, 1.0, 0.0), // G
        float3(1.0, 1.0, 0.0), // Y
    };
    float3 targetWeights = float3(0.0, 0.0, 0.0);
    for (int targetIndex = 0; targetIndex < 6; targetIndex++)
    {
        float targetLuma = ScopeLuminance(targetColors[targetIndex]);
        float2 target = float2(
            (targetColors[targetIndex].b - targetLuma) * 0.5389,
            (targetColors[targetIndex].r - targetLuma) * 0.6350) * 2.0;
        float weight75 = ScopeTargetDot(centered, target * 0.75);
        float weight100 = ScopeTargetDot(centered, target);
        float weight = max(weight75, weight100 * 0.85);
        targetWeights = max(targetWeights, targetColors[targetIndex] * weight);
    }

    // Классическая skin-tone line: направление от центра в сторону R с
    // небольшим отрицательным Cb, заданное в координатах этого прибора.
    if (_ScopeShowSkinToneLine != 0)
    {
        float2 skinDirection = normalize(float2(-0.24, 0.97));
        float skinDistance = abs(centered.x * skinDirection.y - centered.y * skinDirection.x);
        float skinAlong = dot(centered, skinDirection);
        float skinLine = ScopeLine(skinDistance, 0.012) * step(0.0, skinAlong);
        overlay = max(overlay, float3(0.82, 0.55, 0.2) * skinLine * 0.8);
    }

    return max(overlay, targetWeights);
}

[numthreads(8, 8, 1)]
void HistogramResolve(uint3 id : SV_DispatchThreadID)
{
    uint2 size;
    _ScopeOutput.GetDimensions(size.x, size.y);
    if (id.x >= size.x || id.y >= size.y)
    {
        return;
    }

    uint bin = (uint)clamp(
        (id.x / max((float)size.x, 1.0)) * SCOPE_BINS, 0.0, SCOPE_BINS - 1);
    // Ноль строки — низ прибора: в текстуре начало координат сверху.
    float height = 1.0 - (id.y / max((float)size.y - 1.0, 1.0));

    float3 bars = float3(
        ScopeResponse(_HistogramBuffer[0 * SCOPE_BINS + bin], _ScopeParams.x),
        ScopeResponse(_HistogramBuffer[1 * SCOPE_BINS + bin], _ScopeParams.x),
        ScopeResponse(_HistogramBuffer[2 * SCOPE_BINS + bin], _ScopeParams.x));
    float luma = ScopeResponse(_HistogramBuffer[3 * SCOPE_BINS + bin], _ScopeParams.x);

    float3 rgb = step(height, bars);
    float grey = step(height, luma) * 0.35;
    float3 output = _ScopeHistogramMode == 1
        ? float3(grey, grey, grey)
        : (_ScopeHistogramMode == 2 ? rgb : max(rgb, grey));
    _ScopeOutput[id.xy] = float4(output, 1.0);
}

[numthreads(8, 8, 1)]
void WaveformResolve(uint3 id : SV_DispatchThreadID)
{
    uint2 size;
    _ScopeOutput.GetDimensions(size.x, size.y);
    if (id.x >= size.x || id.y >= size.y)
    {
        return;
    }

    float normalizedX = id.x / max((float)size.x, 1.0);
    uint panel = _ScopeWaveformMode == 1
        ? min((uint)(normalizedX * 3.0), 2u)
        : 0u;
    float panelX = _ScopeWaveformMode == 1
        ? normalizedX * 3.0 - panel
        : normalizedX;
    uint column = (uint)clamp(
        panelX * SCOPE_SIZE, 0.0, SCOPE_SIZE - 1);
    uint level = (uint)clamp(
        (1.0 - id.y / max((float)size.y - 1.0, 1.0)) * (SCOPE_SIZE - 1),
        0.0,
        SCOPE_SIZE - 1);

    uint cell = level * SCOPE_SIZE + column;
    float3 parade = float3(
        ScopeResponse(_WaveformBuffer[0 * SCOPE_PLANE + cell], _ScopeParams.z),
        ScopeResponse(_WaveformBuffer[1 * SCOPE_PLANE + cell], _ScopeParams.z),
        ScopeResponse(_WaveformBuffer[2 * SCOPE_PLANE + cell], _ScopeParams.z));
    if (_ScopeWaveformMode == 2)
    {
        float signal = ScopeResponse(_WaveformBuffer[3 * SCOPE_PLANE + cell], _ScopeParams.z);
        parade = float3(signal, signal, signal);
    }
    else if (_ScopeWaveformMode == 1)
    {
        float signal = parade[panel];
        parade = panel == 0 ? float3(signal, 0.0, 0.0)
            : panel == 1 ? float3(0.0, signal, 0.0)
            : float3(0.0, 0.0, signal);
    }
    // Наложением, а не тремя панелями рядом: при наложении серое пятно прямо
    // означает сведённые каналы, а любой цветной отлив — что они разошлись.
    _ScopeOutput[id.xy] = float4(parade, 1.0);
}

[numthreads(8, 8, 1)]
void VectorscopeResolve(uint3 id : SV_DispatchThreadID)
{
    uint2 size;
    _ScopeOutput.GetDimensions(size.x, size.y);
    if (id.x >= size.x || id.y >= size.y)
    {
        return;
    }

    float2 uv = float2(id.x / max((float)size.x - 1.0, 1.0),
                       1.0 - id.y / max((float)size.y - 1.0, 1.0));
    float2 centered = uv * 2.0 - 1.0;
    float2 zoomedCentered = centered * _ScopeVectorscopeScale;
    float2 zoomedUv = zoomedCentered * 0.5 + 0.5;
    uint2 sourcePixel = (uint2)clamp(zoomedUv * (SCOPE_SIZE - 1), 0.0, SCOPE_SIZE - 1);
    float value = ScopeResponse(
        _VectorscopeBuffer[sourcePixel.y * SCOPE_SIZE + sourcePixel.x], _ScopeParams.w);

    // Подложка окрашена по тому же Cb/Cr, что и накопление: точка, попавшая в
    // жёлтый сектор, светится на жёлтом фоне, и читать оттенок можно без
    // легенды.
    float3 tint = saturate(float3(
        0.5 + zoomedCentered.y / 0.6350,
        0.5 - (zoomedCentered.x * 0.1146 / 0.5389 + zoomedCentered.y * 0.2989 / 0.6350) / 0.7152,
        0.5 + zoomedCentered.x / 0.5389));

    float3 targetOverlay = ScopeVectorscopeOverlay(zoomedCentered);
    _ScopeOutput[id.xy] = float4(max(tint * value, targetOverlay), 1.0);
}
