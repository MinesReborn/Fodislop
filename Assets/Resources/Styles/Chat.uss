/* ═══════════════════════════════════════════════════════════
   Chat — стили чата
   ═══════════════════════════════════════════════════════════ */

.chat-container {
    background-color: var(--surface-panel);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-md);
    padding: var(--space-6);
    width: 400px;
    max-height: 300px;
}

.chat-scroll {
    flex-grow: 1;
    margin-bottom: var(--space-3);
}

.chat-message {
    font-size: var(--size-sm);
    color: var(--text-primary);
    padding: var(--space-1);
    white-space: normal;
    overflow: hidden;
}

.chat-input {
    background-color: var(--surface-shelf-solid);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-4);
    color: var(--text-primary);
    font-size: var(--size-sm);
}

/* ─── Глобальный чат (GlobalChatUI) ─── */

.gchat-panel {
    position: absolute;
    right: 10px;
    top: 50%;
    translate: 0 -50%;
    width: 340px;
    height: 420px;
    background-color: var(--surface-slate-dense);
    border-width: 2px;
    border-color: var(--accent-cyan-deep);
    padding: var(--space-4);
    flex-direction: column;
}

.gchat-header {
    font-size: var(--size-base);
    -unity-font-style: bold;
    color: var(--accent-gold);
    margin-bottom: var(--space-2);
}

.gchat-channel-tabs {
    flex-direction: row;
    margin-bottom: var(--space-3);
}

.gchat-channel-button {
    flex-grow: 1;
    height: 26px;
    padding: 0 var(--space-4);
    background-color: var(--surface-shelf-dense);
    border-width: 1px;
    border-color: var(--border-line);
    color: var(--text-secondary);
    -unity-text-align: middle-center;
}

.gchat-channel-button--active {
    background-color: var(--accent-gold-glow);
    border-color: var(--accent-gold);
    color: var(--light-solid);
}

.gchat-mute-status {
    color: var(--accent-gold);
    margin-bottom: var(--space-3);
    white-space: normal;
}

.gchat-scroll {
    flex-grow: 1;
    margin-bottom: var(--space-3);
    background-color: var(--surface-void-haze);
    border-width: 1px;
    border-color: var(--border-line);
}

.gchat-message {
    font-size: var(--size-sm);
    color: var(--light-solid);
    margin-bottom: var(--space-1);
    padding-left: var(--space-1);
    padding-right: var(--space-1);
    white-space: normal;
    overflow: hidden;
    -unity-font-style: normal;
}

.gchat-bottom-row {
    flex-direction: row;
    height: 28px;
    flex-shrink: 0;
    flex-grow: 0;
}

.gchat-input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: var(--size-sm);
    color: var(--light-solid);
    background-color: transparent;
    border-width: 1px;
    border-color: var(--border-line);
    padding: var(--space-1) var(--space-2);
}

.gchat-send-button {
    width: 32px;
    flex-shrink: 0;
    padding: 0;
    background-color: var(--surface-shelf-solid);
    color: var(--light-solid);
    font-size: var(--size-base);
    -unity-text-align: middle-center;
    border-width: 1px;
    border-left-width: 0;
    border-color: var(--border-line);
}

.gchat-color-button {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    padding: 0;
    border-width: 1px;
    border-left-width: 0;
    border-color: var(--border-line);
}

.gchat-color-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 170px;
    flex-shrink: 0;
    justify-content: center;
    background-color: var(--surface-shelf-dense);
    border-width: 1px;
    border-color: var(--border-line);
    padding: var(--space-2);
}

.gchat-swatch {
    width: 20px;
    height: 20px;
    margin: 1px;
    padding: 0;
    border-width: 1px;
    border-color: var(--text-disabled);
}

.gchat-internal-input {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
    font-size: var(--size-base);
    color: var(--light-solid);
}

/* ─── Локальный чат (LocalChatPopup) ─── */

.lchat-overlay {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 400px;
    height: 36px;
    background-color: var(--surface-abyss-dense);
    border-width: 2px;
    border-color: var(--accent-cyan-deep);
    padding: var(--space-1) var(--space-2);
    flex-direction: row;
    align-items: center;
}

.lchat-prompt {
    font-size: var(--size-base);
    color: var(--accent-gold);
    margin-right: var(--space-2);
    -unity-font-style: bold;
}

.lchat-input {
    flex-grow: 1;
    font-size: var(--size-base);
    color: var(--light-solid);
    background-color: transparent;
    border-width: 0;
    padding: 0;
    -unity-font-style: normal;
}

.lchat-internal-input {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    color: var(--light-solid);
}
