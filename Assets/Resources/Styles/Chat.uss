/* ═══════════════════════════════════════════════════════════
   Chat — стили чата
   ═══════════════════════════════════════════════════════════ */

.chat-container {
    background-color: var(--surface-panel);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-md);
    padding: var(--space-6);
    width: 400px;
    max-height: 300px;
}

.chat-scroll {
    flex-grow: 1;
    margin-bottom: var(--space-3);
}

.chat-message {
    font-size: var(--size-sm);
    color: var(--text-primary);
    padding: var(--space-1);
    white-space: normal;
}

.chat-input {
    background-color: var(--surface-shelf-solid);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-4);
    color: var(--text-primary);
    font-size: var(--size-sm);
}

/* ─── Глобальный чат (GlobalChatUI) ─── */

.gchat-panel {
    position: absolute;
    /* Широкая полоса лога сразу справа от мини-карты (левая колонка HUD),
       прижата к низу экрана: от 198px (16 отступ + 174 карта + 8 зазор) до
       160px от правого края - чтобы не заходить в правый нижний угол, где
       живёт меню умений. */
    left: 198px;
    right: 160px;
    bottom: var(--space-8);
    height: 180px;
    background-color: var(--surface-slate-dense);
    border-width: var(--space-1);
    border-color: var(--accent-cyan-deep);
    padding: var(--space-4);
    flex-direction: column;
}

.gchat-header {
    font-size: var(--size-base);
    -unity-font-style: bold;
    color: var(--accent-gold);
    margin-bottom: var(--space-2);
}

.gchat-channel-tabs {
    flex-direction: row;
    margin-bottom: var(--space-3);
}

.gchat-channel-button {
    flex-grow: 1;
    height: 26px;
    padding: 0 var(--space-4);
    background-color: var(--surface-shelf-dense);
    border-width: 1px;
    border-color: var(--border-line);
    color: var(--text-secondary);
    -unity-text-align: middle-center;
}

.gchat-channel-button--active {
    background-color: var(--accent-gold-glow);
    border-color: var(--accent-gold);
    color: var(--light-solid);
}

.gchat-mute-status {
    color: var(--accent-gold);
    margin-bottom: var(--space-3);
    white-space: normal;
}

.gchat-scroll {
    flex-grow: 1;
    margin-bottom: var(--space-3);
    background-color: var(--surface-void-haze);
    border-width: 1px;
    border-color: var(--border-line);
}

.gchat-message {
    font-size: var(--size-sm);
    color: var(--light-solid);
    margin-bottom: var(--space-1);
    padding-left: var(--space-1);
    padding-right: var(--space-1);
    white-space: normal;
    -unity-font-style: normal;
}

.gchat-bottom-row {
    flex-direction: row;
    height: var(--space-11);
    flex-shrink: 0;
    flex-grow: 0;
}

.gchat-input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: var(--size-sm);
    color: var(--light-solid);
    background-color: transparent;
    border-width: 1px;
    border-color: var(--border-line);
    padding: var(--space-1) var(--space-2);
}

.gchat-send-button {
    width: var(--space-12);
    flex-shrink: 0;
    padding: 0;
    background-color: var(--surface-shelf-solid);
    color: var(--light-solid);
    font-size: var(--size-base);
    -unity-text-align: middle-center;
    border-width: 1px;
    border-left-width: 0;
    border-color: var(--border-line);
}

.gchat-color-button {
    width: var(--space-11);
    height: var(--space-11);
    flex-shrink: 0;
    padding: 0;
    border-width: 1px;
    border-left-width: 0;
    border-color: var(--border-line);
}

.gchat-color-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 170px;
    flex-shrink: 0;
    justify-content: center;
    background-color: var(--surface-shelf-dense);
    border-width: 1px;
    border-color: var(--border-line);
    padding: var(--space-2);
}

.gchat-swatch {
    width: var(--space-9);
    height: var(--space-9);
    margin: 1px;
    padding: 0;
    border-width: 1px;
    border-color: var(--text-disabled);
}

.gchat-internal-input {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
    font-size: var(--size-base);
    color: var(--light-solid);
}

/* ─── Локальный чат (LocalChatInput) ───
   Одна строка по центру низа: глобальное окно живёт справа по центру
   (.gchat-panel), дно по центру кадра HUD не занимает — джойстик прижат
   влево, корзина с инвентарём вверх. */

.lchat-panel {
    position: absolute;
    left: 50%;
    top: 45%;
    translate: -50% 0;
    width: 420px;
    flex-direction: row;
    align-items: center;
    background-color: var(--surface-slate-dense);
    border-width: 1px;
    border-color: var(--accent-cyan-deep);
    padding: var(--space-1) var(--space-2);
}

.lchat-input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    background-color: transparent;
    border-width: 0;
    padding: var(--space-1) var(--space-2);
    font-size: var(--size-sm);
    color: var(--light-solid);
}

.lchat-internal-input {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
    font-size: var(--size-base);
    color: var(--light-solid);
}
