/* ═══════════════════════════════════════════════════════════
   HUD — стили интерфейса игрока
   ═══════════════════════════════════════════════════════════ */

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.world-map-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: var(--surface-scrim);
}

.world-map-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-top-left {
    position: absolute;
    top: 10px;
    left: 10px;
}

.hud-top-right {
    position: absolute;
    top: 10px;
    right: 10px;
}

.hud-bottom-left {
    position: absolute;
    bottom: 10px;
    left: 10px;
}

.hud-bottom-right {
    position: absolute;
    bottom: 10px;
    right: 10px;
}

.asset-status-root {
    position: absolute;
    right: 10px;
    bottom: 10px;
    align-items: flex-end;
}

.asset-status-button {
    min-width: 38px;
    width: auto;
    height: 28px;
    padding: 0 var(--space-4);
    background-color: var(--surface-slate-dense);
    border-color: var(--text-tertiary);
    border-width: 1px;
    border-radius: var(--radius-md);
    color: var(--light-solid);
    -unity-text-align: middle-center;
}

.asset-status-button:hover,
.asset-status-button.asset-status-loading {
    background-color: var(--surface-shelf-solid);
    border-color: var(--accent-gold);
}

.asset-status-button-label {
    color: var(--light-solid);
    font-size: var(--size-sm);
    -unity-text-align: middle-center;
}

.asset-status-panel {
    width: 300px;
    margin-bottom: var(--space-3);
    padding: var(--space-4);
    background-color: var(--surface-solid);
    border-color: var(--accent-cyan-fill);
    border-width: 1px;
    border-radius: var(--radius-md);
}

.asset-status-summary,
.asset-status-metrics,
.asset-status-details {
    color: var(--light-solid);
    font-size: var(--size-sm);
    white-space: normal;
}

.asset-status-metrics {
    margin-top: 5px;
    color: var(--text-secondary);
}

.asset-status-details {
    margin-top: 5px;
    color: var(--text-secondary);
}

.hud-button {
    background-color: var(--surface-raised);
    border-color: var(--border-subtle);
    border-width: 2px;
    border-radius: var(--radius-sm);
    padding: 0;
    min-width: 100px;
    height: 28px;
    font-size: var(--size-sm);
    color: var(--text-primary);
    -unity-text-align: middle-center;
}

.hud-button:hover {
    background-color: var(--accent-cyan-wash);
}

.hud-button.active {
    background-color: var(--accent-gold);
    color: var(--shadow-solid);
}

.hud-stat {
    color: var(--text-primary);
    font-size: var(--size-md);
    margin: var(--space-1) 0;
}

.hud-stat-label {
    color: var(--text-secondary);
    font-size: var(--size-sm);
}

.hud-bar {
    background-color: var(--surface-shelf-solid);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-sharp);
    height: 12px;
    width: 150px;
}

.hud-bar-fill {
    background-color: var(--accent-gold);
    border-radius: var(--radius-sharp);
}

.hud-panel {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 240px;
    padding: var(--space-6);
    background-color: var(--surface-panel);
    border-color: var(--border-subtle);
    border-width: 2px;
    flex-direction: column;
}

.hud-title-row {
    flex-direction: row;
    margin-bottom: var(--space-5);
    align-items: center;
}

.hud-clan-button {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    padding: 0;
    margin-left: var(--space-2);
    background-color: var(--accent-gold-glow);
    border-width: 1px;
    border-color: var(--text-disabled);
}

.hud-panel .hud-title-row {
    flex-direction: row;
    margin-bottom: var(--space-2);
}

.hud-panel .hud-nickname {
    font-size: var(--size-lg);
    -unity-font-style: bold;
    color: var(--accent-gold);
    flex-grow: 1;
}

.hud-panel .hud-level {
    font-size: var(--size-lg);
    color: var(--text-primary);
    margin-right: var(--space-1);
}

.hud-panel .hud-separator {
    height: 1px;
    background-color: var(--text-secondary);
    margin-bottom: var(--space-2);
}

.hud-panel .hud-stat {
    font-size: var(--size-md);
    color: var(--text-primary);
    margin: 0 0 var(--space-1);
}

.hud-panel .hud-money {
    -unity-font-style: bold;
    font-size: var(--size-md);
    color: var(--text-secondary);
    margin: 0;
}

.hud-panel .hud-creds {
    -unity-font-style: bold;
    font-size: var(--size-md);
    color: var(--accent-gold);
    margin: 0;
}

.hud-panel .hud-basket {
    -unity-font-style: bold;
    font-size: var(--size-md);
    color: var(--accent-gold);
    margin-bottom: var(--space-1);
}

.hud-basket-container {
    flex-direction: column;
}

.hud-stat-wrap {
    white-space: normal;
}

.hud-hp-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.hud-hp-bar {
    height: 14px;
    background-color: var(--surface-shelf-solid);
    border-radius: var(--radius-sm);
    flex-direction: row;
    margin-bottom: var(--space-2);
}

.hud-hp-fill {
    height: 14px;
    border-radius: var(--radius-sm);
}

.hud-button-accent {
    background-color: var(--accent-gold);
    border-color: var(--border-subtle);
    border-width: 2px;
    border-radius: var(--radius-sm);
    color: var(--surface-shelf-solid);
    font-size: var(--size-md);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
}

.hud-button-accent:hover {
    background-color: var(--accent-gold-hover);
}

.hud-button-close {
    width: 24px;
    height: 24px;
    background-color: transparent;
    color: var(--text-secondary);
    font-size: 18px;
    padding: 0;
    border-width: 0;
}

.hud-button-claim {
    align-self: center;
    background-color: var(--accent-cyan-glow);
    color: var(--light-solid);
    border-color: var(--light-edge);
    border-width: 2px;
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-8);
    font-size: var(--size-md);
}

.hud-button-claim:hover {
    background-color: var(--light-edge);
}

.hud-button-label {
    font-size: var(--size-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-grow: 1;
}

.hud-bonus-panel {
    position: absolute;
    top: 10px;
    left: 256px;
    width: 260px;
    padding: var(--space-5);
    background-color: var(--surface-panel);
    border-color: var(--border-subtle);
    border-width: 2px;
    flex-direction: column;
}

.hud-bonus-panel .hud-stat {
    margin: var(--space-1) 0;
}

.hud-bonus-panel .hud-title-row {
    flex-direction: row;
    margin-bottom: var(--space-5);
}

.hud-bonus-panel .hud-title-row .hud-stat {
    color: var(--accent-gold);
    flex-grow: 1;
}

.hud-status-panel {
    position: absolute;
    /* Ниже кнопки бонуса (top:10 + высота 50 + зазор 6) — как было в C#-версии */
    top: 66px;
    left: 256px;
    width: 220px;
    padding: var(--space-6);
    background-color: var(--surface-panel);
    border-color: var(--border-subtle);
    border-width: 2px;
    flex-direction: column;
}

.hud-status-line {
    font-size: var(--size-md);
    margin-bottom: var(--space-1);
    white-space: normal;
}

.hud-skill-container {
    position: absolute;
    bottom: 10px;
    right: 10px;
    padding: var(--space-4);
    flex-direction: column-reverse;
    align-items: flex-end;
}

.hud-skill-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: var(--space-1);
}

.hud-skill-icon {
    flex-direction: row;
    align-items: flex-end;
    margin-right: var(--space-2);
    margin-bottom: var(--space-1);
}

.hud-skill-icon-column {
    position: relative;
    flex-direction: column;
    align-items: center;
    width: 24px;
}

.hud-skill-arrow {
    position: absolute;
    top: -13px;
    left: 0;
    width: 24px;
    font-size: var(--size-xs);
    -unity-font-style: bold;
    color: var(--accent-gold);
    -unity-text-align: middle-center;
}

.hud-skill-bar-bg {
    width: 20px;
    height: 3px;
    background-color: var(--surface-shelf-solid);
    border-radius: var(--radius-sharp);
    margin-top: 1px;
}

.hud-skill-bar-fill {
    height: 3px;
    border-radius: var(--radius-sharp);
    background-color: var(--light-edge);
}

.hud-crystal-row {
    flex-direction: row;
    margin-bottom: 1px;
    align-items: center;
}

.hud-crystal-row .hud-stat {
    margin: 0 var(--space-2);
}

.hud-crystal-dot {
    width: 14px;
    height: 14px;
    margin-right: var(--space-3);
    align-self: center;
}

.hud-crystal-label {
    font-size: var(--size-xs);
    color: var(--text-primary);
}

.hud-skill-icon-image {
    width: 24px;
    height: 24px;
}

.hud-skill-bar-container {
    width: 6px;
    height: 24px;
    margin-left: var(--space-1);
    flex-direction: column;
    justify-content: flex-end;
}

.hud-skill-bar-segment {
    width: 6px;
    height: 2px;
}

.hud-mission-panel {
    position: absolute;
    top: 50px;
    left: 50%;
    translate: -50% 0;
    min-width: 300px;
    padding: var(--space-4);
    background-color: var(--surface-panel);
    border-color: var(--border-subtle);
    border-width: 1px;
    flex-direction: column;
}

.hud-mission-title {
    color: var(--accent-gold);
    margin-bottom: var(--space-2);
}

.hud-mission-desc {
    margin-bottom: var(--space-4);
}

.hud-mission-progress-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-2);
}

.hud-mission-progress-label {
    margin-right: var(--space-4);
    min-width: 50px;
}

.hud-mission-progress-bar {
    flex-grow: 1;
    height: 16px;
    background-color: var(--surface-shelf-solid);
    border-radius: var(--radius-sm);
}

.hud-mission-progress-fill {
    height: 16px;
    border-radius: var(--radius-sm);
    background-color: var(--accent-gold);
}

.hud-btn-action {
    position: absolute;
    background-color: var(--surface-shelf-dense);
    border-color: var(--accent-cyan-deep);
    border-width: 2px;
    border-radius: var(--radius-sm);
    font-size: var(--size-sm);
    -unity-font-style: bold;
    color: var(--text-primary);
    -unity-text-align: middle-center;
    padding: 0;
    height: 28px;
}

.hud-btn-action:hover {
    background-color: var(--light-sheen);
}

.hud-toggle-btn {
    position: absolute;
    left: 10px;
    background-color: var(--surface-crisis-dense);
}

.hud-toggle-btn:hover {
    background-color: var(--light-film);
}

.hud-toggle-btn-label {
    font-size: var(--size-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-grow: 1;
    color: var(--state-danger);
}

.hud-toggle-btn.enabled {
    background-color: var(--surface-slate-dense);
}

.hud-toggle-btn.enabled:hover {
    background-color: var(--light-sheen);
}

.hud-toggle-btn-label.enabled {
    color: var(--state-ok);
}

.hud-toggle-auto-dig { bottom: 281px; }
.hud-toggle-aggression { bottom: 314px; }
.hud-toggle-collision { bottom: 347px; }

.hud-btn-top-row {
    position: absolute;
    top: 10px;
    width: 100px;
    height: 28px;
}

/* Смещения кнопок верхнего ряда (были inline right в C#-версии) */
.hud-btn-top-row--respawn { right: 222px; }
.hud-btn-top-row--buildings { right: 116px; }
.hud-btn-top-row--faq { right: 10px; }

.hud-bonus-button {
    position: absolute;
    left: 256px;
    top: 10px;
    width: 90px;
    height: 50px;
}

.hud-chat-button {
    position: absolute;
    left: 10px;
    bottom: 248px;
    width: 100px;
}

.hud-programmator-button {
    position: absolute;
    left: 10px;
    bottom: 215px;
    width: 100px;
}

/* ═══════════════════════════════════════════════════════════
   Sci-Fi Player HUD Styles
   ═══════════════════════════════════════════════════════════ */

.hud-top-left {
    position: absolute;
    top: 16px;
    left: 16px;
    width: 280px;
}

.hud-title-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
}

.hud-nickname {
    -unity-font-definition: var(--face-display);
    color: var(--text-primary);
    font-size: var(--size-base);
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.hud-clan-btn {
    height: 24px;
    padding: 0 var(--space-4);
    font-size: var(--size-2xs);
}

.hud-separator {
    height: 1px;
    background-color: var(--border-subtle);
    margin-bottom: var(--space-4);
}

.hud-stat-group {
    margin-bottom: var(--space-4);
}

.hud-stat-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: var(--space-2);
}

.hud-stat-title {
    -unity-font-definition: var(--face-body);
    color: var(--text-secondary);
    font-size: var(--size-xs);
}

.hud-stat-percent {
    -unity-font-definition: var(--face-data);
    color: var(--state-ok);
    font-size: var(--size-xs);
    -unity-font-style: bold;
}

.hud-bar-track {
    height: 6px;
    margin-bottom: var(--space-3);
}

.hud-currency-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: var(--space-2);
}

.hud-currency-item {
    flex-direction: row;
    align-items: center;
}

.hud-currency-icon {
    font-size: var(--size-base);
    color: var(--accent-cyan);
    margin-right: var(--space-2);
}

.hud-currency-icon--gold {
    color: var(--accent-gold);
}

.hud-currency-value {
    -unity-font-definition: var(--face-data);
    color: var(--text-primary);
    font-size: var(--size-sm);
    -unity-font-style: bold;
}

.hud-currency-value--gold {
    color: var(--accent-gold-hover);
}

/* Корзина */
.hud-basket-panel {
    position: absolute;
    top: 170px;
    left: 16px;
    width: 140px;
    padding: var(--space-4);
}

.hud-basket-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
}

.hud-geology-text {
    -unity-font-definition: var(--face-body);
    color: var(--text-secondary);
    font-size: var(--size-2xs);
}

/* Миссия */
.hud-mission-panel {
    position: absolute;
    top: 16px;
    left: 50%;
    translate: -50% 0;
    width: 380px;
    padding: var(--space-5) var(--space-7);
}

.hud-mission-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-2);
}

.hud-mission-title {
    -unity-font-definition: var(--face-display);
    color: var(--text-primary);
    font-size: var(--size-sm);
    -unity-font-style: bold;
    margin-left: var(--space-4);
}

.hud-mission-desc {
    -unity-font-definition: var(--face-body);
    color: var(--text-secondary);
    font-size: var(--size-xs);
    white-space: normal;
    margin-bottom: var(--space-3);
}

.hud-mission-track {
    height: 4px;
    margin-bottom: var(--space-2);
}

#MissionProgressFill {
    width: 0%;
}

.hud-mission-progress-text {
    -unity-font-definition: var(--face-data);
    color: var(--accent-cyan);
    font-size: var(--size-2xs);
    align-self: flex-end;
}

/* Правая колонка действий */
.hud-actions-column {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 160px;
}

.hud-action-btn {
    margin-bottom: var(--space-4);
    width: 100%;
}

.hud-mode-led {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-sm);
    background-color: var(--text-disabled);
    margin-right: var(--space-4);
}

.hud-mode-led--active {
    background-color: var(--accent-cyan-hover);
}


/* ─── Системная миникарта (UI Toolkit) ─── */

.hud-minimap-panel {
    position: absolute;
    bottom: 16px;
    left: 16px;
    padding: var(--space-3);
    background-color: var(--surface-slate-dense);
    border-width: 1px;
    border-color: var(--accent-cyan-fill);
    border-radius: var(--radius-md);
    flex-direction: column;
    align-items: center;
}

.hud-minimap-container {
    width: 160px;
    height: 160px;
    border-width: 1px;
    border-color: var(--light-sheen);
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--shadow-solid);
}

.hud-minimap-image {
    width: 100%;
    height: 100%;
}

.hud-minimap-coords {
    font-size: var(--size-xs);
    color: var(--accent-cyan-hover);
    -unity-font-style: bold;
    margin-bottom: var(--space-2);
    -unity-text-align: middle-center;
}
