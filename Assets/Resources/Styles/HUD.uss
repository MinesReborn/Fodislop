/* ═══════════════════════════════════════════════════════════
   HUD — стили интерфейса игрока
   ═══════════════════════════════════════════════════════════ */

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-top-pill-container {
    position: absolute;
    top: var(--space-4);
    left: 0;
    right: 0;
    align-items: center;
}

.hud-top-pill {
    flex-direction: row;
    align-items: center;
    padding: var(--space-1) var(--space-4);
    background-color: var(--surface-void-shade);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-md);
}

.hud-top-pill-version {
    -unity-font-definition: var(--face-data);
    font-size: var(--size-xs);
    color: var(--text-tertiary);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.hud-top-pill-divider {
    width: 1px;
    height: var(--space-6);
    background-color: var(--border-line);
    margin-left: var(--space-3);
    margin-right: var(--space-3);
}

.hud-top-pill-fps {
    -unity-font-definition: var(--face-data);
    font-size: var(--size-xs);
    color: var(--light-solid);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.hud-top-pill-asset {
    flex-direction: row;
    align-items: center;
}

.hud-top-pill-dot {
    width: var(--space-3);
    height: var(--space-3);
    border-radius: var(--radius-pill);
    background-color: var(--state-ok);
    margin-right: var(--space-2);
}

.hud-top-pill-dot.is-loading {
    background-color: var(--accent-gold);
}

.hud-top-pill-asset-text {
    -unity-font-definition: var(--face-data);
    font-size: var(--size-xs);
    color: var(--text-secondary);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.hud-fps-counter {
    padding: var(--space-1) var(--space-4);
    background-color: var(--surface-void-shade);
    border-radius: var(--radius-md);
    color: var(--light-solid);
    font-size: var(--size-base);
    -unity-text-align: upper-center;
}

.world-map-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: var(--surface-scrim);
}

.world-map-window {
    width: 72%;
    height: 72%;
    max-width: 1100px;
    max-height: 760px;
    min-width: 560px;
    min-height: 360px;
    flex-direction: column;
    background-color: var(--surface-panel);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-md);
    overflow: hidden;
}

.world-map-header {
    height: 44px;
    min-height: 44px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: var(--space-5);
    padding-right: var(--space-3);
    background-color: var(--surface-raised);
    border-bottom-color: var(--border-subtle);
    border-bottom-width: 1px;
}

.world-map-title {
    color: var(--text-primary);
    font-size: var(--size-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.world-map-close {
    width: 32px;
    height: 32px;
    padding: 0;
    color: var(--text-secondary);
    background-color: transparent;
    border-width: 0;
    font-size: var(--size-lg);
}

.world-map-follow {
    min-width: 120px;
    height: 32px;
    margin-left: auto;
    margin-right: var(--space-3);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    color: var(--accent-cyan-hover);
    background-color: var(--surface-slate-dense);
    border-color: var(--border-subtle);
    border-width: 1px;
}

.world-map-status {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    padding: var(--space-3) var(--space-5);
    color: var(--text-primary);
    background-color: var(--surface-raised);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-sm);
    font-size: var(--size-sm);
}

.world-map-viewport {
    flex-grow: 1;
    position: relative;
    width: 100%;
    min-height: 0;
    overflow: hidden;
}

.world-map-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.world-map-player-marker {
    position: absolute;
    left: 0;
    top: 0;
    width: 10px;
    height: 10px;
    background-color: var(--state-danger);
    border-color: #ffffff;
    border-width: 1.5px;
    border-radius: 5px;
    translate: -50% -50%;
}

.hud-top-left {
    position: absolute;
    top: var(--space-5);
    left: var(--space-5);
}

.hud-top-right {
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
}

.hud-bottom-left {
    position: absolute;
    bottom: var(--space-5);
    left: var(--space-5);
}

.hud-bottom-right {
    position: absolute;
    bottom: var(--space-5);
    right: var(--space-5);
}

.asset-status-root {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    align-items: flex-end;
}

.asset-status-button {
    min-width: 38px;
    width: auto;
    height: var(--space-11);
    padding: 0 var(--space-4);
    background-color: var(--surface-slate-dense);
    border-color: var(--text-tertiary);
    border-width: 1px;
    border-radius: var(--radius-md);
    color: var(--light-solid);
    -unity-text-align: middle-center;
}

.asset-status-button:hover,
.asset-status-button.asset-status-loading {
    background-color: var(--surface-shelf-solid);
    border-color: var(--accent-gold);
}

.asset-status-button-label {
    color: var(--light-solid);
    font-size: var(--size-sm);
    -unity-text-align: middle-center;
}

.asset-status-panel {
    width: 300px;
    margin-bottom: var(--space-3);
    padding: var(--space-4);
    background-color: var(--surface-solid);
    border-color: var(--accent-cyan-fill);
    border-width: 1px;
    border-radius: var(--radius-md);
}

.asset-status-summary,
.asset-status-metrics,
.asset-status-details {
    color: var(--light-solid);
    font-size: var(--size-sm);
    white-space: normal;
}

.asset-status-metrics {
    margin-top: 5px;
    color: var(--text-secondary);
}

.asset-status-details {
    margin-top: 5px;
    color: var(--text-secondary);
}

.hud-button {
    background-color: var(--surface-raised);
    border-color: var(--border-subtle);
    border-width: var(--space-1);
    border-radius: var(--radius-sm);
    padding: 0;
    min-width: 100px;
    height: var(--space-11);
    font-size: var(--size-sm);
    color: var(--text-primary);
    -unity-text-align: middle-center;
}

.hud-button:hover {
    background-color: var(--accent-cyan-wash);
}

.hud-button.active {
    background-color: var(--accent-gold);
    color: var(--shadow-solid);
}

.hud-stat {
    color: var(--text-primary);
    font-size: var(--size-md);
    margin: var(--space-1) 0;
}

.hud-stat-label {
    color: var(--text-secondary);
    font-size: var(--size-sm);
}

.hud-bar {
    background-color: var(--surface-shelf-solid);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-sharp);
    height: var(--space-6);
    width: 150px;
}

.hud-bar-fill {
    background-color: var(--accent-gold);
    border-radius: var(--radius-sharp);
}

.hud-panel {
    position: absolute;
    top: var(--space-5);
    left: var(--space-5);
    width: 240px;
    padding: var(--space-6);
    background-color: var(--surface-panel);
    border-color: var(--border-subtle);
    border-width: var(--space-1);
    flex-direction: column;
}

.hud-title-row {
    flex-direction: row;
    margin-bottom: var(--space-5);
    align-items: center;
}

.hud-clan-button {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    padding: 0;
    margin-left: var(--space-2);
    background-color: var(--accent-gold-glow);
    border-width: 1px;
    border-color: var(--text-disabled);
}

.hud-panel .hud-title-row {
    flex-direction: row;
    margin-bottom: var(--space-2);
}

.hud-panel .hud-nickname {
    font-size: var(--size-lg);
    -unity-font-style: bold;
    color: var(--accent-gold);
    flex-grow: 1;
}

/* Уровень под никнеймом: "Уровень: X" — компактная строка */
.hud-panel .hud-level {
    font-size: var(--size-sm);
    color: var(--text-secondary);
    margin: 0 0 var(--space-1);
    -unity-font-style: bold;
}

.hud-panel .hud-separator {
    height: 1px;
    background-color: var(--text-secondary);
    margin-bottom: var(--space-2);
}

.hud-panel .hud-stat {
    font-size: var(--size-md);
    color: var(--text-primary);
    margin: 0 0 var(--space-1);
}

.hud-panel .hud-money {
    -unity-font-style: bold;
    font-size: var(--size-md);
    color: var(--text-secondary);
    margin: 0;
}

.hud-panel .hud-credits {
    -unity-font-style: bold;
    font-size: var(--size-md);
    color: var(--accent-gold);
    margin: 0;
}

.hud-panel .hud-basket {
    -unity-font-style: bold;
    font-size: var(--size-md);
    color: var(--accent-gold);
    margin-bottom: var(--space-1);
}

.hud-basket-container {
    flex-direction: column;
}

.hud-stat-wrap {
    white-space: normal;
}

.hud-hp-bar {
    height: var(--space-7);
    background-color: var(--surface-shelf-solid);
    border-radius: var(--radius-sm);
    flex-direction: row;
    margin-bottom: var(--space-2);
}

.hud-hp-fill {
    height: var(--space-7);
    border-radius: var(--radius-sm);
}

/* Счётчик прочности внутри полосы: белый текст, обводка ТОГО ЖЕ цвета —
 * утолщает буквы (эффект жирного), на заливке не даёт тёмной каши. */
.hud-hp-count {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 14px;
    color: rgb(255, 255, 255);
    letter-spacing: 1px;

    /* Мягкое тёмное хало вокруг цифр на светлой заливке и тёмном треке. */
    text-shadow: 0 0 6px rgba(0, 0, 0, 0.9);
    translate: 0 -2px;
    padding: 0;
}

/* Перетаскиваемая ручка панели HUD: висит ПОД нижним краем панели, чтобы
 * не налезать на полосы кристаллов корзины в правом нижнем углу. */
.hud-drag-handle {
    position: absolute;
    right: 4px;
    bottom: -26px;
    width: 28px;
    height: 20px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    background-color: var(--surface-shelf-solid);
    border-width: 1px;
    border-color: var(--border-subtle);
}

.hud-drag-handle > .unity-label {
    font-size: 14px;
    color: var(--text-secondary);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.hud-drag-handle:hover {
    background-color: var(--accent-gold-tint);
}

.hud-drag-handle:hover > .unity-label {
    color: var(--accent-gold);
}

.hud-button-accent {
    background-color: var(--accent-gold);
    border-color: var(--border-subtle);
    border-width: var(--space-1);
    border-radius: var(--radius-sm);
    color: var(--surface-shelf-solid);
    font-size: var(--size-md);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
}

.hud-button-accent:hover {
    background-color: var(--accent-gold-hover);
}

.hud-button-close {
    width: var(--space-10);
    height: var(--space-10);
    background-color: transparent;
    color: var(--text-secondary);
    font-size: var(--size-lg);
    padding: 0;
    border-width: 0;
}

.hud-button-claim {
    align-self: center;
    background-color: var(--accent-cyan-glow);
    color: var(--light-solid);
    border-color: var(--light-edge);
    border-width: var(--space-1);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-8);
    font-size: var(--size-md);
}

.hud-button-claim:hover {
    background-color: var(--light-edge);
}

.hud-button-label {
    font-size: var(--size-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-grow: 1;
}

.hud-bonus-panel {
    position: absolute;
    top: var(--space-5);
    left: 256px;
    width: 260px;
    padding: var(--space-5);
    background-color: var(--surface-panel);
    border-color: var(--border-subtle);
    border-width: var(--space-1);
    flex-direction: column;
}

.hud-bonus-panel .hud-stat {
    margin: var(--space-1) 0;
}

.hud-bonus-panel .hud-title-row {
    flex-direction: row;
    margin-bottom: var(--space-5);
}

.hud-bonus-panel .hud-title-row .hud-stat {
    color: var(--accent-gold);
    flex-grow: 1;
}

.hud-status-panel {
    position: absolute;
    /* Ниже кнопки бонуса (top:10 + высота 50 + зазор 6) — как было в C#-версии */
    top: 66px;
    left: 256px;
    width: 220px;
    padding: var(--space-6);
    background-color: var(--surface-panel);
    border-color: var(--border-subtle);
    border-width: var(--space-1);
    flex-direction: column;
}

.hud-status-line {
    font-size: var(--size-md);
    margin-bottom: var(--space-1);
    white-space: normal;
}

.hud-skill-container {
    position: absolute;
    bottom: var(--space-5);
    right: var(--space-5);
    padding: var(--space-4);
    flex-direction: column-reverse;
    align-items: flex-end;
}

.hud-skill-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: var(--space-1);
}

.hud-skill-icon {
    position: relative;
    flex-direction: row;
    align-items: flex-end;
    margin-right: var(--space-2);
    margin-bottom: var(--space-1);
}

.hud-skill-arrow {
    position: absolute;
    top: -13px;
    left: 0;
    width: var(--space-10);
    font-size: var(--size-xs);
    -unity-font-style: bold;
    color: var(--accent-gold);
    -unity-text-align: middle-center;
}

/* Круговой прогресс-бар умения: лаймовое кольцо вокруг иконки
 * (рисуется кодом в SkillProgressRing, слоем поверх иконки). */
.hud-skill-ring {
    position: absolute;
    left: -7px;
    top: -7px;
    right: -7px;
    bottom: -7px;
}

.hud-crystal-row {
    flex-direction: row;
    margin-bottom: 2px;
    align-items: center;
}

.hud-crystal-row .hud-stat {
    margin: 0 var(--space-2);
}

.hud-crystal-dot {
    width: var(--space-8);
    height: var(--space-8);
    margin-right: var(--space-3);
    align-self: center;
}

/* Кристаллы корзины: полоса с тонированным зоной треком и числом внутри.
 * Зона: <100% лайм, 100-114% жёлтый, 114%+ коралл (перегруз). */
.hud-crystal-bar {
    flex-grow: 1;
    height: 18px;
    border-radius: var(--radius-sm);
    overflow: hidden;
}

.hud-crystal-fill {
    height: 100%;
    border-radius: var(--radius-sm);
}

/* Число внутри полосы: белый жирный текст с плотной чёрной обводкой по всем
 * направлениям + мягкое хало - читается одинаково и на светлой лаймовой
 * заливке, и на тёмной части трека. */
.hud-crystal-count {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 15px;
    color: rgb(255, 255, 255);
    letter-spacing: 0.5px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.95);
    text-shadow: 0 0 6px rgba(0, 0, 0, 0.85);
    translate: 0 -1px;
    padding: 0;
}

.hud-crystal-row--ok .hud-crystal-bar {
    background-color: rgba(163, 230, 53, 0.22);
    border-width: 1px;
    border-color: rgba(163, 230, 53, 0.45);
}

.hud-crystal-row--ok .hud-crystal-fill {
    background-color: rgba(163, 230, 53, 0.62); /* лайм, полупрозрачный */
}

.hud-crystal-row--warn .hud-crystal-bar {
    background-color: rgba(246, 217, 68, 0.24);
    border-width: 1px;
    border-color: rgba(246, 217, 68, 0.5);
}

.hud-crystal-row--warn .hud-crystal-fill {
    background-color: rgba(246, 217, 68, 0.62); /* жёлтый, полупрозрачный */
}

.hud-crystal-row--over .hud-crystal-bar {
    background-color: rgba(229, 115, 115, 0.26);
    border-width: 1px;
    border-color: rgba(229, 115, 115, 0.55);
}

.hud-crystal-row--over .hud-crystal-fill {
    background-color: rgba(229, 115, 115, 0.62); /* коралл, полупрозрачный */
}

.hud-skill-icon-image {
    width: var(--space-10);
    height: var(--space-10);
}

.hud-mission-panel {
    position: absolute;
    top: 50px;
    left: 50%;
    translate: -50% 0;
    min-width: 300px;
    padding: var(--space-4);
    background-color: var(--surface-panel);
    border-color: var(--border-subtle);
    border-width: 1px;
    flex-direction: column;
}

.hud-mission-title {
    color: var(--accent-gold);
    margin-bottom: var(--space-2);
}

.hud-mission-desc {
    margin-bottom: var(--space-4);
}

.hud-mission-progress-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-2);
}

.hud-mission-progress-label {
    margin-right: var(--space-4);
    min-width: 50px;
}

.hud-mission-progress-bar {
    flex-grow: 1;
    height: var(--space-8);
    background-color: var(--surface-shelf-solid);
    border-radius: var(--radius-sm);
}

.hud-mission-progress-fill {
    height: var(--space-8);
    border-radius: var(--radius-sm);
    background-color: var(--accent-gold);
}

.hud-btn-action {
    position: absolute;
    background-color: var(--surface-shelf-dense);
    border-color: var(--accent-cyan-deep);
    border-width: var(--space-1);
    border-radius: var(--radius-sm);
    font-size: var(--size-sm);
    -unity-font-style: bold;
    color: var(--text-primary);
    -unity-text-align: middle-center;
    padding: 0;
    /* Дефолтная тема Unity добавляет кнопкам margin - из-за него кнопки
       съезжают относительно панели миникарты (обычного VisualElement). */
    margin: 0;
    height: var(--space-11);
}

.hud-btn-action:hover {
    background-color: var(--light-sheen);
}

.hud-toggle-btn {
    position: absolute;
    left: var(--space-5);
    background-color: var(--surface-crisis-dense);
}

.hud-toggle-btn:hover {
    background-color: var(--light-film);
}

.hud-toggle-btn-label {
    font-size: var(--size-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-grow: 1;
    color: var(--state-danger);
}

.hud-toggle-btn.enabled {
    background-color: var(--surface-slate-dense);
}

.hud-toggle-btn.enabled:hover {
    background-color: var(--light-sheen);
}

.hud-toggle-btn-label.enabled {
    color: var(--state-ok);
}

/* Включённая автокопка - лаймовый текст (выключенная остаётся красной).
   Класс enabled вешается на саму кнопку, поэтому селектор потомственный. */
.hud-toggle-btn.enabled .hud-toggle-btn-label {
    color: rgb(0, 255, 0);
}

/* Колонка управления СТРОГО над мини-картой (как в старом клиенте): автокопа ->
   программатор (имя активной программы) со встроенной кнопкой запуска/остановки.
   left берётся из той же переменной --space-8, что и у панели миникарты.
   Анимированный индикатор выполнения (running) намеренно не переносился. */
.hud-toggle-auto-dig {
    left: var(--space-8);
    bottom: 262px;
    width: 174px;
    height: 36px;
    margin: 0;
}
/* Агрессия - над автокопанием, зазор как между программатором и автокопой (8px). */
.hud-toggle-aggression {
    left: var(--space-8);
    bottom: 306px;
    width: 174px;
    height: 36px;
    margin: 0;
}
.hud-toggle-collision { bottom: 347px; }

.hud-btn-top-row {
    position: absolute;
    top: var(--space-5);
    width: 100px;
    height: var(--space-11);
}

/* Смещения кнопок верхнего ряда (были inline right в C#-версии) */
.hud-btn-top-row--respawn { right: 222px; }
.hud-btn-top-row--buildings { right: 116px; }
.hud-btn-top-row--faq { right: 10px; }

.hud-bonus-button {
    position: absolute;
    left: 256px;
    top: var(--space-5);
    width: 90px;
    height: 50px;
}

/* Кнопки чата в HUD больше нет: чат открывается по TAB (GlobalChatUI.Update),
   панель - .gchat-panel в Chat.uss. */

/* Колонка управления над мини-картой (как в старом клиенте): автокопа ->
   программатор (имя активной программы) + кнопка запуска/остановки -> мини-карта.
   Анимированный индикатор выполнения (running) слева от программатора
   намеренно не переносился. */
.hud-programmator-button {
    position: absolute;
    left: var(--space-8);
    bottom: 218px;
    width: 174px;
    height: 36px;
    /* Текст (имя программы) центрируется правее встройки ▶/■. */
    padding-left: 44px;
}

/* Старт/стоп - плоская кликабельная зона в левой части кнопки программатора:
   без фона и рамки (чтобы не выглядела кнопкой в кнопке), только цветной
   символ - лаймовый ▶ когда программа стоит, тёмно-красный ■ когда выполняется. */
.hud-program-run-btn {
    position: absolute;
    left: var(--space-8);
    bottom: 218px;
    width: 44px;
    height: 36px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: rgb(0, 255, 0);
    font-size: 20px;
    padding: 0;
}
.hud-program-run-btn:hover,
.hud-program-run-btn--running:hover {
    background-color: rgba(0, 0, 0, 0);
}
.hud-program-run-btn--running {
    color: rgb(139, 0, 0);
    font-size: 16px;
}

/* ═══════════════════════════════════════════════════════════
   Sci-Fi Player HUD Styles
   ═══════════════════════════════════════════════════════════ */

.hud-top-left {
    position: absolute;
    top: var(--space-8);
    left: var(--space-8);
    width: 280px;
}

.hud-title-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
}

.hud-nickname {
    -unity-font-definition: var(--face-display);
    color: var(--text-primary);
    font-size: var(--size-base);
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.hud-clan-btn {
    height: var(--space-10);
    padding: 0 var(--space-4);
    font-size: var(--size-2xs);
}

.hud-separator {
    height: 1px;
    background-color: var(--border-subtle);
    margin-bottom: var(--space-4);
}

.hud-stat-group {
    margin-bottom: var(--space-4);
}

.hud-stat-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: var(--space-2);
}

.hud-stat-title {
    -unity-font-definition: var(--face-body);
    color: var(--text-secondary);
    font-size: var(--size-xs);
}

.hud-stat-percent {
    -unity-font-definition: var(--face-data);
    color: var(--state-ok);
    font-size: var(--size-xs);
    -unity-font-style: bold;
}

.hud-bar-track {
    height: var(--space-3);
    margin-bottom: var(--space-3);
}

.hud-currency-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: var(--space-2);
}

.hud-currency-item {
    flex-direction: row;
    align-items: center;
}

.hud-currency-icon {
    font-size: var(--size-base);
    color: var(--accent-cyan);
    margin-right: var(--space-2);
}

.hud-currency-icon--gold {
    color: var(--accent-gold);
}

.hud-currency-value {
    -unity-font-definition: var(--face-data);
    color: var(--text-primary);
    font-size: var(--size-sm);
    -unity-font-style: bold;
}

.hud-currency-value--gold {
    color: var(--accent-gold-hover);
}

/* Корзина */
.hud-basket-panel {
    position: absolute;
    top: 170px;
    left: var(--space-8);
    width: 140px;
    padding: var(--space-4);
}

.hud-basket-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
}

.hud-geology-text {
    -unity-font-definition: var(--face-body);
    color: var(--text-secondary);
    font-size: var(--size-2xs);
}

/* Миссия */
.hud-mission-panel {
    position: absolute;
    top: 50px;
    left: 50%;
    translate: -50% 0;
    width: 380px;
    padding: var(--space-5) var(--space-7);
}

.hud-mission-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-2);
}

.hud-mission-title {
    -unity-font-definition: var(--face-display);
    color: var(--text-primary);
    font-size: var(--size-sm);
    -unity-font-style: bold;
    margin-left: var(--space-4);
}

.hud-mission-desc {
    -unity-font-definition: var(--face-body);
    color: var(--text-secondary);
    font-size: var(--size-xs);
    white-space: normal;
    margin-bottom: var(--space-3);
}

.hud-mission-track {
    height: var(--space-2);
    margin-bottom: var(--space-2);
}

#MissionProgressFill {
    width: 0%;
}

.hud-mission-progress-text {
    -unity-font-definition: var(--face-data);
    color: var(--accent-cyan);
    font-size: var(--size-2xs);
    align-self: flex-end;
}

/* Правая колонка действий */
.hud-actions-column {
    position: absolute;
    top: var(--space-8);
    right: var(--space-8);
    width: 160px;
}

.hud-action-btn {
    margin-bottom: var(--space-4);
    width: 100%;
}

.hud-mode-led {
    width: var(--space-3);
    height: var(--space-3);
    border-radius: var(--radius-sm);
    background-color: var(--text-disabled);
    margin-right: var(--space-4);
}

.hud-mode-led--active {
    background-color: var(--accent-cyan-hover);
}


/* ─── Системная миникарта (UI Toolkit) ─── */

.hud-minimap-panel {
    position: absolute;
    bottom: var(--space-8);
    left: var(--space-8);
    padding: var(--space-3);
    background-color: var(--surface-slate-dense);
    border-width: 1px;
    border-color: var(--accent-cyan-fill);
    border-radius: var(--radius-md);
    flex-direction: column;
    align-items: center;
}

.hud-minimap-container {
    width: 160px;
    height: 160px;
    border-width: 1px;
    border-color: var(--light-sheen);
    border-radius: var(--radius-sharp);
    background-color: var(--shadow-solid);
}

.hud-minimap-image {
    width: 100%;
    height: 100%;
}

.hud-minimap-player-marker {
    position: absolute;
    left: 80px;
    top: 80px;
    width: 6px;
    height: 6px;
    background-color: var(--state-danger);
    border-color: #ffffff;
    border-width: 1px;
    border-radius: 3px;
    translate: -50% -50%;
}

.hud-minimap-coords {
    font-size: var(--size-xs);
    color: var(--accent-cyan-hover);
    -unity-font-style: bold;
    /* Фиксированная высота: панель миникарты получает детерминированную
       высоту (194px), кнопка программатора стыкуется с ней без нахлёста. */
    height: 16px;
    margin-bottom: var(--space-2);
    -unity-text-align: middle-center;
}

/* ─── Кольцо навигации миссии ─── */

.mission-ring-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Размер и положение задаются кодом: кольцо стоит в центре вьюпорта, а его
   радиус — доля меньшей стороны экрана.

   Фон непрозрачный не ради цвета: элемент без фона не даёт UI Toolkit ни
   одного треугольника, и собственному материалу нечего было бы закрашивать.
   Шейдер кольца перекрывает RGB целиком и берёт отсюда только альфу — она
   служит ему прозрачностью элемента. */
.mission-ring {
    position: absolute;
    background-color: rgba(255, 255, 255, 1);
}
