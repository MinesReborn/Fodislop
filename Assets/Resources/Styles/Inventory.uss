/* ═══════════════════════════════════════════════════════════
   Inventory & Hotbar — системные стили инвентаря Fodinae
   ═══════════════════════════════════════════════════════════ */

/* ─── Полный инвентарь (Overlay & Центрирование) ─── */

.inv-full-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: var(--surface-sunken);
}

.inv-full-bg {
    background-color: var(--surface-slate-dense);
    border-width: 1px;
    border-color: var(--accent-cyan-fill);
    border-radius: var(--radius-md);
    padding: var(--space-9);
    flex-direction: column;
    align-items: center;
    min-width: 560px;
}

.inv-close-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 28px;
    height: 28px;
    background-color: var(--surface-void-haze);
    border-width: 1px;
    border-color: var(--accent-cyan-glow);
    border-radius: var(--radius-md);
    padding: 0;
    justify-content: center;
    align-items: center;
}

.inv-close-btn:hover {
    background-color: var(--state-danger-glow);
    border-color: var(--state-danger);
}

.inv-close-label {
    font-size: var(--size-md);
    color: var(--accent-gold);
    -unity-text-align: middle-center;
    align-self: center;
    justify-content: center;
}

.inv-title {
    font-size: var(--size-md);
    -unity-font-style: bold;
    color: var(--text-primary);
    margin-bottom: var(--space-6);
    align-self: flex-start;
}

.inv-separator {
    height: 1px;
    background-color: var(--accent-cyan-glow);
    margin-top: var(--space-6);
    margin-bottom: var(--space-6);
    align-self: center;
}

/* ─── Сетка и ячейки ─── */

.inv-grid {
    flex-direction: column;
    align-items: center;
}

.inv-grid-row {
    flex-direction: row;
    flex-shrink: 0;
}

.inv-cell {
    width: 50px;
    height: 50px;
    min-width: 50px;
    min-height: 50px;
    flex-shrink: 0;
    flex-grow: 0;
    justify-content: center;
    align-items: center;
    margin: 3px;
    background-color: var(--surface-shelf-dense);
    border-width: 1px;
    border-color: var(--accent-cyan-glow);
    border-radius: var(--radius-md);
}

.inv-cell:hover {
    border-color: var(--accent-cyan-dense);
    background-color: var(--surface-shelf-dense);
}

.inv-cell--selected {
    border-width: 2px;
    border-color: var(--accent-gold);
    background-color: var(--light-film);
}

.inv-cell--highlight {
    background-color: var(--light-sheen);
}

.inv-icon {
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    align-self: center;
    justify-content: center;
}

.inv-qty {
    position: absolute;
    right: 3px;
    bottom: 2px;
    font-size: var(--size-xs);
    color: var(--light-solid);
    -unity-font-style: bold;
}

.inv-floating {
    position: absolute;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    opacity: 0.8;
}

/* ─── Хотбар ─── */

.inv-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    /* Прозрачность для кликов: picking-mode="Ignore" на InventoryRoot в
       Inventory.uxml. ВАЖНО: Ignore наследуется на всё поддерево, поэтому
       интерактивные элементы (хотбар, кнопки, слоты) явно возвращают
       picking-mode="Position" — паттерн как в ObserverJoystick.uxml. */
}

.inv-hotbar {
    position: absolute;
    bottom: 16px;
    align-self: center;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
}

.inv-hotbar-slots {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.inv-grid-container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top: var(--space-5);
}

.inv-toggle-btn {
    margin-left: var(--space-5);
    height: 48px;
    padding-left: var(--space-7);
    padding-right: var(--space-7);
    justify-content: center;
    align-items: center;
}

.inv-header-left {
    flex-direction: row;
    align-items: center;
}

.inv-button {
    width: 50px;
    height: 50px;
    min-width: 50px;
    min-height: 50px;
    flex-shrink: 0;
    flex-grow: 0;
    margin: 3px;
    background-color: var(--light-sheen);
    border-width: 1px;
    border-color: var(--accent-cyan-fill);
    border-radius: var(--radius-md);
    padding: 0;
    justify-content: center;
    align-items: center;
}

.inv-button:hover {
    background-color: var(--accent-cyan-glow);
    border-color: var(--accent-cyan-dense);
}

/* ─── Тултип выбранного предмета ─── */

.inv-tooltip-wrapper {
    position: absolute;
    left: 0;
    right: 0;
    top: 48px;
    height: 36px;
    flex-direction: row;
    justify-content: center;
}

.inv-tooltip-bg {
    flex-direction: row;
    align-items: center;
    background-color: var(--surface-slate-dense);
    border-width: 1px;
    border-color: var(--accent-cyan-fill);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-6);
}

.inv-tooltip-name {
    font-size: var(--size-base);
    -unity-font-style: bold;
    color: var(--accent-gold);
    margin-right: var(--space-5);
}

.inv-tooltip-desc {
    font-size: var(--size-sm);
    color: var(--accent-cyan-solid);
}

/* ─── Контекстное меню ─── */

.inv-context-menu {
    position: absolute;
    background-color: var(--surface-slate-dense);
    border-width: 1px;
    border-color: var(--accent-cyan-fill);
    border-radius: var(--radius-md);
    padding: var(--space-2) 0;
    flex-direction: column;
    min-width: 150px;
}

.inv-context-btn {
    background-color: transparent;
    border-width: 0;
    padding: var(--space-3) var(--space-6);
    color: var(--text-primary);
    font-size: var(--size-base);
    -unity-text-align: middle-left;
    min-height: 28px;
}

.inv-context-btn:hover {
    background-color: var(--accent-cyan-glow);
}
