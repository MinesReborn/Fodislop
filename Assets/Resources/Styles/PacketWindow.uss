.packet-window-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--surface-scrim);
}

.packet-window-frame {
    max-width: 96%;
    max-height: 96%;
    min-width: 0;
    min-height: 0;
    padding: var(--space-6);
    background-color: var(--surface-panel);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    overflow: hidden;
}

.packet-window-content {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
}

.packet-window-body-layout {
    width: 100%;
    height: 100%;
    min-height: 0;
}

.packet-window-body-scroll {
    flex-grow: 1;
    min-height: 0;
}

.packet-window-footer {
    flex-direction: row;
    flex-shrink: 0;
    margin-top: var(--space-3);
}

.packet-window-footer-action {
    flex-grow: 1;
    flex-basis: 0;
}

.packet-window-footer-action--spaced {
    margin-left: var(--space-2);
}

.packet-window-exit {
    background-color: var(--state-danger-wash);
    border-color: var(--border-danger);
    color: var(--state-danger);
}

.packet-window-exit:hover {
    background-color: var(--state-danger-glow);
    border-color: var(--state-danger);
    color: var(--text-primary);
}

/* Белый крестик закрытия в правом верхнем углу окна. Заменяет футерную
   кнопку «ВЫЙТИ»: клик уходит на сервер как обычный ElementClickPacket.
   Крестик собран из двух повёрнутых полосок — вид не зависит от глифов
   шрифта. */
.packet-window-close {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 22px;
    height: 22px;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: var(--radius-sm);
    background-color: transparent;
}

.packet-window-close:hover {
    background-color: var(--state-danger-wash);
}

.packet-window-close:active {
    background-color: var(--state-danger-glow);
}

.packet-window-close-bar {
    position: absolute;
    left: 5px;
    top: 10px;
    width: 12px;
    height: 2px;
    border-radius: 1px;
    background-color: #ffffff;
}

.packet-window-close-bar--a {
    rotate: 45deg;
}

.packet-window-close-bar--b {
    rotate: -45deg;
}

.packet-window-action {
    min-height: 30px;
    padding: 4px 8px;
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    -unity-text-align: middle-center;
}

.packet-window-action:hover {
    background-color: var(--accent-cyan-wash);
    border-color: var(--border-cyan);
}

/* Полоса вкладок легаси-окна: кнопки-вкладки идут в строку под заголовком,
   ширина — по тексту (в отличие от футерных, которые растягиваются). */
.packet-window-tab {
    margin-right: var(--space-2);
}

/* Активная вкладка: текст без действия, подсвечивается золотом. */
.packet-window-tab-active {
    color: var(--accent-gold);
    -unity-font-style: bold;
    margin-right: var(--space-2);
}

.packet-window-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.packet-window-row-label {
    flex-grow: 1;
    min-width: 0;
    white-space: normal;
}

.packet-window-row > .packet-window-action {
    min-width: 112px;
    margin-left: 8px;
}

.packet-scrollbar {
    background-color: var(--surface-shelf-solid);
}

.packet-scrollbar--vertical {
    width: 12px;
    border-left-width: 1px;
    border-left-color: var(--border-subtle);
}

.packet-scrollbar--horizontal {
    height: 12px;
    border-top-width: 1px;
    border-top-color: var(--border-subtle);
}

.packet-scrollbar .unity-slider__tracker {
    background-color: var(--surface-raised);
}

.packet-scrollbar .unity-slider__dragger {
    background-color: var(--border-cyan);
    border-color: var(--border-cyan);
}

.packet-scrollbar .unity-repeat-button {
    background-color: var(--surface-raised);
    color: var(--text-primary);
}

.packet-line-themed {
    color: var(--border-cyan);
}
