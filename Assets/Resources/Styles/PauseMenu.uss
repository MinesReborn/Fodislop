/* ═══════════════════════════════════════════════════════════
   PauseMenu — стили меню паузы
   ═══════════════════════════════════════════════════════════ */

.pause-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.pause-dimmer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--surface-inset);
}

.pause-panel {
    background-color: var(--surface-solid);
    border-width: 2px;
    border-color: var(--border-subtle);
    padding: 24px 30px;
    flex-direction: column;
    align-items: center;
    width: 520px;
    max-width: 80%;
    height: 85%;
    min-height: 0;
    flex-shrink: 0;
    overflow: hidden;
    min-width: 260px;
    align-self: center;
}

.pause-settings {
    width: 760px;
    max-width: 90%;
    padding-left: 28px;
    padding-right: 28px;
}

.pause-page {
    align-items: center;
}

.pause-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--accent-gold);
    margin-bottom: var(--space-8);
    flex-shrink: 0;
}

.pause-slider-container {
    flex-direction: column;
    margin-bottom: 18px;
    padding-top: var(--space-2);
    min-width: 240px;
}

.pause-slider-label {
    font-size: var(--size-md);
    color: var(--text-primary);
    margin-bottom: var(--space-4);
    white-space: normal;
}

.pause-scroll {
    width: 100%;
    flex-grow: 1;
    min-height: 0;
    flex-shrink: 1;
}

.settings-layout {
    flex-direction: row;
    width: 100%;
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 18px;
}

.settings-navigation {
    width: 150px;
    min-width: 150px;
    flex-shrink: 0;
    padding-top: var(--space-3);
    padding-right: 18px;
    margin-right: var(--space-1);
    border-right-width: 1px;
    border-right-color: var(--border-line);
}

.settings-content {
    position: relative;
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    padding-left: var(--space-9);
    padding-right: var(--space-4);
    overflow: hidden;
}

.settings-page {
    position: relative;
    width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.settings-page .unity-scroll-view__content-viewport {
    padding-top: var(--space-3);
    padding-right: var(--space-7);
    padding-bottom: 28px;
    padding-left: var(--space-1);
}

.settings-page .unity-scroll-view__content-container {
    padding-bottom: 18px;
}

.settings-tab {
    min-width: 0;
    width: 100%;
    margin-bottom: var(--space-5);
    padding: var(--space-5) var(--space-6);
    -unity-text-align: middle-left;
}

.settings-tab--active {
    background-color: var(--accent-gold);
    color: var(--surface-solid);
}

.settings-tab--advanced {
    margin-top: auto;
    border-color: var(--accent-gold-fill);
}

.settings-section {
    flex-direction: column;
    width: 100%;
    min-width: 0;
    margin-bottom: 22px;
    padding: var(--space-7) var(--space-7) var(--space-8) var(--space-7);
    background-color: var(--surface-shelf-dense);
    border-width: 1px;
    border-color: rgba(105, 112, 125, 0.65);
    border-radius: var(--radius-sm);
}

.settings-section__title {
    color: var(--accent-gold);
    font-size: var(--size-lg);
    -unity-font-style: bold;
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-4);
    border-bottom-width: 1px;
    border-bottom-color: var(--accent-gold-fill);
}

.settings-section__description {
    color: rgba(190, 196, 205, 1);
    font-size: var(--size-sm);
    white-space: normal;
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-1);
}

.pause-subsection {
    flex-direction: column;
}

.pause-subsection-title {
    color: var(--accent-gold);
    font-size: var(--size-md);
    -unity-font-style: bold;
    margin: var(--space-6) 0 var(--space-3) 0;
}

.settings-section .unity-label,
.settings-section .unity-base-field__label,
.settings-section .unity-toggle__label,
.settings-section .unity-foldout__text {
    color: var(--text-primary);
}

.settings-section--advanced,
.settings-section--debug {
    background-color: var(--surface-shelf-solid);
    border-width: 1px;
    border-color: var(--border-line);
    padding: var(--space-7);
}

.settings-section--custom {
    background-color: var(--surface-ember-solid);
    border-color: var(--text-secondary);
}

.settings-section--effects {
    background-color: var(--surface-shelf-solid);
    border-color: var(--text-tertiary);
}

.settings-section--custom .unity-foldout__content {
    margin-top: var(--space-6);
    padding-left: var(--space-4);
    padding-right: var(--space-2);
}

.settings-section--advanced .unity-foldout__content,
.settings-section--debug .unity-foldout__content {
    margin-top: var(--space-7);
    padding-left: var(--space-5);
    padding-right: var(--space-2);
}

.settings-section--debug {
    border-color: var(--accent-gold-fill);
}

.pause-confirm-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--surface-inset);
    align-items: center;
    justify-content: center;
}

.pause-confirm-panel {
    background-color: var(--surface-panel);
    border-width: 2px;
    border-color: var(--border-subtle);
    padding: var(--space-9) 40px;
    flex-direction: column;
    align-items: center;
    min-width: 300px;
}

.pause-confirm-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--accent-gold);
    margin-bottom: var(--space-6);
}

.pause-confirm-desc {
    font-size: var(--size-md);
    color: var(--text-primary);
    white-space: normal;
    margin-bottom: var(--space-9);
    -unity-text-align: middle-center;
}

.pause-confirm-buttons {
    flex-direction: row;
    justify-content: center;
}

.pause-btn-confirm {
    background-color: var(--state-danger-glow);
    border-width: 2px;
    border-color: var(--state-magma-glow);
    padding: var(--space-4) var(--space-9);
    min-width: 100px;
    color: var(--text-primary);
    font-size: var(--size-md);
    -unity-text-align: middle-center;
    margin-right: var(--space-5);
}

.pause-btn {
    background-color: var(--surface-raised);
    border-width: 2px;
    border-color: var(--border-subtle);
    padding: var(--space-4) var(--space-9);
    min-width: 180px;
    margin-bottom: var(--space-5);
    color: var(--text-primary);
    font-size: var(--size-md);
    -unity-text-align: middle-center;
}

#SettingsBack {
    flex-shrink: 0;
    margin-top: var(--space-2);
    margin-bottom: 0;
}

.pause-btn:hover {
    background-color: var(--accent-cyan-wash);
}
