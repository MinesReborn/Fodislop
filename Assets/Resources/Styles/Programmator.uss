/* ═══════════════════════════════════════════════════════════
   Programmator — стили программатора
   ═══════════════════════════════════════════════════════════ */

.programmator-root {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    background-color: var(--surface-panel);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-md);
    padding: var(--space-6);
}

.programmator-grid {
    flex-wrap: wrap;
    background-color: var(--surface-shelf-solid);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-sm);
    padding: var(--space-2);
}

.programmator-cell {
    width: 40px;
    height: 40px;
    background-color: var(--surface-shelf-solid);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-sharp);
    margin: 1px;
    -unity-text-align: middle-center;
    font-size: var(--size-sm);
    color: var(--text-primary);
}

.programmator-cell:hover {
    border-color: var(--accent-gold);
}

.programmator-cell.has-operator {
    background-color: var(--accent-gold-glow);
    color: var(--accent-gold);
}

.programmator-toolbar {
    flex-direction: row;
    margin-top: var(--space-4);
}

/* ─── Радиальное меню ─── */

.prog-radial-root {
    position: absolute;
    width: 260px;
    height: 260px;
}

.prog-radial-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.prog-radial-item {
    position: absolute;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background-color: var(--surface-shelf-solid);
    border-width: 2px;
    border-color: var(--light-edge);
}

.prog-radial-item-label {
    color: var(--light-solid);
    font-size: var(--size-micro);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Кольца радиального меню. Геометрия: центр 130, радиусы 100/55, толщина 36. */
.prog-radial-ring {
    position: absolute;
    border-width: 36px;
}

.prog-radial-ring--outer {
    width: 236px;
    height: 236px;
    left: 12px;
    top: 12px;
    border-radius: var(--radius-pill);
    border-color: var(--border-hairline);
    display: none;
}

.prog-radial-ring--inner {
    width: 146px;
    height: 146px;
    left: 57px;
    top: 57px;
    border-radius: var(--radius-pill);
    border-color: var(--surface-raised);
}

.prog-radial-back {
    position: absolute;
    left: 112px;
    top: 112px;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background-color: var(--surface-shelf-dense);
    border-width: 2px;
    border-color: var(--light-edge);
    display: none;
}

.prog-radial-back:hover {
    border-color: var(--accent-gold);
}

.prog-radial-back-label {
    color: var(--light-solid);
    font-size: 18px;
    -unity-text-align: middle-center;
}

/* ─── Окно программатора и панели ─── */

.prog-popup {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.prog-dimmer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--surface-inset);
}

.prog-panel {
    background-color: var(--surface-slate-dense);
    border-width: 2px;
    border-color: var(--accent-cyan-deep);
    padding: var(--space-5);
    flex-direction: column;
    width: 618px;
    min-height: 520px;
}

.prog-panel--running {
    border-color: var(--state-ok);
}

.prog-top {
    flex-direction: column;
    flex-grow: 1;
    margin-bottom: var(--space-5);
}

.prog-header-row {
    flex-direction: row;
    align-items: flex-start;
}

.prog-row {
    flex-direction: row;
    align-items: center;
}

.prog-action-row {
    flex-direction: row;
    align-items: center;
    margin-top: var(--space-2);
}

.prog-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--accent-gold);
}

.prog-grid-row {
    flex-direction: row;
    justify-content: center;
}

/* ─── Кнопки управления ─── */

.prog-ctrl-btn {
    width: 22px;
    height: 22px;
    background-color: transparent;
    color: var(--text-secondary);
    font-size: var(--size-base);
    -unity-text-align: middle-center;
    border-width: 0;
    padding: 0 var(--space-1);
}

.prog-ctrl-btn--gap {
    margin-right: var(--space-4);
}

.prog-close-btn {
    width: 24px;
    height: 24px;
    background-color: transparent;
    color: var(--text-secondary);
    font-size: 18px;
    -unity-text-align: middle-center;
    border-width: 0;
    padding: 0;
}

.prog-close-btn:hover {
    color: var(--light-solid);
}

.prog-save-btn {
    width: 24px;
    height: 24px;
    background-color: transparent;
    color: var(--text-secondary);
    font-size: var(--size-base);
    -unity-text-align: middle-center;
    border-width: 0;
    padding: 0;
}

.prog-run-btn {
    width: 22px;
    height: 22px;
    background-color: var(--state-ok-tint);
    color: var(--state-ok);
    font-size: var(--size-sm);
    -unity-text-align: middle-center;
    border-width: 0;
    padding: 0;
    margin-left: var(--space-2);
}

.prog-stop-btn {
    width: 22px;
    height: 22px;
    background-color: var(--surface-crisis-dense);
    color: var(--state-danger);
    font-size: var(--size-sm);
    -unity-text-align: middle-center;
    border-width: 0;
    padding: 0;
}

.prog-del-btn {
    width: 22px;
    height: 22px;
    background-color: var(--surface-crisis-dense);
    color: var(--state-danger);
    font-size: var(--size-base);
    -unity-text-align: middle-center;
    border-width: 1px;
    border-color: transparent;
    padding: 0;
    margin-left: var(--space-4);
}

/* ─── Пейджер ─── */

.prog-pager-label {
    font-size: var(--size-sm);
    color: var(--accent-gold);
    min-width: 60px;
    -unity-text-align: middle-center;
    margin-left: var(--space-2);
    margin-right: var(--space-2);
}

.prog-page-input {
    width: 52px;
    height: 22px;
    background-color: var(--surface-shelf-solid);
    color: var(--accent-gold);
    font-size: var(--size-sm);
    -unity-text-align: middle-center;
    border-width: 0;
    margin: 0 var(--space-2);
    padding: 0;
}

.prog-page-input .unity-text-input {
    background-color: var(--surface-shelf-solid);
    color: var(--accent-gold);
    font-size: var(--size-sm);
    -unity-text-align: middle-center;
    border-width: 0;
    padding: 0;
    margin: 0;
}

/* ─── Сетка ─── */

/* Ширина контейнера: 16 колонок × 38 px = 608 px (38 = 32 ячейка + 2×2 отступ + 2 border). */
.prog-grid-container {
    flex-direction: row;
    flex-wrap: wrap;
    width: 608px;
}

/* Высота сетки: 12 рядов × 38 px = 456 px (все ряды фиксированного размера). */
.prog-grid-scroll {
    max-height: 456px;
}

.prog-cell {
    width: 32px;
    height: 32px;
    background-color: var(--surface-shelf-solid);
    border-width: 1px;
    border-color: var(--border-line);
    margin: var(--space-1);
}

.prog-cell--hover {
    border-color: var(--accent-gold);
}

.prog-cell--selected {
    border-color: var(--light-edge);
}

.prog-cell-label {
    font-size: var(--size-micro);
    color: var(--light-solid);
    -unity-text-align: middle-center;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 0;
}

/* ─── Список программ ─── */

.prog-list-panel {
    background-color: var(--surface-slate-dense);
    border-width: 2px;
    border-color: var(--accent-cyan-deep);
    padding: var(--space-5) var(--space-9);
    flex-direction: column;
    width: 400px;
    min-height: 300px;
}

.prog-list-header-row {
    flex-direction: row;
    margin-bottom: var(--space-5);
}

.prog-list-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--accent-gold);
    flex-grow: 1;
}

.prog-list-scroll {
    flex-grow: 1;
    min-height: 200px;
}

.prog-list-row {
    flex-direction: row;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-line);
}

.prog-list-row:hover {
    background-color: var(--surface-shelf-solid);
}

.prog-list-name {
    flex-grow: 1;
    color: var(--accent-gold-hover);
    font-size: var(--size-base);
    -unity-text-align: middle-left;
}

.prog-create-container {
    flex-direction: column;
    margin-top: var(--space-5);
}

.prog-create-btn {
    width: 100%;
    height: 30px;
    background-color: var(--surface-shelf-solid);
    color: var(--accent-gold);
    font-size: var(--size-base);
    -unity-text-align: middle-center;
    border-width: 1px;
    border-color: var(--accent-cyan-deep);
}

.prog-create-btn:hover {
    background-color: var(--surface-shelf-solid);
}

/* ─── Диалог создания программы ─── */

.prog-dialog {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.prog-dialog-panel {
    background-color: var(--surface-slate-dense);
    border-width: 2px;
    border-color: var(--accent-cyan-deep);
    padding: var(--space-8) var(--space-9);
    flex-direction: column;
    align-items: stretch;
    width: 350px;
}

.prog-dialog-title {
    font-size: var(--size-md);
    -unity-font-style: bold;
    color: var(--accent-gold);
    margin-bottom: var(--space-6);
}

.prog-dialog-input {
    height: 32px;
    background-color: var(--surface-shelf-solid);
    color: var(--accent-gold-hover);
    font-size: var(--size-base);
    border-width: 1px;
    border-color: var(--border-line);
    padding-left: var(--space-4);
    margin-bottom: var(--space-8);
}

.prog-dialog-input .unity-text-input {
    background-color: var(--surface-shelf-solid);
    color: var(--accent-gold-hover);
    font-size: var(--size-base);
    border-width: 0;
}

.prog-dialog-buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.prog-dialog-cancel {
    height: 30px;
    min-width: 80px;
    background-color: var(--surface-shelf-solid);
    color: var(--text-secondary);
    font-size: var(--size-base);
    -unity-text-align: middle-center;
    border-width: 1px;
    border-color: var(--border-line);
    margin-right: var(--space-4);
}

.prog-dialog-confirm {
    height: 30px;
    min-width: 80px;
    background-color: var(--state-ok-tint);
    color: var(--state-ok);
    font-size: var(--size-base);
    -unity-text-align: middle-center;
    border-width: 1px;
    border-color: var(--light-edge);
}

/* ─── Джойстик Observer ─── */

.prog-joy-root {
    position: absolute;
    width: 200px;
    height: 200px;
}

.prog-joy-item {
    position: absolute;
    width: 36px;
    height: 36px;
    background-color: var(--surface-shelf-solid);
    border-width: 2px;
    border-color: var(--light-edge);
    border-radius: var(--radius-md);
}

.prog-joy-item:hover {
    background-color: var(--accent-cyan-deep);
    border-color: var(--accent-gold);
}

/* Позиции 8 кнопок направлений — кольцо радиусом 70px вокруг центра 100px
   (формула из исходного кода: Center + Radius*cos/sin(angle) − ItemSize/2). */
.prog-joy-item--0 { left: 82px;    top: 12px; }
.prog-joy-item--1 { left: 131.5px; top: 32.5px; }
.prog-joy-item--2 { left: 152px;   top: 82px; }
.prog-joy-item--3 { left: 131.5px; top: 131.5px; }
.prog-joy-item--4 { left: 82px;    top: 152px; }
.prog-joy-item--5 { left: 32.5px;  top: 131.5px; }
.prog-joy-item--6 { left: 12px;    top: 82px; }
.prog-joy-item--7 { left: 32.5px;  top: 32.5px; }

.prog-joy-item-label {
    color: var(--light-solid);
    font-size: var(--size-base);
    -unity-text-align: middle-center;
}

.prog-joy-center {
    left: 78.4px;
    top: 78.4px;
    width: 43.2px;
    height: 43.2px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

.prog-joy-center .prog-joy-item-label {
    font-size: var(--size-md);
}
