/* Fodinae Theme */

:root {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/Exo2_SDF.asset");
    --cell-size: 50px;
    --icon-size: 36px;
}

/* ─── Базовый переопределитель для всех текстовых элементов UI Toolkit ─── */
Label,
Button,
TextField,
.unity-text-element,
.unity-label,
.unity-button {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/Exo2_SDF.asset");
}

/* ─── Полноэкранный root-контейнер UXML-клонов ─── */
.ui-fullscreen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
}

.ui-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
}

.ui-overlay--modal {
    align-items: center;
    justify-content: center;
    background-color: var(--surface-inset);
}

.ui-overlay--blocking {
    align-items: center;
    justify-content: center;
    background-color: var(--surface-scrim);
}

.ui-overlay-message {
    padding: var(--space-13);
    color: var(--text-primary);
}

.ui-overlay-label {
    max-width: 900px;
    color: var(--text-primary);
    font-size: var(--size-md);
    white-space: normal;
    -unity-text-align: middle-center;
}

.ui-panel {
    flex-direction: column;
    min-height: 0;
    min-width: 0;
    flex-shrink: 1;
    overflow: hidden;
    background-color: var(--surface-panel);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-md);
    padding: var(--space-6);
}

.ui-panel--modal {
    width: 70%;
    max-width: 520px;
    max-height: 85%;
}

.ui-panel__content,
.ui-scroll-viewport {
    width: 100%;
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.ui-scroll-viewport {
    overflow: hidden;
}

.ui-content-column {
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

.ui-actions-row {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: center;
}

/* ═══════════════════════════════════════════════════════════
   ГЛАВНОЕ МЕНЮ (MAIN MENU) & LAUNCHER DESIGN SYSTEM
   ═══════════════════════════════════════════════════════════ */

.mm-root {
    flex-grow: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    /* Как .viewport в макете: планета и тени уходят за край, а не растягивают
       корень. Без этого крупные абсолютные элементы вылезают наружу панели. */
    overflow: hidden;

    /* Прозрачный: небо теперь рисует MenuDisplayBackdropCamera позади UI-оверлея.
       Непрозрачный фон здесь полностью закрыл бы её. PanelSettings не чистит
       цвет (m_ClearColor: 0), поэтому камера видна везде, где UI прозрачен. */
    background-color: transparent;
    /* Локальная палитра меню — тоже алиасы семантического слоя.
       mm-dim становится светлее прежнего rgb(90,107,124): тот давал
       контраст 3.2:1 и не проходил порог читаемости для мелкого текста. */
}

/* ── Фон космоса ── */
.mm-space-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.mm-loader-shade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
}

/* ── Планетарная система справа ── */
/* Кадр планеты полноэкранный и НИКОГДА не меняет размер.
   Размер рендер-текстуры берётся из размера этого элемента, а решение о нём
   принимается в Update каждый кадр. Стоило элементу поехать — и текстура
   пересоздавалась покадрово: лаг, гонки и пустая планета, пока новая текстура
   не отрисована. Поэтому положение и масштаб планеты в кадре задаёт камера
   (MenuSceneryController), а не прямоугольник в интерфейсе. */
/* Планета кадрируется правым краем экрана, а не висит целиком в пустоте:
   тело должно выглядеть слишком большим, чтобы поместиться, — это и есть
   заявка на масштаб мира. Смещение по вертикали убирает мёртвое
   центрирование.

   Числа выведены, а не подобраны. Источник истины — planet-disc: 860px из
   visual/fodinae-ui-lab/css/tokens.css. Здесь планета не CSS-фигура, а
   рендер 3D-сферы в RenderTexture, и сфера занимает ~70% ширины кадра
   (замерено: контейнер 820 → диск 568). Отсюда контейнер = 860 / 0.7 ≈ 1229,
   а поля вокруг диска = (1229 − 860) / 2 ≈ 184. Чтобы диск уходил за правый
   край на 60px, нужен right = −(60 + 184) = −244.

   Тиров у этого правила нет: USS не знает медиазапросов, а держать три
   копии числа хуже, чем одну композицию. Если понадобится — заводить
   .tiercompact .mm-planet-system рядом. */
.mm-planet-system {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.mm-planet-body {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

/* Маркер орбитальной станции. Ровно тот же элемент, что и метка высадки:
   класс .mm-target-reticle несёт всё оформление, а .mm-beacon добавляет только
   позиционирование - left/top выставляются из кода по позиции станции в
   3D-сцене. Раньше это было отдельное кольцо меньшего размера с ping-обводкой
   и без перекрестия: два маркера одного назначения, нарисованные по-разному,
   читаются как недоделка, а не как различие смыслов. */
.mm-target-reticle.mm-beacon {
    left: 0;
    top: 0;
}

.mm-beacon-ping {
    position: absolute;
    width: 16px;
    height: 16px;
    border-radius: var(--radius-pill);
    border-width: 1px;
    border-color: var(--accent-gold);
    opacity: 0;
}

/* Метки скрыты, пока код не поставит их на место.
   Их положение вычисляется из проекции 3D-точки на кадр планеты, то есть
   до появления самой планеты осмысленного положения не существует. С
   видимостью по умолчанию первые кадры показывали «СЕКТОР-09» в углу экрана
   рядом с пустым местом — гонка, видимая глазом на каждом входе в меню. */
.mm-target-reticle {
    position: absolute;
    left: 235px;
    top: 48%;
    width: 22px;
    height: 22px;
    border-radius: var(--radius-pill);
    border-width: 1.5px;
    border-color: var(--accent-gold);
    align-items: center;
    justify-content: center;
}

.mm-target-cross-v {
    position: absolute;
    top: -10px;
    bottom: -10px;
    width: 1.5px;
    background-color: var(--accent-gold);
}

.mm-target-cross-h {
    position: absolute;
    left: -10px;
    right: -10px;
    height: 1.5px;
    background-color: var(--accent-gold);
}

.mm-target-dot {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: var(--radius-sharp);
    background-color: var(--accent-gold);
}

/* Плашка уведена влево от маркера: справа она ложилась прямо на диск и
   читалась как случайное наложение, а не как выноска к точке высадки. */
.mm-target-badge {
    position: absolute;
    right: 28px;
    top: -10px;
    background-color: var(--surface-void-dense);
    border-width: 1px;
    border-color: var(--accent-gold-glow);
    border-radius: var(--radius-sm);
    padding: 3px 9px;
    flex-direction: column;
    /* Ось fit=atomic: бейдж висит абсолютом над сценой, расти ему некуда. */
    white-space: nowrap;
}

.mm-tb-title {
    -unity-font-definition: var(--face-data);
    color: var(--accent-gold);
    font-size: var(--size-xs);
    -unity-font-style: bold;
}

.mm-tb-coords {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/JetBrainsMono_SDF.asset");
    color: var(--accent-cyan);
    font-size: var(--size-micro);
    margin-top: var(--space-1);
}

/* Плашка справа от маркера - для станции, которая живёт у правого лимба:
   слева она уезжала бы на диск планеты. */
.mm-target-badge--right {
    left: 28px;
    right: auto;
}

/* Плашка над маркером - когда станция подходит к нижнему краю и снизу
   ей уже некуда раскрыться, иначе она уезжает под футер. */
.mm-target-badge--above {
    top: auto;
    bottom: 22px;
}

/* ── Header (64px) ── */
.mm-header {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 64px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0 var(--space-14);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
    background-color: var(--surface-abyss-dense);
}

.mm-wordmark {
    flex-direction: row;
    align-items: center;
}

.mm-wordmark-icon {
    width: 32px;
    height: 32px;
    margin-right: var(--space-6);
}

.mm-brand-text {
    flex-direction: column;
}

.mm-brand-title {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/Unbounded_SDF.asset");
    color: var(--light-solid);
    font-size: var(--size-xl);
    -unity-font-style: bold;
}

.mm-brand-sub {
    -unity-font-definition: var(--face-data);
    color: var(--accent-cyan);
    font-size: var(--size-micro);
    margin-top: var(--space-2);
    -unity-font-style: bold;
}

.mm-header-right {
    flex-direction: row;
    align-items: center;
}

.mm-network {
    flex-direction: row;
    align-items: center;
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 5px var(--space-7);
    margin-right: var(--space-7);
}

.mm-network-dot {
    width: 7px;
    height: 7px;
    margin-right: var(--space-4);
    border-radius: var(--radius-md);
    background-color: var(--accent-cyan);
}

.mm-network Label {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/JetBrainsMono_SDF.asset");
    color: var(--text-secondary);
    font-size: var(--size-xs);
}

.mm-user-pill {
    flex-direction: row;
    align-items: center;
    background-color: var(--border-hairline);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-6);
}

.mm-user-pill:hover {
    background-color: var(--accent-cyan-wash);
    border-color: var(--border-cyan);
}

.mm-user-avatar {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-sharp);
    background-color: var(--accent-gold);
    align-items: center;
    justify-content: center;
    margin-right: var(--space-5);
    color: var(--shadow-solid);
}

.mm-user-avatar Label {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/Unbounded_SDF.asset");
    color: var(--surface-crisis-solid);
    font-size: var(--size-sm);
    -unity-font-style: bold;
}

.mm-user-meta {
    flex-direction: column;
}

.mm-user-name {
    -unity-font-definition: var(--face-body);
    color: var(--light-solid);
    font-size: var(--size-base);
    -unity-font-style: bold;
}

.mm-user-rank {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/JetBrainsMono_SDF.asset");
    color: var(--accent-gold);
    font-size: var(--size-2xs);
}

/* ── Правая боковая панель (8 кнопок) ── */
.mm-sidebar {
    position: absolute;
    right: 12px;
    top: 90px;
    flex-direction: column;
    align-items: center;
}

.mm-side-btn {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-pill);
    background-color: var(--surface-slate-dense);
    border-width: 1px;
    border-color: var(--border-cyan);
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-5);
    padding: 0;
}

.mm-side-btn Label {
    font-size: var(--size-md);
    color: var(--text-primary);
}

/* Иконки рейла лежат белыми, цвет даёт USS. Так один файл обслуживает и
   покой, и наведение, и акцентные варианты — раньше вместо контуров были
   заглушки (у Discord — прямоугольник с двумя точками). */
.mm-side-icon {
    width: 22px;
    height: 22px;
    background-size: contain;
    -unity-background-image-tint-color: var(--accent-cyan);
    transition-property: -unity-background-image-tint-color;
    transition-duration: var(--dur-base);
    transition-timing-function: var(--ease-standard);
}

/* При наведении глиф белеет, а не подсвечивается тем же бирюзовым: так в
   макете (css/screens/chrome.css, .side-icon-btn:hover svg). Раньше здесь был
   accent-cyan-hover — наведение почти не читалось. */
.mm-side-btn:hover .mm-side-icon {
    -unity-background-image-tint-color: var(--light-solid);
}

.mm-side-btn--gold .mm-side-icon {
    -unity-background-image-tint-color: var(--accent-gold);
}

.mm-side-btn--danger .mm-side-icon {
    -unity-background-image-tint-color: var(--state-danger);
}

.mm-side-btn:hover {
    background-color: var(--surface-shelf-solid);
    border-color: var(--accent-cyan);
}

.mm-side-btn--gold {
    border-color: var(--accent-gold);
}

.mm-side-btn--danger {
    border-color: var(--border-danger);
}

.mm-side-btn--danger:hover {
    border-color: var(--state-danger);
    background-color: var(--surface-crisis-dense);
}

.mm-side-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 10px;
    height: 10px;
    border-radius: var(--radius-md);
    background-color: var(--state-danger);
    border-width: 1px;
    border-color: var(--light-solid);
}

.mm-sidebar-sep {
    width: 24px;
    height: 1px;
    background-color: var(--border-subtle);
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
}

/* ── Левая колонка меню ── */
.mm-menu {
    position: absolute;
    left: 64px;
    top: 64px;
    bottom: 48px;
    justify-content: center;
    align-items: flex-start;
    width: 500px;
}

.mm-eyebrow {
    -unity-font-definition: var(--face-data);
    color: var(--accent-gold);
    font-size: var(--size-xs);
    -unity-font-style: bold;
    margin-bottom: var(--space-6);
    flex-direction: row;
    align-items: center;
}

/* Золотая чёрточка перед надзаголовком. В макете это ::before, а
   псевдоэлементов в USS нет — здесь настоящий узел. Отступ вместо gap. */
.mm-eyebrow-dash {
    width: 14px;
    height: 2px;
    background-color: var(--accent-gold);
    margin-right: var(--space-4);
}

.mm-heading-group {
    flex-direction: column;
    /* Ось fit=wrap: заголовок переносится, а не режется и не растёт вбок. */
    white-space: normal;
    min-width: 0;
    margin-bottom: var(--space-6);
}

.mm-heading-white {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/Unbounded_SDF.asset");
    color: var(--light-solid);
    font-size: var(--size-3xl);
    -unity-font-style: bold;
}

.mm-heading-gold {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/Unbounded_SDF.asset");
    color: var(--accent-gold);
    font-size: var(--size-3xl);
    -unity-font-style: bold;
}

/* Ширина та же, что у баннера и кнопок: это один столбец, и 400 против 380
   давали несовпадение левого края на 20px — заметное, но необъяснимое. */
.mm-subtitle {
    -unity-font-definition: var(--face-body);
    color: var(--text-secondary);
    font-size: var(--size-md);
    white-space: normal;
    max-width: var(--menu-action-width);
    margin-bottom: 22px;
}

/* ── Кнопки меню ── */
.mm-button-group {
    flex-direction: column;
    width: var(--menu-action-width);
    margin-bottom: var(--space-7);
}

/* margin-left/right: 0 обязательны. В дефолтной теме UI Toolkit у .unity-button
   стоит margin: 3px со всех сторон, а наше правило переопределяло только
   margin-bottom — кнопки оказывались утоплены внутрь колонки на 3px с каждой
   стороны, и их правый край не совпадал с краем баннера обновления. */
Button.mm-btn-primary,
Button#PlayButton {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    /* Ось fit=wrap: подписи разрешено переноситься, значит коробке разрешено
       расти. Жёсткая высота превратила бы перенос в обрезку по нижней грани —
       уступать должна раскладка, а не значение. */
    min-height: 54px;
    white-space: normal;
    padding: 0 var(--space-8) 0 22px;
    background-color: var(--accent-gold);
    border-width: 1px;
    border-color: var(--accent-gold);
    border-radius: var(--radius-md);
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: var(--space-5);
}

Button.mm-btn-primary:hover,
Button#PlayButton:hover {
    background-color: var(--accent-gold-hover);
}

.mm-btn-primary-text {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/Unbounded_SDF.asset");
    color: var(--surface-on-accent);
    font-size: var(--size-md);
    -unity-font-style: bold;
}

.mm-btn-primary-arrow-box {
    width: 28px;
    height: 28px;
    background-color: var(--surface-on-accent);
    border-radius: var(--radius-sm);
    align-items: center;
    justify-content: center;
}

.mm-btn-primary-arrow {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/Unbounded_SDF.asset");
    color: var(--accent-gold);
    font-size: var(--size-md);
    -unity-font-style: bold;
}

Button.mm-btn-secondary,
Button#ServerSelectButton {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 46px;
    padding: 0 var(--space-8) 0 var(--space-9);
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

Button.mm-btn-secondary:hover,
Button#ServerSelectButton:hover {
    background-color: var(--surface-shelf-dense);
    border-color: var(--border-cyan);
}

Button.mm-btn-secondary Label,
Button#ServerSelectButton Label {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/Unbounded_SDF.asset");
    color: var(--light-solid);
    font-size: var(--size-base);
    -unity-font-style: bold;
}

.mm-server-badge {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/JetBrainsMono_SDF.asset");
    background-color: var(--accent-cyan-wash);
    color: var(--accent-cyan);
    border-width: 1px;
    border-color: var(--border-cyan);
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-sm);
    font-size: var(--size-2xs);
    -unity-font-style: bold;
}

/* ── Подсказки клавиш с kbd ── */
.mm-hotkey-row {
    flex-direction: row;
    align-items: center;
    margin-top: var(--space-7);
}

.mm-kbd-box {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/JetBrainsMono_SDF.asset");
    background-color: var(--light-film);
    border-width: 1px;
    border-color: var(--light-sheen);
    border-radius: var(--radius-sharp);
    padding: var(--space-1) var(--space-2);
    color: var(--text-secondary);
    font-size: var(--size-2xs);
    -unity-font-style: bold;
    margin-right: var(--space-3);
}

.mm-kbd-label {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/JetBrainsMono_SDF.asset");
    color: var(--text-tertiary);
    font-size: var(--size-xs);
    margin-right: var(--space-5);
}

.mm-kbd-dot {
    color: var(--text-tertiary);
    font-size: var(--size-2xs);
    margin-right: var(--space-5);
}

/* ── Лоадер и Спуск ── */
/* Экран спуска не закрашивает сцену. Раньше здесь была непрозрачная заливка
   плюс полноэкранная PNG (loader_new.png, 3.4 МБ), которая накрывала уже
   отрисованные звёздное поле и планету — то есть игра прятала собственную
   сцену за картинкой этой же сцены. Вместо этого лёгкий димер: планета видна,
   и камера подъезжает к точке высадки прямо под текстом загрузки. */
.mm-loader {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--surface-sunken);
}

.mm-loader-content {
    position: absolute;
    left: 64px;
    top: 64px;
    bottom: 48px;
    justify-content: center;
    width: 520px;
}

.mm-loader-progress-track {
    width: 100%;
    height: 5px;
    background-color: var(--border-line);
    border-radius: var(--radius-sharp);
    overflow: hidden;
    margin-bottom: var(--space-4);
}

.mm-loader-progress-fill {
    height: 100%;
    width: 0%;
    background-color: var(--accent-gold);
}

.mm-loader-progress-meta {
    flex-direction: row;
    justify-content: space-between;
    width: 420px;
    margin-bottom: var(--space-9);
}

.mm-loader-phase-label {
    -unity-font-definition: var(--face-body);
    color: var(--text-primary);
    font-size: var(--size-sm);
}

.mm-loader-phase-count {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/JetBrainsMono_SDF.asset");
    color: var(--text-primary);
    font-size: var(--size-sm);
}

.mm-loader-phases {
    flex-direction: column;
    margin-top: var(--space-3);
}

.mm-loader-phase-item {
    flex-direction: row;
    color: var(--text-tertiary);
    font-size: var(--size-base);
    margin-bottom: var(--space-3);
}

.mm-loader-phase-icon {
    width: 20px;
    color: var(--text-tertiary);
}

.mm-loader-phase-item--done {
    color: var(--text-secondary);
}
.mm-loader-phase-item--done .mm-loader-phase-icon {
    color: var(--accent-cyan);
}
.mm-loader-phase-item--active {
    color: var(--light-solid);
}
.mm-loader-phase-item--active .mm-loader-phase-icon {
    color: var(--accent-gold);
}

/* ── Footer ── */
.mm-footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 48px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0 var(--space-14);
    border-top-width: 1px;
    border-top-color: var(--border-subtle);
    background-color: var(--surface-abyss-dense);
}

.mm-route {
    flex-direction: row;
    align-items: center;
}

.mm-route-item {
    flex-direction: row;
    align-items: center;
}

.mm-route-text {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/JetBrainsMono_SDF.asset");
    color: var(--text-tertiary);
    font-size: var(--size-xs);
}

.mm-route-item--active .mm-route-text {
    color: var(--accent-gold);
    -unity-font-style: bold;
}

/* Ромб активного шага. Место под него не резервируется: шаги стоят в ряд
   через разделители, и лёгкий сдвиг соседей при переходе читается как
   движение по маршруту. */
.mm-route-dot {
    display: none;
    width: 5px;
    height: 5px;
    margin-right: var(--space-3);
    rotate: 45deg;
    background-color: var(--accent-gold);
}

.mm-route-item--active .mm-route-dot {
    display: flex;
}

.mm-route-sep {
    width: 20px;
    height: 1px;
    margin: 0 var(--space-4);
    background-color: var(--border-subtle);
}

.mm-news-ticker {
    flex-direction: row;
    align-items: center;
    background-color: var(--border-hairline);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 3px;
    padding: 3px var(--space-6);
    max-width: 440px;
}

.mm-news-ticker:hover {
    border-color: var(--accent-cyan);
    background-color: var(--accent-cyan-wash);
}

.mm-ticker-tag {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/Unbounded_SDF.asset");
    color: var(--accent-cyan);
    font-size: var(--size-xs);
    -unity-font-style: bold;
    margin-right: var(--space-4);
    /* Ось fit=atomic: ярлык канала не переносится и не сжимается. */
    white-space: nowrap;
    flex-shrink: 0;
}

.mm-ticker-text {
    -unity-font-definition: var(--face-body);
    color: var(--text-primary);
    font-size: var(--size-xs);
    overflow: hidden;
    white-space: nowrap;
    /* Обрезка без многоточия обрывает строку на полубукве и молчит об этом. */
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
    min-width: 0;
}

.mm-footer-meta {
    flex-direction: row;
    align-items: center;
}

.mm-footer-link {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/JetBrainsMono_SDF.asset");
    background-color: transparent;
    border-width: 0;
    color: var(--text-secondary);
    font-size: var(--size-xs);
    padding: 0;
}

.mm-footer-link:hover {
    color: var(--accent-cyan);
}

.mm-footer-dot {
    color: var(--text-tertiary);
    margin: 0 var(--space-4);
    font-size: var(--size-2xs);
}

.mm-footer-engine {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/JetBrainsMono_SDF.asset");
    color: var(--text-tertiary);
    font-size: var(--size-xs);
}

/* ═══════════════════════════════════════════════════════════
   МОДАЛЬНЫЕ ОКНА (MODAL DIALOGS)
   ═══════════════════════════════════════════════════════════ */

.mm-modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--surface-scrim);
    align-items: center;
    justify-content: center;
}

/* Ширины были перепутаны местами: обычная карточка брала ступень modal-lg, а
   модификатор «широкая» — modal-xl, при том что в макете обычная карточка как
   раз шире (920), а ступень lg отдана узкому варианту. */
.mm-modal-card {
    width: var(--modal-xl);
    max-height: 84%;
    background-color: var(--surface-solid);
    border-width: 1px;
    border-color: var(--border-cyan);
    border-radius: var(--radius-md);
    flex-direction: column;
}

.mm-modal-card--wide {
    width: var(--modal-lg);
}

.mm-modal-header {
    height: 52px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0 var(--space-10);
    background-color: var(--surface-slate-solid);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
}

.mm-modal-title {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/Unbounded_SDF.asset");
    color: var(--text-primary);
    font-size: var(--size-md);
    -unity-font-style: bold;
}

.mm-modal-close {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-md);
    background-color: transparent;
    /* Рамка есть всегда, но прозрачная: :hover ниже красит её в опасный цвет,
       а при нулевой ширине красить нечего — обводки при наведении просто не
       было. Ширина заодно держит габарит, чтобы глиф не прыгал. */
    border-width: 1px;
    border-color: transparent;
    color: var(--text-secondary);
    font-size: 20px;
    -unity-text-align: middle-center;
}

.mm-modal-close:hover {
    color: var(--state-danger);
    border-color: var(--state-danger);
    background-color: var(--state-danger-wash);
}

.mm-modal-body {
    padding: var(--space-9) var(--space-10);
    flex-grow: 1;
}

.mm-modal-desc {
    -unity-font-definition: var(--face-body);
    color: var(--text-secondary);
    font-size: var(--size-base);
    margin-bottom: var(--space-7);
    white-space: normal;
}

.mm-modal-footer {
    /* min-height, а не height: 56 — это удобный минимум для ряда кнопок, а не
       потолок. С потолком подпись, выросшая при переводе, ломалась посреди
       фразы, потому что расти было некуда.
       flex-wrap: ряд управляющих элементов уступает раскладкой, а не значением.
       flex-shrink: 0 — футер, перенёсший кнопки на вторую строку, не имеет
       права быть сжатым обратно колонкой карточки: иначе перенос отработал, а
       его тут же и отняли. */
    min-height: 56px;
    flex-wrap: wrap;
    flex-shrink: 0;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    padding: 0 var(--space-10);
    background-color: var(--surface-abyss-solid);
    border-top-width: 1px;
    border-top-color: var(--border-subtle);
}

Button.mm-btn-gold {
    -unity-font-definition: var(--face-body);
    background-color: var(--accent-gold);
    color: var(--shadow-solid);
    border-width: 1px;
    border-color: var(--accent-gold);
    border-radius: var(--radius-sharp);
    padding: var(--space-4) 18px;
    font-size: var(--size-md);
    -unity-font-style: bold;
}

Button.mm-btn-gold:hover {
    background-color: var(--accent-gold-hover);
}

Button.mm-btn-outline {
    -unity-font-definition: var(--face-body);
    background-color: transparent;
    color: var(--text-primary);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-sharp);
    padding: var(--space-4) 18px;
    font-size: var(--size-md);
    -unity-font-style: bold;
}

Button.mm-btn-outline:hover {
    background-color: var(--light-film);
    border-color: var(--light-solid);
    color: var(--light-solid);
}

#CancelDescentButton {
    margin-top: var(--space-8);
    width: 180px;
}

#RunFullRepairButton {
    margin-right: var(--space-6);
}

/* ── Список серверов ── */
.mm-server-list {
    flex-direction: column;
}

.mm-server-card {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-6) var(--space-8);
    margin-bottom: var(--space-5);
}

.mm-server-card:hover {
    background-color: var(--surface-shelf-dense);
    border-color: var(--accent-gold);
}

.mm-server-card--active {
    border-color: var(--accent-gold);
    border-width: 1.5px;
    background-color: var(--surface-shelf-solid);
}

.mm-sc-left {
    flex-direction: column;
}

.mm-sc-title {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/Unbounded_SDF.asset");
    color: var(--accent-gold);
    font-size: var(--size-base);
    -unity-font-style: bold;
}

.mm-sc-desc {
    -unity-font-definition: var(--face-body);
    color: var(--text-secondary);
    font-size: var(--size-xs);
    margin-top: var(--space-1);
}

.mm-sc-right {
    flex-direction: column;
    align-items: flex-end;
}

.mm-sc-ping {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/JetBrainsMono_SDF.asset");
    color: var(--accent-cyan);
    font-size: var(--size-xs);
    -unity-font-style: bold;
    /* Ось fit=atomic: пинг — измерение, «12» и «ms» неразделимы. */
    white-space: nowrap;
    flex-shrink: 0;
}

.mm-sc-ping--yellow {
    color: var(--accent-gold);
}

.mm-sc-online {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/JetBrainsMono_SDF.asset");
    color: var(--text-tertiary);
    font-size: var(--size-xs);
    margin-top: var(--space-1);
}

/* ── Настройки (2 колонки) ── */
.mm-settings-layout {
    flex-direction: row;
    /* Нижний предел, а не жёсткая высота: в макете колонка растёт под
       содержимое, а фиксированные 380px обрезали длинные разделы. */
    min-height: 480px;
    overflow: hidden;
}

.mm-settings-nav {
    width: 200px;
    background-color: var(--surface-abyss-dense);
    border-right-width: 1px;
    border-right-color: var(--border-subtle);
    padding: var(--space-8) 0;
    flex-direction: column;
}

.mm-nav-tab {
    -unity-font-definition: var(--face-body);
    background-color: transparent;
    border-width: 0;
    border-left-width: 3px;
    border-left-color: transparent;
    color: var(--text-secondary);
    font-size: var(--size-md);
    -unity-font-style: bold;
    padding: var(--space-6) var(--space-9);
    -unity-text-align: middle-left;
    /* Ось fit=wrap: имя раздела длиннее колонки переносится, а не режется. */
    white-space: normal;
}

.mm-nav-tab:hover {
    color: var(--light-solid);
    background-color: var(--accent-cyan-tint);
}

.mm-nav-tab--active {
    color: var(--accent-cyan);
    border-left-color: var(--accent-cyan);
    background-color: var(--accent-cyan-wash);
}

.mm-settings-content {
    flex-grow: 1;
    padding: var(--space-10) var(--space-10);
}

.mm-tab-pane {
    display: none;
    flex-direction: column;
}

.mm-tab-pane--active {
    display: flex;
}

.mm-card-box {
    background-color: var(--surface-slate-veil);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-7);
    margin-bottom: var(--space-6);
}

.mm-card-box--gap-top {
    margin-top: var(--space-8);
}

.mm-card-tag {
    -unity-font-definition: var(--face-data);
    color: var(--accent-gold);
    font-size: var(--size-xs);
    -unity-font-style: bold;
    margin-bottom: var(--space-1);
    padding-bottom: var(--space-2);
    border-bottom-width: 1px;
    border-bottom-color: var(--accent-gold-wash);
}

.mm-row-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-5);
}

.mm-item-title {
    -unity-font-definition: var(--face-body);
    color: var(--text-primary);
    font-size: var(--size-md);
    -unity-font-style: bold;
}

.mm-item-desc {
    -unity-font-definition: var(--face-body);
    color: var(--text-secondary);
    font-size: var(--size-xs);
}

.mm-item-val {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/JetBrainsMono_SDF.asset");
    color: var(--accent-gold);
    font-size: var(--size-sm);
    -unity-font-style: bold;
}

.mm-key-badge {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/JetBrainsMono_SDF.asset");
    background-color: var(--surface-shelf-solid);
    border-width: 1px;
    border-color: var(--border-cyan);
    border-radius: var(--radius-sharp);
    padding: 2px 7px;
    color: var(--accent-cyan);
    font-size: var(--size-xs);
    -unity-font-style: bold;
}

/* ── Таймлайн Хроники ── */
.mm-timeline {
    position: relative;
    padding: var(--space-5) var(--space-5) var(--space-5) var(--space-13);
    flex-direction: column;
}

.mm-timeline-spine {
    position: absolute;
    left: 19px;
    top: var(--space-8);
    bottom: var(--space-8);
    width: 2px;
    background-color: var(--accent-gold);
}

.mm-timeline-section-title {
    -unity-font-definition: var(--face-data);
    font-size: var(--size-xs);
    -unity-font-style: bold;
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
    margin-left: -20px;
}

.mm-timeline-section--purple { color: var(--state-anomaly); }
.mm-timeline-section--gold { color: var(--accent-gold); }
.mm-timeline-section--dim { color: var(--text-tertiary); }

.mm-timeline-card {
    position: relative;
    background-color: var(--surface-slate-veil);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-7) 18px;
    margin-bottom: var(--space-7);
}

.mm-timeline-card:hover {
    background-color: var(--surface-shelf-dense);
    border-color: var(--border-cyan);
}

.mm-tc--purple { border-color: var(--state-anomaly); }
.mm-tc--gold {
    border-color: var(--accent-gold);
    background-color: var(--accent-gold-tint);
}

.mm-tc--dim {
    opacity: 0.75;
    border-color: var(--border-line);
}

.mm-timeline-bead {
    position: absolute;
    align-items: center;
    justify-content: center;
    left: -30px;
    top: 18px;
    width: var(--space-7);
    height: var(--space-7);
    border-radius: var(--radius-pill);
    background-color: var(--surface-void);
    border-width: 2px;
    border-color: var(--accent-cyan);
}

/* Ядро бусины: в макете ::after, здесь настоящий узел. Цвет тот же, что
   у обводки варианта, поэтому задаётся рядом с ним. */
.mm-bead-core {
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-pill);
    background-color: var(--accent-cyan);
}

/* Цвет ядра идёт от варианта карточки, как и цвет обводки. */
.mm-tc--purple .mm-bead-core { background-color: var(--state-anomaly); }
.mm-tc--gold .mm-bead-core { background-color: var(--accent-gold); }
.mm-tc--dim .mm-bead-core { background-color: var(--text-tertiary); }

.mm-tb--purple {
    border-color: var(--state-anomaly);
}

.mm-tb--gold {
    border-color: var(--accent-gold);
}

.mm-tb--dim {
    border-color: var(--text-tertiary);
}

.mm-tc-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
}

.mm-tc-tag {
    -unity-font-definition: var(--face-data);
    font-size: var(--size-2xs);
    -unity-font-style: bold;
    color: var(--text-secondary);
    /* Плашка, а не подпись: заливку и рамку даёт вариант ниже, габарит —
       здесь. Без них тег хроники был просто цветным текстом. */
    padding: var(--space-1) 7px;
    border-radius: var(--radius-sharp);
}

.mm-tag--purple {
    color: var(--state-anomaly);
    background-color: var(--state-anomaly-wash);
    border-width: 1px;
    border-color: var(--state-anomaly-glow);
}

.mm-tag--gold {
    color: var(--accent-gold);
    background-color: var(--accent-gold-wash);
    border-width: 1px;
    border-color: var(--accent-gold-glow);
}

.mm-tc-date {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/JetBrainsMono_SDF.asset");
    color: var(--text-secondary);
    font-size: var(--size-xs);
}

.mm-tc-title {
    -unity-font-definition: var(--face-display);
    color: var(--light-solid);
    font-size: var(--size-md);
    -unity-font-style: bold;
    margin-bottom: var(--space-2);
}

.mm-text--gold { color: var(--accent-gold); }

.mm-tc-body {
    -unity-font-definition: var(--face-body);
    color: var(--text-secondary);
    font-size: var(--size-base);
    white-space: normal;
}

/* ── Лог Ремонта ── */
.mm-repair-log {
    background-color: var(--surface-void);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 3px;
    padding: var(--space-6);
    flex-direction: column;
    height: 170px;
    overflow: hidden;
}

.mm-log-line {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/JetBrainsMono_SDF.asset");
    color: var(--text-secondary);
    font-size: var(--size-sm);
    margin-bottom: var(--space-2);
}

.mm-log-line--success {
    color: var(--state-ok);
    -unity-font-style: bold;
    margin-top: var(--space-3);
}

/* ── Профиль ── */
.mm-profile-hero {
    flex-direction: row;
    align-items: center;
    padding: var(--space-8);
    background-color: var(--surface-slate-veil);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-sm);
}

.mm-profile-avatar {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-sm);
    background-color: var(--accent-gold);
    align-items: center;
    justify-content: center;
    margin-right: 18px;
    color: var(--shadow-solid);
}

.mm-profile-avatar Label {
    -unity-font-definition: var(--face-display);
    color: var(--surface-crisis-solid);
    font-size: var(--size-xl);
    -unity-font-style: bold;
}

.mm-profile-info {
    flex-direction: column;
}

.mm-profile-name {
    -unity-font-definition: var(--face-display);
    color: var(--light-solid);
    font-size: var(--size-lg);
    -unity-font-style: bold;
}

.mm-profile-clan {
    -unity-font-definition: var(--face-data);
    color: var(--accent-cyan);
    font-size: var(--size-sm);
    margin-top: var(--space-1);
}

.mm-profile-uid {
    -unity-font-definition: var(--face-data);
    color: var(--text-secondary);
    font-size: var(--size-2xs);
    margin-top: var(--space-2);
}

/* ═══════════════════════════════════════════════════════════
   Баннер обязательного обновления (#UpdateAlertBanner)
   Соответствует .update-alert-banner из visual/fodinae-ui-lab.
   ═══════════════════════════════════════════════════════════ */

.mm-update-banner {
    flex-direction: row;
    /* Ряд управляющих элементов переносит строку: подпись команды неделима,
       значит при нехватке места уступает раскладка. */
    flex-wrap: wrap;
    align-items: center;
    width: var(--menu-action-width);
    justify-content: space-between;
    margin-bottom: 18px;
    padding: 9px var(--space-6);
    background-color: var(--accent-gold-tint);
    border-width: 1px;
    border-color: var(--accent-gold-glow);
    border-radius: var(--radius-sm);
    /* Левая грань — акцентная полоса состояния. */
    border-left-width: 3px;
    border-left-color: var(--accent-gold);
}

.mm-update-banner:hover {
    background-color: var(--accent-gold-wash);
}

.mm-update-banner-text {
    flex-direction: column;
    flex-grow: 1;
}

.mm-update-banner-title {
    -unity-font-definition: var(--face-data);
    font-size: var(--size-xs);
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--accent-gold);
    margin-bottom: var(--space-1);
}

.mm-update-banner-sub {
    -unity-font-definition: var(--face-body);
    font-size: var(--size-xs);
    color: var(--text-secondary);
    white-space: normal;
}

.mm-update-banner-cta {
    -unity-font-definition: var(--face-data);
    font-size: var(--size-2xs);
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--shadow-solid);
    background-color: var(--accent-gold);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sharp);
    margin-left: var(--space-6);
    /* Ось fit=atomic: подпись действия — имя команды, разрывать её нельзя. */
    white-space: nowrap;
    flex-shrink: 0;
}

.mm-settings-content--servers { flex: 1.3; }
.mm-ip-connect-box { flex-direction: row; align-items: center; margin-top: var(--space-4); }
.mm-flex-1 { flex-grow: 1; }
.mm-server-detail-card {
    flex: 0.9;
    margin-left: var(--space-6);
    background-color: var(--surface-abyss-dense);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-7);
}
.mm-detail-title { font-size: var(--size-md); -unity-font-style: bold; }
.mm-detail-desc { white-space: normal; margin-bottom: var(--space-6); }
.mm-select--controls { min-width: 180px; }
.mm-row-item--gap { margin-top: var(--space-2); }
.mm-feedback-tag { margin-top: var(--space-2); }
.mm-footer--between { justify-content: space-between; }
.mm-update-hero-box {
    background-color: var(--accent-gold-tint);
    border-color: var(--accent-gold-glow);
    margin-bottom: var(--space-6);
    padding: var(--space-8);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}
.mm-update-title { font-size: var(--size-lg); -unity-font-style: bold; }

.mm-progress-fill--init { width: 0%; }
.mm-row-item--meta { margin-top: var(--space-2); }
