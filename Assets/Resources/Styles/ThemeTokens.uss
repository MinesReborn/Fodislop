/* ФАЙЛ МАШИННЫЙ. Правки будут затёрты.
   Источник истины: visual/fodinae-ui-lab/css/tokens.css
   Генератор:       visual/fodinae-ui-lab/tools/emit-uss-tokens.py
   Расхождение ловит CI (scripts/check-architecture.js). */

:root {
    --space-1: 2px;
    --space-2: 4px;
    --space-3: 6px;
    --space-4: 8px;
    --space-5: 10px;
    --space-6: 12px;
    --space-7: 14px;
    --space-8: 16px;
    --space-9: 20px;
    --space-10: 24px;
    --space-11: 28px;
    --space-12: 32px;
    --space-13: 40px;
    --space-14: 48px;
    --radius-sharp: 2px;
    --radius-sm: 3px;
    --radius-md: 4px;
    --radius-pill: 50%;
    --modal-sm: 640px;
    --modal-md: 700px;
    --modal-lg: 800px;
    --modal-xl: 920px;
    --face-display: url("project://database/Assets/Resources/Fonts/Unbounded_SDF.asset");
    --face-body: url("project://database/Assets/Resources/Fonts/Exo2_SDF.asset");
    --face-data: url("project://database/Assets/Resources/Fonts/JetBrainsMono_SDF.asset");
    --size-micro: 9px;
    --size-2xs: 10px;
    --size-xs: 11px;
    --size-sm: 12px;
    --size-base: 13px;
    --size-md: 15px;
    --size-lg: 18px;
    --size-xl: 24px;
    --size-2xl: 32px;
    --size-3xl: 42px;
    --safe-screen: 48px;
    --safe-panel: 24px;
    --safe-box: 12px;
    --safe-tight: 6px;
    --leading-tight: 1.15;
    --leading-base: 1.4;
    --leading-loose: 1.6;
    --tracking-tight: 0;
    --weight-regular: 400;
    --weight-medium: 500;
    --weight-bold: 700;
    --weight-black: 800;
    --dur-instant: 0.1s;
    --dur-fast: 0.12s;
    --dur-base: 0.15s;
    --dur-slow: 0.2s;
    --dur-deliberate: 0.4s;
    --dur-cinematic: 0.8s;
    --ease-standard: ease;
    --ease-linear: linear;
    --ease-decelerate: ease-out-cubic;
    --ease-signature: ease-out-circ;  /* подбор fit-easing.py, max-отклонение 0.129 */
    --order-corona: 1;
    --order-orbit: 2;
    --order-planet: 3;
    --order-beacon: 10;
    --order-surface: 1;
    --order-magma: 2;
    --order-geogrid: 3;
    --order-night: 4;
    --order-atmosphere: 5;
    --order-target: 6;
    --order-mine-canvas: 1;
    --order-mine-robot: 5;
    --order-bead: 2;
    --menu-column: 500px;
    --planet-disc: 860px;
    --menu-action-width: 380px;
    --accent-cyan-dense: rgba(86, 221, 212, 0.85);
    --accent-cyan-fill: rgba(86, 221, 212, 0.55);
    --accent-cyan-glow: rgba(86, 221, 212, 0.3);
    --accent-cyan-solid: rgb(86 221 212);
    --accent-cyan-tint: rgba(86, 221, 212, 0.08);
    --accent-cyan-wash: rgba(86, 221, 212, 0.12);
    --accent-gold-fill: rgba(245, 197, 66, 0.55);
    --accent-gold-glow: rgba(245, 197, 66, 0.3);
    --accent-gold-tint: rgba(245, 197, 66, 0.08);
    --accent-gold-wash: rgba(245, 197, 66, 0.12);
    --state-anomaly-glow: rgba(168, 85, 247, 0.4);
    --state-anomaly-wash: rgba(168, 85, 247, 0.15);
    --state-danger-glow: rgba(255, 85, 85, 0.4);
    --state-danger-wash: rgba(255, 85, 85, 0.15);
    --state-magma-tint: rgba(255, 122, 54, 0.08);
    --state-magma-glow: rgba(255, 122, 54, 0.4);
    --state-ok-tint: rgba(74, 222, 128, 0.08);
    --surface-abyss-dense: rgba(7, 13, 20, 0.9);
    --surface-abyss-solid: rgb(7 13 20);
    --surface-abyss-veil: rgba(7, 13, 20, 0.6);
    --surface-crisis-dense: rgba(16, 3, 3, 0.9);
    --surface-crisis-solid: rgb(16 3 3);
    --surface-ember-solid: rgb(26 18 6);
    --surface-shelf-dense: rgba(17, 30, 46, 0.9);
    --surface-shelf-solid: rgb(17 30 46);
    --surface-slate-dense: rgba(11, 20, 30, 0.9);
    --surface-slate-solid: rgb(11 20 30);
    --surface-slate-veil: rgba(11, 20, 30, 0.6);
    --surface-void-dense: rgba(3, 5, 9, 0.9);
    --surface-void-haze: rgba(3, 5, 9, 0.2);
    --surface-void-shade: rgba(3, 5, 9, 0.5);
    --surface-void-solid: rgb(3 5 9);
    --surface-void-veil: rgba(3, 5, 9, 0.6);
    --border-hairline: rgba(140, 185, 205, 0.08);
    --border-line: rgba(140, 185, 205, 0.15);
    --light-edge: rgba(255, 255, 255, 0.45);
    --light-film: rgba(255, 255, 255, 0.06);
    --light-gleam: rgba(255, 255, 255, 0.7);
    --light-sheen: rgba(255, 255, 255, 0.12);
    --light-solid: rgb(255 255 255);
    --shadow-solid: rgb(0 0 0);
    --surface-void: #030509;
    --surface-solid: #081018;
    --surface-panel: rgba(7, 13, 20, 0.9);
    --surface-raised: rgba(11, 20, 30, 0.6);
    --surface-sunken: rgba(3, 5, 9, 0.6);
    --surface-inset: rgba(3, 5, 9, 0.5);
    --surface-scrim: rgba(3, 5, 9, 0.9);
    --border-subtle: rgba(140, 185, 205, 0.08);
    --border-strong: rgba(140, 185, 205, 0.15);
    --border-cyan: rgba(86, 221, 212, 0.55);
    --border-gold: rgba(245, 197, 66, 0.55);
    --border-danger: rgba(255, 85, 85, 0.4);
    --text-primary: #f0f6f8;
    --text-secondary: #8598a3;
    --text-tertiary: #627b89;
    --text-disabled: #4d6370;
    --text-on-gold: #04080e;
    --surface-on-accent: #04080e;
    --accent-gold: #f5c542;
    --accent-gold-hover: #ffcf4d;
    --accent-cyan: #56ddd4;
    --accent-cyan-hover: #86ede6;
    --accent-cyan-deep: #1e706a;
    --state-ok: #4ade80;
    --state-warn: #ff7a36;
    --state-danger: #ff5555;
    --state-danger-hover: #ff7b7b;
    --state-anomaly: #a855f7;
    --state-ok-wash: rgba(74, 222, 128, 0.08);
    --state-warn-wash: rgba(255, 122, 54, 0.08);
    --rarity-common: #8598a3;
    --rarity-uncommon: #4ade80;
    --rarity-rare: #56ddd4;
    --rarity-epic: #a855f7;
    --rarity-legendary: #f5c542;
    --focus-ring-color: #86ede6;
    --focus-ring-width: 2px;
    --focus-ring-offset: 2px;
}

/* Тир задаётся классом на корневом элементе: @media в USS нет.
   Класс ставит UILayoutTier.cs. */
.tier--compact {
    --size-md: 14px;
    --size-lg: 16px;
    --size-xl: 20px;
    --size-2xl: 26px;
    --size-3xl: 32px;
    --space-10: 20px;
    --space-11: 22px;
    --space-12: 24px;
    --space-13: 28px;
    --space-14: 32px;
    --planet-disc: 520px;
}

/* Тир задаётся классом на корневом элементе: @media в USS нет.
   Класс ставит UILayoutTier.cs. */
.tier--wide {
    --size-md: 16px;
    --size-lg: 20px;
    --size-xl: 28px;
    --size-2xl: 38px;
    --size-3xl: 52px;
    --space-12: 36px;
    --space-13: 48px;
    --space-14: 60px;
    --menu-column: 600px;
    --planet-disc: 940px;
}

