/* Экран загрузки бутстрапа.
 *
 * Лист лежит рядом с разметкой, а не в Assets/Resources/Styles, потому что
 * подключается через <ui:Style> самим UXML: бутстрап поднимается раньше темы.
 * Значения при этом берутся из общей палитры — токены объявлены в теме и
 * доступны здесь по наследованию от корня панели.
 */

.bootstrap-loading-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--surface-scrim);
}

.bootstrap-loading-title {
    color: var(--text-primary);
    font-size: var(--size-2xl);
    -unity-font-style: bold;
}

.bootstrap-loading-phase {
    margin-top: var(--space-6);
    color: var(--text-secondary);
    font-size: var(--size-lg);
}
