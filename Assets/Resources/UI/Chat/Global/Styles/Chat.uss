/* Чат — макет visual/kern-ui (ПК: css/hud.css .chat-peek, .chat-column; events.css .chat-list; micro.css, systems.css).
   Свёрнутый — три строки справа от левой колонки (поле 24 + колонка 264 + шаг 8), высота двух рядов HUD;
   раскрытый — окно 460×340 на том же месте. Интервал букв UI Toolkit — в сотых кегля. */

/* Чат живёт вне корня .hud: шрифт, цвет и сброс кнопок — свои; отступы подписей заданы их классами */
.chat-peek,
.chat-column {
    -unity-font-definition: var(--face-text);
    color: var(--bone);
}

.chat-column Button,
.chat-column Button:hover,
.chat-column Button:active,
.chat-column Button:focus {
    margin: 0;
    border-radius: 0;
    background-image: none;
}

.chat-column .icon-btn.chat-head-btn {
    width: var(--row);
    height: var(--row);
    margin-left: 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.chat-column .icon-btn.chat-head-btn > .ico {
    width: 20px;
    height: 20px;
}

/* Наведение (hud.css .icon-btn:hover): поле светлее и значок — кость */
.chat-column .icon-btn.chat-head-btn:hover {
    background-color: var(--plate-hover);
}

.chat-column .icon-btn.chat-head-btn:hover > .ico {
    -unity-background-image-tint-color: var(--bone);
}

/* ── Свёрнутый чат: метка канала и три последние строки ── */
.chat-peek {
    position: absolute;
    left: 296px;
    bottom: var(--margin);
    height: 80px;
    max-width: 560px;
    margin: 0;
    padding: 0 12px;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
    border-width: 1px;
    border-color: var(--seam);
    border-radius: 0;
    background-color: rgba(17, 16, 24, 0.88);
    background-image: none;
}

.chat-peek:hover,
.chat-peek:active,
.chat-peek:focus {
    border-color: var(--seam);
    background-color: rgba(17, 16, 24, 0.88);
}

.chat-peek-tag {
    margin: 0 10px 0 0;
    padding: 0;
    -unity-font-definition: var(--face-mono);
    font-size: var(--t-0);
    -unity-font-style: normal;
    letter-spacing: 14px;
    color: var(--dim);
}

.chat-peek-lines {
    flex-direction: column;
    align-items: flex-start;
    max-width: 500px;
}

.chat-peek-line {
    margin: 0 0 2px 0;
    padding: 0;
    height: 19px;
    font-size: var(--t-body);
    -unity-font-style: normal;
    -unity-text-align: middle-left; /* свёрнутый чат — кнопка: без этого строки наследуют её центр */
    color: var(--bone);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ── Окно чата ── */
.chat-column {
    position: absolute;
    left: 296px;
    bottom: var(--margin);
    width: 460px;
    height: 340px;
    max-height: 45%;
    flex-direction: column;
    overflow: hidden;
    border-width: 1px;
    border-color: var(--seam-strong);
    background-color: rgba(17, 16, 24, 0.88);
}

.chat-head {
    height: 43px;
    flex-shrink: 0;
    padding: 6px 6px 0 12px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-color: var(--seam);
    /* Полоса штриховки 3 px у шва (hud.css .chat-head: var(--hatch) left bottom / 100% 3px) */
    --hatch-color: rgba(216, 213, 238, 0.1);
    --hatch-band: 3;
}

/* Название текущего канала (макет: выбранная .chat-tab без подчёркивания) — 13 px, fw 500 → жирное */
.chat-title {
    flex-grow: 1;
    margin: 0;
    padding: 6px 16px 8px 0;
    font-size: var(--t-small);
    -unity-font-style: bold;
    color: var(--bone);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.chat-head-btn {
    flex-shrink: 0;
}

/* Счётчик непрочитанного на кнопке */
.badge {
    position: absolute;
    top: 0;
    right: 0;
    min-width: 15px;
    height: 15px;
    margin: 0;
    padding: 0 4px;
    background-color: var(--danger);
    color: var(--white);
    -unity-font-definition: var(--face-mono);
    font-size: var(--t-2);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.chat-sys {
    margin: 0;
    padding: 6px 12px 0;
    -unity-font-definition: var(--face-mono);
    font-size: var(--t-1);
    -unity-font-style: bold;
    letter-spacing: 6px;
    color: var(--dim);
    white-space: normal;
}

.chat-log {
    flex-grow: 1;
    flex-basis: 0;
    padding: 8px 12px;
}

/* Строки не ужимаются: у UI Toolkit flex-shrink 1 и нет минимума по содержимому, как в браузере, — при длинной
   ленте строки сжимались ниже своего текста и налезали друг на друга вместо прокрутки */
/* Строка ленты: ряд «время | текст», под рядом — пунктир (макет .chat-log li: padding-bottom 6, gap 4) */
.chat-line-row {
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-start;
    margin: 0 0 4px 0;
    padding: 0 0 6px 0;
    --dash-color: rgba(50, 47, 70, 0.6);
}

.chat-line--clickable:hover {
    background-color: var(--plate-hover);
}

/* Время строки: моно, приглушённое, колонкой перед текстом (макет .chat-log li time: margin-right 6px) */
.chat-line__time {
    flex-shrink: 0;
    width: 45px;
    margin: 0;
    padding: 0;
    -unity-font-definition: var(--face-mono);
    font-size: var(--t-small);
    -unity-font-style: normal;
    color: var(--dim);
}

/* Текст строки: ник и сообщение, перенос внутри колонки текста */
.chat-line {
    flex-shrink: 1;
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: var(--t-small);
    color: var(--bone);
    white-space: normal;
}

.chat-form {
    flex-shrink: 0;
    padding: 8px 12px 10px;
    border-top-width: 1px;
    border-color: var(--seam);
}

/* Поле ввода чата (и «сказать рядом»): лунка, в фокусе — сигнал слева */
.chat-input {
    height: 34px;
    margin: 0;
    padding: 0;
}

.chat-input > .unity-text-field__input,
.chat-input .unity-base-text-field__input {
    margin: 0;
    padding: 0 12px;
    border-width: 1px;
    border-radius: 0;
    border-color: var(--seam-strong);
    background-color: var(--well);
    color: var(--bone);
    font-size: var(--t-small);
    -unity-font-definition: var(--face-text);
}

.chat-input:focus > .unity-text-field__input,
.chat-input:focus .unity-base-text-field__input {
    border-color: var(--signal);
    border-left-width: 3px;
    padding-left: 10px; /* макет: inset 2px 0 0 — тень текст не сдвигает, рамка 3 px сдвигала бы на 2 */
}

.chat-input .unity-text-element--placeholder,
.chat-input .unity-base-text-field__input--placeholder {
    color: var(--smoke);
}

/* ── Все каналы: поверх ленты, под шапкой ── */
/* Отступ 1 px — внутри рамки колонки: абсолютные отступы UI Toolkit считаются от внешнего края (макет: padding-box) */
.chat-list {
    position: absolute;
    left: 1px;
    right: 1px;
    top: 44px;
    bottom: 1px;
    padding: 8px;
    background-color: var(--graphite-solid);
}

.chat-list-row {
    flex-shrink: 0;
    margin: 0 0 2px 0;
    padding: 8px 10px;
    flex-direction: column;
    align-items: stretch;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    --dash-color: var(--seam);
}

.chat-list-row:hover {
    background-color: var(--plate-hover);
}

.chat-list-row.is-on {
    background-color: rgba(216, 213, 238, 0.08);
}

.chat-list-row__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.chat-list-row__name {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: var(--t-6);
    -unity-font-style: bold;
    color: var(--bone);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.chat-list-row__count {
    min-width: 18px;
    height: 18px;
    margin: 0 0 0 8px;
    padding: 0 6px;
    background-color: var(--danger);
    color: var(--white);
    -unity-font-definition: var(--face-mono);
    font-size: var(--t-3);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.chat-list-row__preview {
    margin: 0;
    padding: 0;
    font-size: var(--t-4);
    color: var(--ash);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ── Локальный чат («сказать рядом», клавиша T): строка по центру ── */
.lchat-panel {
    position: absolute;
    left: 50%;
    top: 45%;
    translate: -50% 0;
    width: 460px;
    flex-direction: row;
    align-items: center;
}

.lchat-input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

/* Кнопка отправки нужна только пальцу: на клавиатуре отправляет Enter. Показывает её Touch.uss */
.lchat-send {
    display: none;
}
