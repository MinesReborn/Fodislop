<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="ChatPanel" class="gchat-panel">
        <ui:Label name="ChatHeader" class="gchat-header" text="chat.channel.global" />
        <ui:VisualElement name="ChatChannels" class="gchat-channel-tabs">
            <ui:Button name="GlobalChannelButton" class="gchat-channel-button" text="chat.channel.chats" />
        </ui:VisualElement>
        <ui:Label name="ChatMuteStatus" class="gchat-mute-status" style="display: none;" />
        <ui:ScrollView name="ChatScroll" class="gchat-scroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />
        <ui:VisualElement name="BottomRow" class="gchat-bottom-row">
            <ui:TextField name="ChatInput" class="gchat-input" />
            <ui:Button name="SendButton" class="gchat-send-button" text="&gt;" />
            <ui:Button name="ColorButton" class="gchat-color-button" />
        </ui:VisualElement>
        <ui:VisualElement name="ColorGrid" class="gchat-color-grid" style="display: none;" />
        <ui:VisualElement name="ChatListPopup" class="gchat-chats-popup" style="display: none;">
            <ui:Label name="ChatListHeader" class="gchat-chats-header" text="chat.list.title" />
            <ui:ScrollView name="ChatListScroll" class="gchat-chats-scroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />
            <ui:Button name="ChatListCloseButton" class="gchat-chats-close" text="chat.list.close" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
