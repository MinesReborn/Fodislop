<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Глобальный чат — макет visual/kern-ui (ПК: css/hud.css .chat-peek, .chat-column; events.css .chat-list).
         Три режима по Tab: 0 — три последние строки справа от левой колонки, 1 — окно на их месте,
         2 — скрыт. В шапке окна — название текущего канала; каналы — списком по кнопке (ChatListPacket),
         непрочитанное считает клиент (ChatEventGateway). -->
    <ui:Button name="ChatPeek" class="chat-peek" tooltip="chat.peek_tooltip" picking-mode="Position">
        <ui:Label name="ChatPeekTag" class="chat-peek-tag caps" text="FED" picking-mode="Ignore" />
        <ui:VisualElement name="ChatPeekLines" class="chat-peek-lines" picking-mode="Ignore" />
    </ui:Button>

    <ui:VisualElement name="ChatPanel" class="chat-column">
        <ui:VisualElement class="chat-head">
            <ui:Label name="ChatHeader" class="chat-title" text="" />
            <ui:Button name="ChatListButton" class="icon-btn chat-head-btn" tooltip="chat.list.title" picking-mode="Position">
                <ui:VisualElement class="ico ico--list" picking-mode="Ignore" />
                <ui:Label name="ChatListBadge" class="badge is-hidden" text="" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="ChatCloseButton" class="icon-btn chat-head-btn" tooltip="chat.collapse" picking-mode="Position">
                <ui:VisualElement class="ico ico--collapse" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
        <ui:Label name="ChatMuteStatus" class="chat-sys" style="display: none;" />
        <ui:ScrollView name="ChatScroll" class="chat-log" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />
        <ui:VisualElement class="chat-form">
            <ui:TextField name="ChatInput" class="chat-input" placeholder-text="chat.input_placeholder" />
        </ui:VisualElement>
        <!-- Все каналы: метка, название, последнее сообщение, непрочитанное -->
        <ui:ScrollView name="ChatListScroll" class="chat-list" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" style="display: none;" />
    </ui:VisualElement>
</ui:UXML>
