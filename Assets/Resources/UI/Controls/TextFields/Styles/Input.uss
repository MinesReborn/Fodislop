

/* ── Поле макета (visual/kern-ui: screens.css .input, micro.css .input) ──
   Углубление: поле well, рамка seam-strong, подсказка дымом. В фокусе — рамка сигналом и полоса 2 px слева
   (inset 2px 0 0 в макете: здесь левая граница 3 px, поле сдвинуто на 2 px, чтобы текст не прыгал). */
.input {
    height: var(--hit);
    margin: 0;
    padding: 0;
}

.input > .unity-base-text-field__input {
    margin: 0;
    padding: 0 var(--sp-7);
    border-width: 1px;
    border-radius: 0;
    border-color: var(--seam-strong);
    background-color: var(--well);
    color: var(--bone);
    -unity-font-definition: var(--face-text);
    font-size: var(--t-body);
    -unity-text-align: middle-left;
}

.input:focus > .unity-base-text-field__input {
    border-color: var(--signal);
    border-left-width: 3px;
    padding-left: 12px;
}

.input .unity-base-text-field__input--placeholder,
.input > .unity-base-text-field__input > .unity-text-element--placeholder {
    color: var(--smoke);
}

.input.invalid > .unity-base-text-field__input {
    border-color: var(--danger);
}
