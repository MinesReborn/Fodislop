/* Вход и онбординг — экраны auth и onboarding макета (visual/kern-ui: screens.css .gate, .onb, .steps, .or, .auth-*;
   micro.css, systems.css). Слой главного меню (MenuGate); общий фон, поля, вкладки — Kern.uss. */

.gateway-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Состояние ворот — один класс на корне: вход или онбординг */
.gate-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.gateway--auth .onb-layer,
.gateway--onboarding #AuthOverlay {
    display: none;
}

.gate-scroll {
    flex-grow: 0;
    max-height: 100%;
}

.gate-scroll .unity-scroll-view__content-container {
    align-items: center;
    padding: var(--sp-12) 0;
}

/* ── Карточка входа 440 px: поля 36 36 28, зазор 14 ── */
.gate {
    width: 440px;
    padding: var(--sp-18) var(--sp-18) var(--sp-14) var(--sp-18);
}

.gate > .brand {
    margin-bottom: 28px;
}

.gate > .seg-tabs {
    margin-bottom: var(--sp-7);
}

/* Обе формы в одной ячейке: высота — по более длинной (регистрация), «Войти» прижата вниз, как в сетке макета */
.auth-stack {
    height: 280px;
    margin-bottom: var(--sp-7);
}

.auth-form {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.auth-form--hidden {
    display: none;
}

.auth-form > .fld {
    margin-bottom: var(--sp-10);
}

.auth-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.auth-note {
    margin: 3px 0 0 0;
    padding: 0;
    align-self: flex-end;
    color: var(--ash);
    -unity-font-definition: var(--face-text);
    font-size: var(--t-4);
}

.auth-submit {
    margin-top: auto;
}

.auth-form > .check {
    margin-bottom: var(--sp-10);
}

/* «или» между линиями шва */
.or {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--sp-7);
}

.or__line {
    flex-grow: 1;
    height: 1px;
    background-color: var(--seam);
}

.or__label {
    margin: 0 var(--sp-6);
    padding: 0;
    color: var(--smoke);
    -unity-font-definition: var(--face-text);
    font-size: var(--t-small);
}

.btn--vk > .btn__label {
    margin: 0;
    padding: 0;
    color: var(--bone);
    -unity-font-definition: var(--face-text);
    font-size: var(--t-strong);
}

.btn__icon--vk {
    background-image: resource("UI/Theme/Kern/Icons/vk");
}

/* ── Онбординг 760 px: шапка, шаги, поле-строки, подвал ── */
.onb {
    width: 760px;
}

.onb-head {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    padding: 22px var(--sp-14) var(--sp-9) var(--sp-14);
    border-bottom-width: 1px;
    border-color: var(--seam);
}

.onb-kicker {
    margin: 0 0 var(--sp-2) 0;
    padding: 0;
    color: var(--ash);
    -unity-font-definition: var(--face-mono);
    font-size: var(--t-small);
    letter-spacing: 14px; /* 0.14em: интервал UI Toolkit — в сотых кегля */
}

.onb-title {
    margin: 0;
    padding: 1.9px 0; /* строка 1.4em = 30.8 против 27 по метрикам шрифта */
    color: var(--bone);
    -unity-font-definition: var(--face-display);
    font-size: var(--t-title);
    -unity-font-style: bold;
    letter-spacing: 2px; /* 0.02em: интервал UI Toolkit — в сотых кегля */
}

.steps {
    flex-direction: row;
}

.steps__item {
    margin: 0 0 0 var(--sp-3);
    padding: var(--sp-3) var(--sp-6);
    border-width: 1px;
    border-color: var(--seam);
    color: var(--smoke);
    -unity-font-definition: var(--face-mono);
    font-size: var(--t-3);
    white-space: nowrap;
}

.steps__item.onb-pill--done {
    color: var(--ash);
}

.steps__item.onb-pill--active {
    border-color: var(--bone);
    background-color: rgba(216, 213, 238, 0.06);
    color: var(--bone);
}

.onb-body {
    min-height: 234px; /* высота самого длинного шага: шаги макета стоят в одной ячейке, тело держит наибольший */
    flex-grow: 1;
}

.onb-body .unity-scroll-view__content-container {
    padding: var(--sp-4) var(--sp-14);
}

.onb-step {
    display: none;
}

.onb-step--active {
    display: flex;
}

.onb-foot {
    flex-direction: row;
    align-items: center;
    padding: var(--sp-8) var(--sp-14);
    border-top-width: 1px;
    border-color: var(--seam);
}

.onb-foot > .btn {
    margin-left: var(--sp-4);
}

/* Первая кнопка подвала — по имени: псевдоклассов порядка в USS нет */
#OnbPrevButton {
    margin-left: 0;
}
