<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- ═══════════════════════════════════════════════════════════
         ВХОД И ОНБОРДИНГ — слой главного меню (MenuGate), экраны auth и onboarding макета
         visual/kern-ui/index.html (data-screen="auth", "onboarding"). Сцены своей нет:
         Bootstrap → MainMenu → MainGame. Состояние — класс на GatewayRoot: вход или онбординг.
         Вход протоколом не проверяется (ClientHelloPacket несёт только токен устройства):
         поля пароля и регистрация — вид макета, рабочие действия — «Войти» и «Войти через VK».
         ═══════════════════════════════════════════════════════════ -->
    <ui:VisualElement name="GatewayRoot" class="gateway-root gateway--auth screen-space">
        <ui:VisualElement class="screen-space__dots" picking-mode="Ignore" />

        <!-- ════ Вход ════ -->
        <ui:VisualElement name="AuthOverlay" class="gate-layer">
            <ui:ScrollView name="AuthFormScroll" class="gate-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
            <ui:VisualElement name="AuthCard" class="panel gate">
                <ui:VisualElement class="brand brand--stacked">
                    <ui:VisualElement name="AuthBrandLogo" class="brand__mark brand__mark--56" />
                    <ui:Label class="wordmark" text="Project Kern" />
                    <ui:Label class="brand-sub caps" text="mainmenu.brand_sub" />
                </ui:VisualElement>

                <ui:VisualElement class="seg-tabs seg-tabs--auth">
                    <ui:Button name="AuthTabLogin" class="seg-tab auth-tab auth-tab--active" text="gateway.auth.login_tab" />
                    <ui:Button name="AuthTabRegister" class="seg-tab auth-tab" text="gateway.auth.register_tab" />
                </ui:VisualElement>

                <ui:VisualElement class="auth-stack">
                    <ui:VisualElement name="AuthLoginForm" class="auth-form">
                        <ui:TextField name="AuthLogin" class="input fld" placeholder-text="gateway.auth.login_field" />
                        <ui:TextField name="AuthPassword" class="input fld" password="true" placeholder-text="gateway.auth.password_field" />
                        <ui:VisualElement class="auth-row">
                            <ui:Toggle name="AuthAutoLogin" class="check" text="gateway.auth.remember" />
                            <ui:Button name="AuthRecoverButton" class="link caps" text="gateway.auth.recover" />
                        </ui:VisualElement>
                        <ui:Label name="AuthHint" class="auth-note" />
                        <ui:Button name="AuthSubmitButton" class="btn btn--primary btn--big auth-submit" text="gateway.auth.submit"><ui:VisualElement class="ico ico--arrows btn__arrows" picking-mode="Ignore" /></ui:Button>
                    </ui:VisualElement>

                    <ui:VisualElement name="AuthRegisterForm" class="auth-form auth-form--hidden">
                        <ui:TextField name="AuthRegLogin" class="input fld" placeholder-text="gateway.auth.login_field" />
                        <ui:TextField name="AuthRegPassword" class="input fld" password="true" placeholder-text="gateway.auth.password_field" />
                        <ui:TextField name="AuthRegConfirm" class="input fld" password="true" placeholder-text="gateway.auth.confirm_password_field" />
                        <ui:Toggle name="AuthAcceptEula" class="check" text="gateway.auth.eula_accept" />
                        <ui:Button name="AuthRegisterSubmitButton" class="btn btn--primary btn--big auth-submit" text="gateway.auth.register_submit"><ui:VisualElement class="ico ico--arrows btn__arrows" picking-mode="Ignore" /></ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="AuthVkSeparator" class="or">
                    <ui:VisualElement class="or__line" />
                    <ui:Label class="or__label" text="gateway.auth.vk_or" />
                    <ui:VisualElement class="or__line" />
                </ui:VisualElement>
                <ui:Button name="AuthVkButton" class="btn btn--big btn--vk">
                    <ui:VisualElement class="btn__icon btn__icon--vk" />
                    <ui:Label name="AuthVkLabel" class="btn__label" text="gateway.auth.vk" />
                </ui:Button>
            </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- ════ Онбординг: три шага, один раз после первого входа (GatewayOnboarding) ════ -->
        <ui:VisualElement name="OnboardingOverlay" class="gate-layer onb-layer">
            <ui:VisualElement class="panel onb">
                <ui:VisualElement class="onb-head">
                    <ui:VisualElement class="onb-head__text">
                        <ui:Label class="onb-kicker caps" text="gateway.onb.eyebrow" />
                        <ui:Label name="OnboardingTitle" class="onb-title" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="steps">
                        <ui:Label name="OnbPill1" class="steps__item onb-pill--active" text="gateway.onb.pill1" />
                        <ui:Label name="OnbPill2" class="steps__item" text="gateway.onb.pill2" />
                        <ui:Label name="OnbPill3" class="steps__item" text="gateway.onb.pill3" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:ScrollView class="onb-body" mode="Vertical" horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement name="OnbStep1" class="onb-step onb-step--active">
                        <ui:VisualElement class="field">
                            <ui:Label class="field__label" text="gateway.onb.language_label" />
                            <ui:DropdownField name="OnbLanguage" class="select" />
                        </ui:VisualElement>
                        <ui:VisualElement class="field">
                            <ui:Label class="field__label" text="gateway.onb.ui_scale_label" />
                            <ui:DropdownField name="OnbUIScale" class="select" />
                        </ui:VisualElement>
                        <ui:VisualElement class="field">
                            <ui:Label class="field__label" text="gateway.onb.text_scale_label" />
                            <ui:DropdownField name="OnbTextScale" class="select" />
                        </ui:VisualElement>
                        <ui:VisualElement class="field field--last">
                            <ui:Label class="field__label" text="settings.window.color_vision" />
                            <ui:DropdownField name="OnbColorVision" class="select" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="OnbStep2" class="onb-step">
                        <ui:VisualElement class="field">
                            <ui:Label class="field__label" text="gateway.onb.lighting_label" />
                            <ui:DropdownField name="OnbGraphicsPreset" class="select" />
                        </ui:VisualElement>
                        <ui:VisualElement class="field">
                            <ui:Label class="field__label" text="gateway.onb.fps_label" />
                            <ui:DropdownField name="OnbFrameRate" class="select" />
                        </ui:VisualElement>
                        <ui:VisualElement class="field">
                            <ui:Label class="field__label" text="gateway.onb.vsync_label" />
                            <ui:Toggle name="OnbVSync" class="switch" />
                        </ui:VisualElement>
                        <ui:VisualElement class="field">
                            <ui:Label class="field__label" text="settings.window.hdr" />
                            <ui:Toggle name="OnbHdr" class="switch" />
                        </ui:VisualElement>
                        <ui:VisualElement class="field field--last">
                            <ui:Label class="field__label" text="settings.window.calibration" />
                            <ui:Button name="OnbCalibrate" class="btn set-btn" text="settings.window.calibrate" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="OnbStep3" class="onb-step">
                        <ui:VisualElement class="field">
                            <ui:Label class="field__label" text="gateway.onb.master_volume_label" />
                            <ui:VisualElement class="range">
                                <ui:Slider name="OnbMasterVolume" class="range__slider" low-value="0" high-value="100" fill="true" />
                                <ui:Label name="OnbMasterVolumeLabel" class="range__out" text="85%" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="field field--last">
                            <ui:Label class="field__label" text="gateway.onb.background_sound_label" />
                            <ui:Toggle name="OnbBackgroundSound" class="switch" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>

                <ui:VisualElement class="onb-foot">
                    <ui:Button name="OnbPrevButton" class="btn" text="gateway.onb.prev" />
                    <ui:VisualElement class="spacer" />
                    <ui:Button name="OnbSkipButton" class="btn btn--ghost" text="gateway.onb.skip" />
                    <ui:Button name="OnbNextButton" class="btn btn--primary" text=""><ui:VisualElement class="ico ico--arrows btn__arrows" picking-mode="Ignore" /></ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
