/* ═══════════════════════════════════════════════════════════
   HUD — стили интерфейса игрока
   ═══════════════════════════════════════════════════════════ */

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-content {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-top-pill-container {
    position: absolute;
    top: var(--space-4);
    left: 0;
    right: 0;
    align-items: center;
}

.hud-top-pill {
    flex-direction: row;
    align-items: center;
    padding: var(--space-1) var(--space-4);
    background-color: var(--surface-void-shade);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-md);
}

.hud-top-pill-version {
    -unity-font-definition: var(--face-data);
    font-size: var(--size-xs);
    color: var(--text-tertiary);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.hud-top-pill-divider {
    width: 1px;
    height: var(--space-6);
    background-color: var(--border-line);
    margin-left: var(--space-3);
    margin-right: var(--space-3);
}

.hud-top-pill-fps {
    -unity-font-definition: var(--face-data);
    font-size: var(--size-xs);
    color: var(--light-solid);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.hud-top-pill-asset {
    flex-direction: row;
    align-items: center;
}

.hud-top-pill-dot {
    width: var(--space-3);
    height: var(--space-3);
    border-radius: var(--radius-pill);
    background-color: var(--state-ok);
    margin-right: var(--space-2);
}

.hud-top-pill-dot.is-loading {
    background-color: var(--accent-gold);
}

.hud-top-pill-asset-text {
    -unity-font-definition: var(--face-data);
    font-size: var(--size-xs);
    color: var(--text-secondary);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.hud-fps-counter {
    padding: var(--space-1) var(--space-4);
    background-color: var(--surface-void-shade);
    border-radius: var(--radius-md);
    color: var(--light-solid);
    font-size: var(--size-base);
    -unity-text-align: upper-center;
}

.world-map-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: var(--surface-scrim);
}

.world-map-window {
    width: 72%;
    height: 72%;
    max-width: 1100px;
    max-height: 760px;
    min-width: 560px;
    min-height: 360px;
    flex-direction: column;
    background-color: var(--surface-panel);
    border-color: var(--border-cyan);
    border-width: 1px;
    border-radius: var(--radius-md);
    overflow: hidden;
}

.world-map-header {
    height: 44px;
    min-height: 44px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: var(--space-5);
    padding-right: var(--space-3);
    background-color: var(--surface-slate-solid);
    border-bottom-color: var(--border-subtle);
    border-bottom-width: 1px;
}

.world-map-title {
    -unity-font-definition: var(--face-display);
    color: var(--text-primary);
    font-size: var(--size-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.world-map-close {
    width: 32px;
    height: 32px;
    padding: 0;
    color: var(--text-secondary);
    background-color: transparent;
    border-width: 0;
    font-size: var(--size-lg);
}

.world-map-follow {
    min-width: 120px;
    height: 32px;
    margin-left: auto;
    margin-right: var(--space-3);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    color: var(--accent-cyan-hover);
    background-color: var(--surface-slate-dense);
    border-color: var(--border-subtle);
    border-width: 1px;
}

.world-map-status {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    padding: var(--space-3) var(--space-5);
    color: var(--text-primary);
    background-color: var(--surface-raised);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-sm);
    font-size: var(--size-sm);
}

.world-map-viewport {
    flex-grow: 1;
    position: relative;
    width: 100%;
    min-height: 0;
    overflow: hidden;
}

.world-map-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.world-map-player-marker {
    position: absolute;
    left: 0;
    top: 0;
    width: 10px;
    height: 10px;
    background-color: var(--state-danger);
    border-color: var(--light-solid);
    border-width: 1.5px;
    border-radius: var(--radius-pill);
    translate: -50% -50%;
}

.hud-top-left {
    position: absolute;
    top: var(--space-5);
    left: var(--space-5);
}

.hud-top-right {
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
}

.hud-bottom-left {
    position: absolute;
    bottom: var(--space-5);
    left: var(--space-5);
}

.hud-bottom-right {
    position: absolute;
    bottom: var(--space-5);
    right: var(--space-5);
}

.asset-status-root {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    align-items: flex-end;
}

.asset-status-button {
    min-width: 38px;
    width: auto;
    height: var(--space-11);
    padding: 0 var(--space-4);
    background-color: var(--surface-slate-dense);
    border-color: var(--text-tertiary);
    border-width: 1px;
    border-radius: var(--radius-md);
    color: var(--light-solid);
    -unity-text-align: middle-center;
}

.asset-status-button:hover,
.asset-status-button.asset-status-loading {
    background-color: var(--surface-shelf-solid);
    border-color: var(--accent-gold);
}

.asset-status-button-label {
    color: var(--light-solid);
    font-size: var(--size-sm);
    -unity-text-align: middle-center;
}

.asset-status-panel {
    width: 300px;
    margin-bottom: var(--space-3);
    padding: var(--space-4);
    background-color: var(--surface-solid);
    border-color: var(--accent-cyan-fill);
    border-width: 1px;
    border-radius: var(--radius-md);
}

.asset-status-summary,
.asset-status-metrics,
.asset-status-details {
    color: var(--light-solid);
    font-size: var(--size-sm);
    white-space: normal;
}

.asset-status-metrics {
    margin-top: 5px;
    color: var(--text-secondary);
}

.asset-status-details {
    margin-top: 5px;
    color: var(--text-secondary);
}

.hud-button {
    background-color: var(--surface-raised);
    border-color: var(--border-subtle);
    border-width: var(--space-1);
    border-radius: var(--radius-sm);
    padding: 0;
    min-width: 100px;
    height: var(--space-11);
    font-size: var(--size-sm);
    color: var(--text-primary);
    -unity-text-align: middle-center;
}

.hud-button:hover {
    background-color: var(--accent-cyan-wash);
}

.hud-button.active {
    background-color: var(--accent-gold);
    color: var(--shadow-solid);
}

.hud-stat {
    color: var(--text-primary);
    font-size: var(--size-md);
    margin: var(--space-1) 0;
}

.hud-stat-label {
    color: var(--text-secondary);
    font-size: var(--size-sm);
}

.hud-bar {
    background-color: var(--surface-shelf-solid);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-sharp);
    height: var(--space-6);
    width: 150px;
}

.hud-bar-fill {
    background-color: var(--accent-gold);
    border-radius: var(--radius-sharp);
}

.hud-panel {
    position: absolute;
    top: var(--space-5);
    left: var(--space-5);
    width: 240px;
    padding: var(--space-6);
    background-color: var(--surface-panel);
    /* Рецепт окна меню (mm-modal-card / hud-minimap-panel): тонкая
       бирюзовая рамка со скруглением вместо серого прямогольника. */
    border-color: var(--border-cyan);
    border-width: 1px;
    border-radius: var(--radius-md);
    flex-direction: column;
}

.hud-title-row {
    flex-direction: row;
    margin-bottom: var(--space-5);
    align-items: center;
}

.hud-clan-button {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    padding: 0;
    margin-left: var(--space-2);
    background-color: var(--accent-gold-glow);
    border-width: 1px;
    border-color: var(--text-disabled);
}

.hud-panel .hud-title-row {
    flex-direction: row;
    margin-bottom: var(--space-2);
}

.hud-panel .hud-nickname {
    font-size: var(--size-lg);
    -unity-font-style: bold;
    color: var(--accent-gold);
    flex-grow: 1;
}

/* Уровень под никнеймом: "Уровень: X" — компактная строка */
.hud-panel .hud-level {
    font-size: var(--size-sm);
    color: var(--text-secondary);
    margin: 0 0 var(--space-1);
    -unity-font-style: bold;
}

.hud-panel .hud-separator {
    height: 1px;
    background-color: var(--border-line);
    margin-bottom: var(--space-2);
}

.hud-panel .hud-stat {
    font-size: var(--size-md);
    color: var(--text-primary);
    margin: 0 0 var(--space-1);
}

.hud-panel .hud-money {
    -unity-font-style: bold;
    font-size: var(--size-md);
    color: var(--text-secondary);
    margin: 0;
}

.hud-panel .hud-credits {
    -unity-font-style: bold;
    font-size: var(--size-md);
    color: var(--accent-gold);
    margin: 0;
}

.hud-panel .hud-basket {
    -unity-font-style: bold;
    font-size: var(--size-md);
    color: var(--accent-gold);
    margin-bottom: var(--space-1);
}

/* Строка "Груз: X% [▣]": процент груза + кнопка выброса бокса справа.
   По мотивам старой кнопки dropbox, стиль — как у .hud-clan-button. */
.hud-basket-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-1);
}

.hud-basket-row .hud-basket {
    margin-bottom: 0;
}

.hud-panel .hud-dropbox-button {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    padding: 0;
    margin-left: var(--space-2);
    font-size: var(--size-sm);
    -unity-text-align: middle-center;
    color: var(--accent-gold);
    background-color: var(--accent-gold-glow);
    border-width: 1px;
    border-color: var(--text-disabled);
}

.hud-panel .hud-dropbox-button:hover {
    background-color: var(--accent-gold);
    color: var(--surface-panel);
}

/* Иконокная кнопка доната в статус-панели — тот же паттерн, что и dropbox:
   без неё ui:Button показывал бы дефолтный серый фон. */
.hud-panel .hud-donate-button {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    padding: 0;
    margin-left: var(--space-2);
    font-size: var(--size-sm);
    -unity-text-align: middle-center;
    color: var(--accent-gold);
    background-color: var(--accent-gold-glow);
    border-width: 1px;
    border-color: var(--text-disabled);
}

.hud-panel .hud-donate-button:hover {
    background-color: var(--accent-gold);
    color: var(--surface-panel);
}

.hud-basket-container {
    flex-direction: column;
}

.hud-stat-wrap {
    white-space: normal;
}

.hud-hp-bar {
    height: var(--space-7);
    background-color: var(--surface-shelf-solid);
    border-radius: var(--radius-sm);
    flex-direction: row;
    margin-bottom: var(--space-2);
}

.hud-hp-fill {
    height: var(--space-7);
    border-radius: var(--radius-sm);
}

/* Счётчик прочности внутри полосы: белый текст, обводка ТОГО ЖЕ цвета —
 * утолщает буквы (эффект жирного), на заливке не даёт тёмной каши. */
.hud-hp-count {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: var(--size-base);
    color: var(--light-solid);
    letter-spacing: 1px;

    /* Мягкое тёмное хало вокруг цифр на светлой заливке и тёмном треке. */
    text-shadow: 0 0 6px rgba(0, 0, 0, 0.9);
    translate: 0 -2px;
    padding: 0;
}

/* Перетаскиваемая ручка панели HUD: висит ПОД нижним краем панели, чтобы
 * не налезать на полосы кристаллов корзины в правом нижнем углу. */
.hud-drag-handle {
    position: absolute;
    right: 4px;
    bottom: -26px;
    width: 28px;
    height: 20px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    background-color: var(--surface-shelf-solid);
    border-width: 1px;
    border-color: var(--border-subtle);
}

.hud-drag-handle > .unity-label {
    font-size: var(--size-base);
    color: var(--text-secondary);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.hud-drag-handle:hover {
    background-color: var(--accent-gold-tint);
}

.hud-drag-handle:hover > .unity-label {
    color: var(--accent-gold);
}

.hud-button-accent {
    background-color: var(--accent-gold);
    border-color: var(--border-subtle);
    border-width: var(--space-1);
    border-radius: var(--radius-sm);
    color: var(--surface-shelf-solid);
    font-size: var(--size-md);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
}

.hud-button-accent:hover {
    background-color: var(--accent-gold-hover);
}

.hud-button-close {
    width: var(--space-10);
    height: var(--space-10);
    background-color: transparent;
    color: var(--text-secondary);
    font-size: var(--size-lg);
    padding: 0;
    border-width: 0;
}

.hud-button-claim {
    align-self: center;
    background-color: var(--accent-cyan-glow);
    color: var(--light-solid);
    border-color: var(--light-edge);
    border-width: var(--space-1);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-8);
    font-size: var(--size-md);
}

.hud-button-claim:hover {
    background-color: var(--light-edge);
}

.hud-button-label {
    font-size: var(--size-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-grow: 1;
}

.hud-bonus-panel {
    position: absolute;
    top: 66px;
    left: 256px;
    width: 260px;
    max-width: 90%;
    max-height: 90%;
    padding: var(--space-5);
    background-color: var(--surface-panel);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-md);
    flex-direction: column;
}

.hud-bonus-panel .hud-stat {
    margin: var(--space-1) 0;
}

.hud-bonus-panel .hud-title-row {
    flex-direction: row;
    margin-bottom: var(--space-5);
}

.hud-bonus-panel .hud-title-row .hud-stat {
    color: var(--accent-gold);
    flex-grow: 1;
}

.hud-status-panel {
    position: absolute;
    /* Ниже кнопки бонуса (top:10 + высота 50 + зазор 6) — как было в C#-версии */
    top: 66px;
    left: 256px;
    width: 220px;
    padding: var(--space-6);
    background-color: var(--surface-panel);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-md);
    flex-direction: column;
}

.hud-status-line {
    font-size: var(--size-md);
    margin-bottom: var(--space-1);
    white-space: normal;
}

.hud-skill-container {
    position: absolute;
    bottom: var(--space-5);
    right: var(--space-5);
    padding: var(--space-4);
    flex-direction: column-reverse;
    align-items: flex-end;
}

.hud-skill-row {
    flex-direction: row;
    align-items: flex-start;
}

/* Ячейка умения - колонка БЕЗ подложки: рамка с иконкой, под ней полоса
   опыта с процентами. Никаких фонов вокруг - HUD не перекрывает сцену. */
.hud-skill-icon {
    position: relative;
    flex-direction: column;
    align-items: center;
    margin-right: var(--space-4);
    margin-bottom: var(--space-4);
}

/* Рамка иконки - точка привязки "up". Верхний отступ 16px - зарезервированное
   место под надпись: держится всегда, даже когда текста нет. Центрируется
   общим align-items: center ячейки. */
.hud-skill-icon-frame {
    position: relative;
    margin-top: 16px;
}

/* Надпись "up" при готовности апгрейда: абсолютный слой строго над иконкой,
   растянут ровно на ширину рамки - middle-center центрирует текст по боксу
   надписи. Бокс чуть сдвинут вправо (left/right парой) - оптическая подгонка:
   при 0px надпись выглядела немного левее центра, при 14px - сильно правее.
   Подстройка: менять left и right ВМЕСТЕ (right = -left), шаг 1-2px; прыжок
   в PlayerHUDSkillGrid сдвигает только по Y и подгонку не затирает. */
.hud-skill-arrow {
    position: absolute;
    left: 2px;
    right: -2px;
    top: -16px;
    height: 14px;
    font-size: var(--size-xs);
    -unity-font-style: bold;
    color: var(--accent-gold);
    -unity-text-align: middle-center;
}

/* Полоса опыта умения ПОД иконкой: трек, лаймовая заливка и ОДНО число
   процентов ПРЯМО В треке - без копий и слоёв. Читаемость и на лайме, и на
   тёмном треке - обводка из рецепта числа корзины (.hud-crystal-count):
   тонкий чёрный контур 1px и мягкое хало. Высота 20px - как у полосы
   корзины, чтобы числа выглядели одинаково. */
.hud-skill-bar {
    width: 44px;
    height: 20px;
    position: relative;
    margin-top: var(--space-3);
    border-radius: var(--radius-sm);
    background-color: var(--surface-panel);
    border-width: 1px;
    border-color: var(--border-subtle);
    overflow: hidden;
}

.hud-skill-bar-fill {
    height: 100%;
    border-radius: var(--radius-sm);
}

/* Проценты В треке: цифры крупно (15px), знак "%" мельче - его размер
   задаётся rich-тегом <size> из кода. Цвет всегда белый - при любом
   заполнении: и на лайме, и на красном переливе, и на тёмном треке.
   Рецепт числа корзины: моно-шрифт данных, контур 1px, мягкое хало. */
.hud-skill-bar-pct {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: var(--face-data);
    -unity-font-style: bold;
    font-size: var(--size-md);
    color: var(--light-solid);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.95);
    text-shadow: 0 0 6px rgba(0, 0, 0, 0.85);
    translate: 0 -1px;
    padding: 0;
}

.hud-crystal-row {
    flex-direction: row;
    margin-bottom: 2px;
    align-items: center;
}

.hud-crystal-row .hud-stat {
    margin: 0 var(--space-2);
}

.hud-crystal-dot {
    width: var(--space-8);
    height: var(--space-8);
    margin-right: var(--space-3);
    align-self: center;
}

/* Кристаллы корзины: полоса с тонированным зоной треком и числом внутри.
 * Зона: <100% лайм, 100-114% жёлтый, 114%+ коралл (перегруз). */
.hud-crystal-bar {
    flex-grow: 1;
    height: 20px;
    border-radius: var(--radius-sm);
    overflow: hidden;
}

.hud-crystal-fill {
    height: 100%;
    border-radius: var(--radius-sm);
}

/* Число внутри полосы: моно-шрифт данных (язык меню: числа - JetBrainsMono),
 * белый жирный, тонкий чёрный контур 1px и мягкое хало - читается одинаково
 * и на светлой лаймовой заливке, и на тёмной части трека. Прежний контур
 * 2px съедал цифру: обводка рисуется по центру штриха, при кегле 15px внутрь
 * уходила половина - от белого оставалась щель, и число читалось тёмным. */
.hud-crystal-count {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: var(--face-data);
    -unity-font-style: bold;
    font-size: var(--size-md);
    color: var(--light-solid);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.95);
    text-shadow: 0 0 6px rgba(0, 0, 0, 0.85);
    translate: 0 -1px;
    padding: 0;
}

/* Зоны корзины: оттенки взяты из семантических токенов меню —
   state-ok (норма), accent-gold (близко к переполнению), state-danger
   (перегруз). Заливка почти плотная (0.8): сквозь полосу силуэт мира
   виден, но под цифрами остаётся ровный цвет - шумная текстура руды
   сквозь сильно прозрачный фон контраст цифр убивала. */
.hud-crystal-row--ok .hud-crystal-bar {
    background-color: rgba(74, 222, 128, 0.3);
    border-width: 1px;
    border-color: rgba(74, 222, 128, 0.45);
}

.hud-crystal-row--ok .hud-crystal-fill {
    background-color: rgba(74, 222, 128, 0.8); /* state-ok */
}

.hud-crystal-row--warn .hud-crystal-bar {
    background-color: rgba(245, 197, 66, 0.3);
    border-width: 1px;
    border-color: var(--border-gold);
}

.hud-crystal-row--warn .hud-crystal-fill {
    background-color: rgba(245, 197, 66, 0.8); /* accent-gold */
}

.hud-crystal-row--over .hud-crystal-bar {
    background-color: rgba(255, 85, 85, 0.3);
    border-width: 1px;
    border-color: var(--border-danger);
}

.hud-crystal-row--over .hud-crystal-fill {
    background-color: rgba(255, 85, 85, 0.8); /* state-danger */
}

.hud-skill-icon-image {
    width: var(--space-10);
    height: var(--space-10);
}

.hud-mission-panel {
    position: absolute;
    top: 50px;
    left: 50%;
    translate: -50% 0;
    min-width: 300px;
    padding: var(--space-4);
    background-color: var(--surface-panel);
    border-color: var(--border-cyan);
    border-width: 1px;
    border-radius: var(--radius-md);
    flex-direction: column;
}

.hud-mission-title {
    color: var(--accent-gold);
    margin-bottom: var(--space-2);
}

.hud-mission-desc {
    margin-bottom: var(--space-4);
}

.hud-mission-progress-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-2);
}

.hud-mission-progress-label {
    margin-right: var(--space-4);
    min-width: 50px;
}

.hud-mission-progress-bar {
    flex-grow: 1;
    height: var(--space-8);
    background-color: var(--surface-shelf-solid);
    border-radius: var(--radius-sm);
}

.hud-mission-progress-fill {
    height: var(--space-8);
    border-radius: var(--radius-sm);
    background-color: var(--accent-gold);
}

.hud-btn-action {
    position: absolute;
    /* Рецепт меню (mm-side-btn): тёмный сланец с яркой бирюзовой рамкой;
       наведение — тонированная подложка, как у mm-user-pill. */
    background-color: var(--surface-slate-dense);
    border-color: var(--border-cyan);
    border-width: 1px;
    border-radius: var(--radius-md);
    font-size: var(--size-sm);
    -unity-font-style: bold;
    color: var(--text-primary);
    -unity-text-align: middle-center;
    padding: 0;
    /* Дефолтная тема Unity добавляет кнопкам margin - из-за него кнопки
       съезжают относительно панели миникарты (обычного VisualElement). */
    margin: 0;
    height: var(--space-11);
}

.hud-btn-action:hover {
    background-color: var(--accent-cyan-wash);
    border-color: var(--accent-cyan);
}

.hud-toggle-btn {
    position: absolute;
    left: var(--space-5);
    /* Выключенное автокопание — состояние «опасность»: кризисная
       подложка и красная рамка; включённая — сланец с бирюзовой рамкой,
       как у остальных кнопок колонки. */
    background-color: var(--surface-crisis-dense);
    border-color: var(--border-danger);
}

.hud-toggle-btn:hover {
    background-color: var(--light-film);
}

.hud-toggle-btn-label {
    font-size: var(--size-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-grow: 1;
    color: var(--state-danger);
}

.hud-toggle-btn.enabled {
    background-color: var(--surface-slate-dense);
    border-color: var(--border-cyan);
}

.hud-toggle-btn.enabled:hover {
    background-color: var(--light-sheen);
}

.hud-toggle-btn-label.enabled {
    color: var(--state-ok);
}

/* Включённая автокопка - текст цвета состояния «норма» (выключенная
   остаётся красной). Класс enabled вешается на саму кнопку, поэтому
   селектор потомственный. */
.hud-toggle-btn.enabled .hud-toggle-btn-label {
    color: var(--state-ok);
}

/* Колонка управления СТРОГО над мини-картой (как в старом клиенте): автокопа ->
   программатор (имя активной программы) со встроенной кнопкой запуска/остановки.
   left берётся из той же переменной --space-8, что и у панели миникарты.
   Анимированный индикатор выполнения (running) намеренно не переносился. */
.hud-toggle-auto-dig {
    left: var(--space-8);
    bottom: 262px;
    width: 174px;
    height: 36px;
    margin: 0;
}

/* Кнопки верхнего ряда - иконки 32x32 без текста. Рамка и подложка темы
   (.hud-btn-action) скрыты: поверх фона остаётся только сам спрайт. */
.hud-btn-top-row {
    position: absolute;
    top: var(--space-5);
    width: 32px;
    height: 32px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

/* Смещения и спрайты кнопок верхнего ряда. Порядок от правого верхнего угла
   влево: Помощь -> Мои здания -> Респаун -> Серверная консоль. Шаг 38px =
   32px спрайт + 6px зазор (--space-3), правый край ряда - --space-5.
   Все иконки векторные: тип импорта SVG (VectorImage) рисуется USS-фоном
   через UIRUtility.IsVectorImageBackground. */
.hud-btn-top-row--faq {
    right: var(--space-5);
    background-image: url("project://database/Assets/Textures/UI/Commands/FAQ/FAQ.svg");
}
.hud-btn-top-row--buildings {
    right: 48px;
    background-image: url("project://database/Assets/Textures/UI/Commands/myBuildings/myBuildings.svg");
}
.hud-btn-top-row--respawn {
    right: 86px;
    background-image: url("project://database/Assets/Textures/UI/Commands/respawn/respawn.svg");
}
.hud-btn-top-row--mconsole {
    right: 124px;
    background-image: url("project://database/Assets/Textures/UI/Commands/console/console.svg");
}

/* Hover-подложка темы перекрыла бы спрайт - на иконках её нет. */
.hud-btn-top-row:hover { background-color: rgba(0, 0, 0, 0); }

.hud-bonus-button {
    position: absolute;
    left: 256px;
    top: var(--space-5);
    width: 90px;
    height: 50px;
}

/* Кнопки чата в HUD больше нет: чат открывается по TAB (GlobalChatUI.Update),
   панель - .gchat-panel в Chat.uss. */

/* Колонка управления над мини-картой (как в старом клиенте): автокопа ->
   программатор (имя активной программы) + кнопка запуска/остановки -> мини-карта.
   Анимированный индикатор выполнения (running) слева от программатора
   намеренно не переносился. */
.hud-programmator-button {
    position: absolute;
    left: var(--space-8);
    bottom: 218px;
    width: 174px;
    height: 36px;
    /* Текст (имя программы) центрируется правее встройки ▶/■. */
    padding-left: 44px;
}

/* Старт/стоп - плоская кликабельная зона в левой части кнопки программатора:
   без фона и рамки (чтобы не выглядела кнопкой в кнопке), только цветной
   символ - зелёный ▶ когда программа стоит, красный ■ когда выполняется. */
.hud-program-run-btn {
    position: absolute;
    left: var(--space-8);
    bottom: 218px;
    width: 44px;
    height: 36px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: var(--state-ok);
    font-size: var(--size-lg);
    padding: 0;
}
.hud-program-run-btn:hover,
.hud-program-run-btn--running:hover {
    background-color: rgba(0, 0, 0, 0);
}
.hud-program-run-btn--running {
    color: var(--state-danger);
    font-size: var(--size-md);
}

/* Native touch targets: keep the movement surface separate from the world
   and leave room for the minimap / existing mode controls on the left. */
.hud-mobile-controls {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    display: flex;
}

.hud-mobile-move-pad {
    position: relative;
    width: 148px;
    height: 148px;
    flex-shrink: 0;
    border-radius: var(--radius-pill);
    background-color: rgba(8, 17, 24, 0.48);
    border-color: var(--border-subtle);
    border-width: 1px;
    display: none;
}

.hud-mobile-move-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 72px;
    height: 72px;
    translate: -50% -50%;
    border-radius: var(--radius-pill);
    border-color: rgba(255, 255, 255, 0.28);
    border-width: 1px;
}

.hud-mobile-move-knob {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 54px;
    height: 54px;
    translate: -50% -50%;
    border-radius: var(--radius-pill);
    background-color: rgba(31, 163, 170, 0.78);
    border-color: var(--accent-cyan-hover);
    border-width: 2px;
}

.hud-mobile-actions {
    flex-direction: row;
    align-items: flex-end;
    display: none;
}

.hud-mobile-build-actions {
    width: 168px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    display: none;
}

.hud-mobile-right-dock {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    flex-direction: column;
    align-items: flex-end;
}

.hud-mobile-action {
    min-width: 62px;
    height: 42px;
    margin-top: var(--space-1);
    margin-left: var(--space-1);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    background-color: rgba(8, 17, 24, 0.82);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-size: var(--size-sm);
    -unity-font-style: bold;
    white-space: normal;
}

.hud-mobile-action--primary {
    min-width: 74px;
    height: 48px;
    background-color: rgba(21, 105, 111, 0.9);
    border-color: var(--accent-cyan-hover);
}

.hud-mobile-build-action {
    min-width: 78px;
    height: 34px;
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    font-size: var(--size-xs);
}

.hud-mobile-build-action--cyan { border-color: rgb(75, 196, 224); }
.hud-mobile-build-action--gray { border-color: rgb(174, 184, 192); }
.hud-mobile-build-action--green { border-color: rgb(91, 204, 122); }
.hud-mobile-build-action--white { border-color: rgb(235, 239, 242); }

/* Видимость и раскладка сенсорного управления — Touch.uss
   (класс pointer--touch на корне панели). */

/* ═══════════════════════════════════════════════════════════
   Sci-Fi Player HUD Styles
   ═══════════════════════════════════════════════════════════ */

.hud-top-left {
    position: absolute;
    top: var(--space-8);
    left: var(--space-8);
    width: 280px;
}

.hud-title-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
}

.hud-nickname {
    -unity-font-definition: var(--face-display);
    color: var(--text-primary);
    font-size: var(--size-base);
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.hud-clan-btn {
    height: var(--space-10);
    padding: 0 var(--space-4);
    font-size: var(--size-2xs);
}

.hud-separator {
    height: 1px;
    background-color: var(--border-subtle);
    margin-bottom: var(--space-4);
}

.hud-stat-group {
    margin-bottom: var(--space-4);
}

.hud-stat-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: var(--space-2);
}

.hud-stat-title {
    -unity-font-definition: var(--face-body);
    color: var(--text-secondary);
    font-size: var(--size-xs);
}

.hud-stat-percent {
    -unity-font-definition: var(--face-data);
    color: var(--state-ok);
    font-size: var(--size-xs);
    -unity-font-style: bold;
}

.hud-bar-track {
    height: var(--space-3);
    margin-bottom: var(--space-3);
}

.hud-currency-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: var(--space-2);
}

.hud-currency-item {
    flex-direction: row;
    align-items: center;
}

.hud-currency-icon {
    font-size: var(--size-base);
    color: var(--accent-cyan);
    margin-right: var(--space-2);
}

.hud-currency-icon--gold {
    color: var(--accent-gold);
}

.hud-currency-value {
    -unity-font-definition: var(--face-data);
    color: var(--text-primary);
    font-size: var(--size-sm);
    -unity-font-style: bold;
}

.hud-currency-value--gold {
    color: var(--accent-gold-hover);
}

/* Корзина */
.hud-basket-panel {
    position: absolute;
    top: 170px;
    left: var(--space-8);
    width: 140px;
    padding: var(--space-4);
}

.hud-basket-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
}

.hud-geology-text {
    -unity-font-definition: var(--face-body);
    color: var(--text-secondary);
    font-size: var(--size-2xs);
}

/* Миссия */
.hud-mission-panel {
    position: absolute;
    top: 50px;
    left: 50%;
    translate: -50% 0;
    width: 380px;
    padding: var(--space-5) var(--space-7);
}

.hud-mission-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-2);
}

.hud-mission-title {
    -unity-font-definition: var(--face-display);
    color: var(--text-primary);
    font-size: var(--size-sm);
    -unity-font-style: bold;
    margin-left: var(--space-4);
}

.hud-mission-desc {
    -unity-font-definition: var(--face-body);
    color: var(--text-secondary);
    font-size: var(--size-xs);
    white-space: normal;
    margin-bottom: var(--space-3);
}

/* J2-C: картинка миссии (M3G из MissionInitPacket.ImageURI) слева от текста. */
.hud-mission-body {
    flex-direction: row;
    align-items: flex-start;
}

.hud-mission-image {
    flex-shrink: 0;
    margin-right: var(--space-3);
    -unity-background-scale-mode: scale-and-crop;
}

.hud-mission-track {
    height: var(--space-2);
    margin-bottom: var(--space-2);
}

#MissionProgressFill {
    width: 0%;
}

.hud-mission-progress-text {
    -unity-font-definition: var(--face-data);
    color: var(--accent-cyan);
    font-size: var(--size-2xs);
    align-self: flex-end;
}

/* Правая колонка действий */
.hud-actions-column {
    position: absolute;
    top: var(--space-8);
    right: var(--space-8);
    width: 160px;
}

.hud-action-btn {
    margin-bottom: var(--space-4);
    width: 100%;
}

.hud-mode-led {
    width: var(--space-3);
    height: var(--space-3);
    border-radius: var(--radius-sm);
    background-color: var(--text-disabled);
    margin-right: var(--space-4);
}

.hud-mode-led--active {
    background-color: var(--accent-cyan-hover);
}


/* ─── Системная миникарта (UI Toolkit) ─── */

.hud-minimap-panel {
    position: absolute;
    bottom: var(--space-8);
    left: var(--space-8);
    padding: var(--space-3);
    background-color: var(--surface-slate-dense);
    border-width: 1px;
    border-color: var(--accent-cyan-fill);
    border-radius: var(--radius-md);
    flex-direction: column;
    align-items: center;
}

.hud-minimap-container {
    width: 160px;
    height: 160px;
    border-width: 1px;
    border-color: var(--light-sheen);
    border-radius: var(--radius-sharp);
    background-color: var(--shadow-solid);
}

.hud-minimap-image {
    width: 100%;
    height: 100%;
}

.hud-minimap-player-marker {
    position: absolute;
    left: 80px;
    top: 80px;
    width: 6px;
    height: 6px;
    background-color: var(--state-danger);
    border-color: var(--light-solid);
    border-width: 1px;
    border-radius: var(--radius-pill);
    translate: -50% -50%;
}

.hud-minimap-coords {
    font-size: var(--size-xs);
    color: var(--accent-cyan-hover);
    -unity-font-style: bold;
    /* Фиксированная высота: панель миникарты получает детерминированную
       высоту (194px), кнопка программатора стыкуется с ней без нахлёста. */
    height: 16px;
    margin-bottom: var(--space-2);
    -unity-text-align: middle-center;
}

/* ─── Кольцо навигации миссии ─── */

.mission-ring-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Размер и положение задаются кодом: кольцо стоит в центре вьюпорта, а его
   радиус — доля меньшей стороны экрана.

   Фон непрозрачный не ради цвета: элемент без фона не даёт UI Toolkit ни
   одного треугольника, и собственному материалу нечего было бы закрашивать.
   Шейдер кольца перекрывает RGB целиком и берёт отсюда только альфу — она
   служит ему прозрачностью элемента. */
.mission-ring {
    position: absolute;
    background-color: var(--light-solid);
}
