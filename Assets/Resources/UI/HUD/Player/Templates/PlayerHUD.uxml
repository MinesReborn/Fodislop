<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- HUD игры — раскладка ПК макета visual/kern-ui (index.html .hud, css/hud.css, systems.css, micro.css):
         левый верх — игрок, груз, состояния и рост навыков; левый низ — автокопание и программатор;
         правый верх — системные кнопки (миникарта и миссия — под ними); строка состояния — по центру сверху.
         Миникарта (Minimap.uxml), хотбар (Inventory.uxml) и чат (GlobalChat.uxml) — свои документы. -->
    <ui:VisualElement name="PlayerHUDRoot" class="hud-root hud" picking-mode="Ignore">
        <ui:VisualElement name="HUDContent" class="hud-content" picking-mode="Ignore">

            <!-- Строка состояния: онлайн (запущено программ), версия · FPS, догрузка ресурсов — видна, пока идёт -->
            <ui:VisualElement name="StatusBar" class="status-bar" picking-mode="Ignore">
                <ui:VisualElement class="online" picking-mode="Ignore">
                    <ui:VisualElement class="ico ico--users" picking-mode="Ignore" />
                    <ui:Label name="OnlinePlayersLabel" class="online__count" text="" picking-mode="Ignore" />
                    <ui:Label name="OnlineProgramsLabel" class="online__progs" text="" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="diag" picking-mode="Ignore">
                    <ui:Label name="BuildVersionLabel" class="diag__text" text="" picking-mode="Ignore" />
                    <ui:Label class="diag__text diag__sep" text="·" picking-mode="Ignore" />
                    <ui:Label name="FPSCounterLabel" class="diag__text" text="" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="AssetStatusPill" class="asset-load" picking-mode="Ignore">
                    <ui:VisualElement class="asset-load__bar" picking-mode="Ignore">
                        <ui:VisualElement name="AssetStatusFill" class="asset-load__fill" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="AssetStatusLabel" class="asset-load__text" text="" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Левая колонка: игрок, груз, состояния, рост навыков -->
            <ui:VisualElement class="col-top" picking-mode="Ignore">
                <ui:VisualElement name="PlayerStatusPanel" class="panel player">
                    <ui:VisualElement class="player-head">
                        <ui:Button name="ClanButton" class="clan-btn" tooltip="hud.tooltip.clan" picking-mode="Position">
                            <ui:VisualElement name="ClanIcon" class="clan-btn__icon" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Label name="PlayerIdLabel" class="pid" text="" />
                        <ui:Label name="NicknameLabel" class="nick" text="---" />
                    </ui:VisualElement>
                    <!-- Прочность: 20 точек по 5 % и крупное число, единица мелко сверху -->
                    <ui:VisualElement class="hp" tooltip="hud.tooltip.hp">
                        <ui:VisualElement name="HPDots" class="hp-dots" picking-mode="Ignore" />
                        <ui:VisualElement class="hp-value" picking-mode="Ignore">
                            <ui:Label name="HPCountLabel" class="hp-value__num" text="--" picking-mode="Ignore" />
                            <ui:Label class="unit" text="HP" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <!-- Деньги и кредиты: знак валюты и значок кредита в одном слоте; «Пополнить» — окно сервера -->
                    <ui:VisualElement class="wallet">
                        <ui:VisualElement class="wallet__cell money" tooltip="hud.money">
                            <ui:Label class="cur" text="$" picking-mode="Ignore" />
                            <ui:Label name="MoneyLabel" class="wallet__num" text="---" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="wallet__cell creds" tooltip="hud.credits">
                            <ui:VisualElement class="ico ico--credit cur-cred" picking-mode="Ignore" />
                            <ui:Label name="CreditsLabel" class="wallet__num" text="---" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Button name="DonateButton" class="btn wallet-buy" tooltip="hud.tooltip.donate" picking-mode="Position">
                            <ui:VisualElement class="ico ico--topup wallet-buy__ico" picking-mode="Ignore" />
                            <ui:Label class="wallet-buy__text" text="hud.donate" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Груз: 20 ячеек по 5 %, шкала 0…100; кристаллы в ряд; геология. Пустая корзина — панели нет -->
                <ui:VisualElement name="CargoPanel" class="panel cargo">
                    <ui:VisualElement class="cargo-head">
                        <ui:Label class="sec-plate caps" text="hud.cargo" picking-mode="Ignore" />
                        <ui:VisualElement name="CargoPercent" class="cargo-percent" picking-mode="Ignore">
                            <ui:Label name="BasketPercentLabel" class="cargo-percent__num" text="" picking-mode="Ignore" />
                            <ui:Label class="unit" text="%" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Button name="DropBoxButton" class="icon-btn icon-btn--small cargo-box" tooltip="hud.tooltip.dropbox" picking-mode="Position">
                            <ui:VisualElement class="ico ico--box" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement name="CargoCells" class="cells cargo-cells" picking-mode="Ignore" />
                    <ui:VisualElement class="cargo-scale" picking-mode="Ignore">
                        <ui:Label text="0" picking-mode="Ignore" />
                        <ui:Label text="50" picking-mode="Ignore" />
                        <ui:Label text="100" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="BasketContainer" class="crystals" picking-mode="Ignore" />
                    <ui:VisualElement name="GeologyBlock" class="geo" picking-mode="Ignore">
                        <ui:VisualElement class="dash-rule" picking-mode="Ignore" />
                        <ui:VisualElement class="geo-row" picking-mode="Ignore">
                            <ui:Label class="sec-plate caps" text="hud.geology_label" picking-mode="Ignore" />
                            <ui:VisualElement name="GeologyCells" class="cells geo-cells" picking-mode="Ignore" />
                            <ui:Label name="GeologyCountLabel" class="geo-count" text="" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="geo-last" picking-mode="Ignore">
                            <ui:Label class="geo-last__label caps" text="hud.geology_last" picking-mode="Ignore" />
                            <ui:Label class="geo-last__sl" text="//" picking-mode="Ignore" />
                            <ui:Label name="GeologyLabel" class="geo-last__name" text="" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Состояния (AddStatusLinePacket) и рост навыков — под грузом -->
                <ui:VisualElement class="left-stack" picking-mode="Ignore">
                    <ui:VisualElement name="StatusPanel" class="states is-hidden" picking-mode="Ignore" />
                    <ui:VisualElement name="SkillContainer" class="mini-skills" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Левый низ: автокопание, программатор -->
            <ui:VisualElement class="col-bottom" picking-mode="Ignore">
                <ui:Button name="AutoDigButton" class="toggle" tooltip="hud.tooltip.autodig" picking-mode="Position">
                    <ui:VisualElement class="toggle__dot" picking-mode="Ignore">
                        <ui:VisualElement class="toggle__knob" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="AutoDigLabel" class="toggle__label" text="hud.autodig" picking-mode="Ignore" />
                    <ui:Label name="AutoDigKey" class="kbd" text="E" picking-mode="Ignore" />
                </ui:Button>
                <ui:VisualElement class="panel prog" picking-mode="Position">
                    <ui:Button name="ProgrammatorButton" class="prog-open" picking-mode="Position">
                        <ui:VisualElement class="ico ico--prog" picking-mode="Ignore" />
                        <ui:Label name="ProgramLabel" class="prog-open__label" text="hud.programmator" picking-mode="Ignore" />
                        <ui:Label name="ProgramNameLabel" class="prog-name is-hidden" text="" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="ProgramRunButton" class="icon-btn prog-run" picking-mode="Position">
                        <ui:VisualElement class="ico ico--play" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Правый верх: игровое (здания, респаун) | системное (консоль, помощь, меню) -->
            <ui:VisualElement class="top-right" picking-mode="Ignore">
                <ui:VisualElement class="sysbuttons" picking-mode="Ignore">
                    <ui:Button name="BuildingsButton" class="sys-btn" tooltip="hud.tooltip.buildings" picking-mode="Position">
                        <ui:VisualElement class="ico ico--buildings" picking-mode="Ignore" />
                        <ui:Label class="control-label caps" text="hud.sys.buildings" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="RespawnButton" class="sys-btn" tooltip="hud.tooltip.respawn" picking-mode="Position">
                        <ui:VisualElement class="ico ico--respawn" picking-mode="Ignore" />
                        <ui:Label class="control-label caps" text="hud.sys.respawn" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:VisualElement class="sys-sep" picking-mode="Ignore" />
                    <ui:Button name="MConsoleButton" class="sys-btn" tooltip="hud.tooltip.mconsole" picking-mode="Position">
                        <ui:VisualElement class="ico ico--console" picking-mode="Ignore" />
                        <ui:Label class="control-label caps" text="hud.sys.console" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="FaqButton" class="sys-btn" tooltip="hud.tooltip.help" picking-mode="Position">
                        <ui:VisualElement class="ico ico--help" picking-mode="Ignore" />
                        <ui:Label class="control-label caps" text="hud.sys.help" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="SysMenuButton" class="sys-btn" tooltip="hud.tooltip.menu" picking-mode="Position">
                        <ui:VisualElement class="ico ico--menu" picking-mode="Ignore" />
                        <ui:Label class="control-label caps" text="hud.sys.menu" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Миссия — под миникартой (MissionInitPacket, MissionProgressPacket): 10 ячеек хода, картинка, название, задание, счёт -->
            <ui:VisualElement name="MissionPanel" class="panel mission is-hidden">
                <ui:VisualElement name="MissionCells" class="cells mission-cells" picking-mode="Ignore" />
                <ui:VisualElement class="mission-body" picking-mode="Ignore">
                    <ui:VisualElement name="MissionImage" class="mission-img is-hidden" picking-mode="Ignore" />
                    <ui:VisualElement class="mission-texts" picking-mode="Ignore">
                        <ui:Label name="MissionTitleLabel" class="mission-title" text="---" picking-mode="Ignore" />
                        <ui:Label name="MissionDescLabel" class="mission-text" text="---" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="MissionProgressLabel" class="mission-progress" text="" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

        <ui:VisualElement name="MobileControls" class="hud-mobile-controls" picking-mode="Ignore">
            <ui:VisualElement name="MobileMovePad" class="hud-mobile-move-pad" picking-mode="Position">
                <ui:VisualElement class="hud-mobile-move-ring" picking-mode="Ignore" />
                <ui:VisualElement name="MobileMoveKnob" class="hud-mobile-move-knob" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="hud-touch-system" picking-mode="Ignore">
                <ui:Button name="TouchFastMoveButton" class="hud-touch-system-btn" text="⇧" tooltip="settings.controls.key_move" />
                <ui:Button name="TouchMapButton" class="hud-touch-system-btn" text="hud.world_map" />
                <ui:Button name="TouchChatButton" class="hud-touch-system-btn" text="chat.channel.global" />
                <ui:Button name="TouchSayButton" class="hud-touch-system-btn" text="…" />
                <ui:Button name="TouchMenuButton" class="hud-touch-system-btn" text="☰" tooltip="pause.title" />
            </ui:VisualElement>
            <ui:VisualElement class="hud-mobile-right-dock" picking-mode="Ignore">
                <ui:VisualElement class="hud-mobile-build-actions" picking-mode="Ignore">
                    <ui:Button name="MobileBuildCyanButton" class="hud-mobile-action hud-mobile-build-action hud-mobile-build-action--cyan" text="C" tooltip="settings.controls.key_build_cyan" />
                    <ui:Button name="MobileBuildGrayButton" class="hud-mobile-action hud-mobile-build-action hud-mobile-build-action--gray" text="G" tooltip="settings.controls.key_build_gray" />
                    <ui:Button name="MobileBuildGreenButton" class="hud-mobile-action hud-mobile-build-action hud-mobile-build-action--green" text="Z" tooltip="settings.controls.key_build_green" />
                    <ui:Button name="MobileBuildWhiteButton" class="hud-mobile-action hud-mobile-build-action hud-mobile-build-action--white" text="W" tooltip="settings.controls.key_build_white" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-mobile-actions" picking-mode="Ignore">
                    <ui:Button name="MobileGeoButton" class="hud-mobile-action" text="settings.controls.key_geo" />
                    <ui:Button name="MobileHealButton" class="hud-mobile-action" text="settings.controls.key_heal" />
                    <ui:Button name="MobileDigButton" class="hud-mobile-action hud-mobile-action--primary" text="settings.controls.key_dig" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        </ui:VisualElement>

        <!-- Карта мира (WorldMapRenderer) — макет visual/kern-ui (#mapDialog, css/hud.css .map-win): окно почти во весь
             экран, шапка «Карта мира» с закрытием, поле карты на точках, справа внизу — масштаб, «к себе» и «Моя метка». -->
        <ui:VisualElement name="WorldMapOverlay" class="dialog-layer map-layer is-hidden" picking-mode="Position">
            <ui:VisualElement name="WorldMapWindow" class="panel map-win">
                <ui:VisualElement class="srv-head map-head">
                    <ui:Label class="srv-head__title caps" text="hud.world_map" />
                    <ui:Label name="WorldMapCoords" class="head-tag map-coords is-empty" picking-mode="Ignore" />
                    <ui:Button name="WorldMapCloseButton" class="icon-btn win-close" tooltip="hud.close" picking-mode="Position">
                        <ui:VisualElement class="ico ico--close" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="WorldMapViewport" class="map-view">
                    <ui:Image name="WorldMapImage" class="map-image" picking-mode="Position" />
                    <ui:VisualElement name="WorldMapPlayerMarker" class="map-me is-hidden" picking-mode="Ignore" />
                    <ui:VisualElement name="WorldMapMarkPin" class="map-pin is-hidden" picking-mode="Ignore">
                        <ui:VisualElement class="map-pin__dot map-pin__dot--mark" picking-mode="Ignore" />
                        <ui:Label class="map-pin__name" text="hud.map_mark_pin" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="WorldMapScale" class="map-scale" picking-mode="Ignore" />
                    <ui:VisualElement class="map-tools" picking-mode="Ignore">
                        <ui:Button name="WorldMapZoomInButton" class="icon-btn map-tool" tooltip="hud.map_zoom_in" picking-mode="Position">
                            <ui:VisualElement class="ico ico--plus" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="WorldMapZoomOutButton" class="icon-btn map-tool" tooltip="hud.map_zoom_out" picking-mode="Position">
                            <ui:VisualElement class="ico ico--minus" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="WorldMapFollowPlayerButton" class="icon-btn map-tool" tooltip="hud.map_follow_player" picking-mode="Position">
                            <ui:VisualElement class="ico ico--target" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="WorldMapMarkButton" class="icon-btn map-tool" tooltip="hud.map_mark" picking-mode="Position">
                            <ui:VisualElement class="ico ico--flag" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
