<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="PlayerHUDRoot" class="hud-root" picking-mode="Ignore">

        <!-- ════════════ ОСНОВНОЙ ГЕЙМПЛЕЙНЫЙ HUD (скрывается в режиме карты) ════════════ -->
        <ui:VisualElement name="HUDContent" class="hud-content" picking-mode="Ignore">

        <ui:VisualElement class="hud-top-pill-container" picking-mode="Ignore">
            <ui:VisualElement name="TopStatusPill" class="hud-top-pill" picking-mode="Position">
                <ui:Label name="BuildVersionLabel" class="hud-top-pill-version" text="" picking-mode="Ignore" />
                <ui:VisualElement class="hud-top-pill-divider" picking-mode="Ignore" />
                <ui:Label name="FPSCounterLabel" class="hud-top-pill-fps" text="" picking-mode="Ignore" />
                <ui:VisualElement class="hud-top-pill-divider" picking-mode="Ignore" />
                <ui:VisualElement name="AssetStatusPill" class="hud-top-pill-asset" picking-mode="Ignore">
                    <ui:VisualElement name="AssetStatusDot" class="hud-top-pill-dot" picking-mode="Ignore" />
                    <ui:Label name="AssetStatusLabel" class="hud-top-pill-asset-text" text="" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ════════════ ЕДИНАЯ ПАНЕЛЬ ИГРОКА (hud-panel): статус, валюта, корзина ════════════ -->
        <ui:VisualElement name="PlayerStatusPanel" class="hud-panel">
            <!-- Верхняя строка: Никнейм, Клан -->
            <ui:VisualElement class="hud-title-row">
                <ui:Label name="NicknameLabel" class="hud-nickname" text="---" />
                <ui:Button name="ClanButton" class="hud-clan-button" tooltip="hud.tooltip.clan" picking-mode="Position" />
            </ui:VisualElement>
            <ui:Label name="LevelLabel" class="hud-level"  text="" />

            <ui:VisualElement class="hud-separator" />

            <!-- Прочность (HP): счётчик внутри полосы прогресса -->
            <ui:VisualElement class="hud-hp-bar">
                <ui:VisualElement name="HPBarFill" class="hud-hp-fill" />
                <ui:Label name="HPCountLabel" class="hud-hp-count" text="-- / --" picking-mode="Ignore" />
            </ui:VisualElement>

            <!-- Валюта -->
            <ui:Label name="MoneyLabel" class="hud-money" text="---" />
            <ui:Label name="CreditsLabel" class="hud-credits" text="---" />
            <ui:Label name="GeologyLabel" class="hud-stat"  text="" />

            <ui:Button name="DonateButton" class="hud-donate-button" text="💰" tooltip="hud.tooltip.donate" picking-mode="Position" />

            <ui:VisualElement name="BasketSeparator" class="hud-separator" />

            <!-- Корзина: груз + кнопка выброса бокса справа от процента (видна только при грузе > 0%) -->
            <ui:VisualElement name="BasketRow" class="hud-basket-row">
                <ui:Label name="BasketPercentLabel" class="hud-basket"  text="" />
                <ui:Button name="DropBoxButton" class="hud-dropbox-button" text="▣" tooltip="hud.tooltip.dropbox" />
            </ui:VisualElement>
            <ui:VisualElement name="BasketContainer" class="hud-basket-container" />

            <!-- Ручка перетаскивания панели -->
            <ui:VisualElement name="HUDDragHandle" class="hud-drag-handle" tooltip="Перетащить панель">
                <ui:Label text="✥" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ════════════ СТАТУСНЫЕ ЛИНИИ (справа от панели игрока, под кнопкой бонуса) ════════════ -->
        <ui:VisualElement name="StatusPanel" class="hud-status-panel is-hidden" />

        <!-- ════════════ КНОПКА БОНУСА ════════════ -->
        <ui:Button name="BonusButton" class="hud-button-accent hud-bonus-button" text="hud.bonus" tooltip="hud.tooltip.bonus" picking-mode="Position" />

        <!-- ════════════ ПАНЕЛЬ БОНУСОВ ════════════ -->
        <ui:VisualElement name="BonusPanel" class="hud-bonus-panel is-hidden">
            <ui:VisualElement class="hud-title-row">
                <ui:Label class="hud-stat" text="hud.bonus" />
                <ui:Button name="BonusCloseButton" class="hud-button-close" text="×" picking-mode="Position" />
            </ui:VisualElement>
            <ui:Label name="BonusStatusLabel" class="hud-stat hud-stat-wrap"  text="" />
            <ui:Button name="BonusClaimButton" class="hud-button-claim is-hidden" text="hud.bonus.claim" picking-mode="Position" />
        </ui:VisualElement>

        <!-- ════════════ ТУМБЛЕРЫ (снизу слева) ════════════ -->
        <ui:Button name="AutoDigButton" class="hud-button hud-toggle-btn hud-toggle-auto-dig" tooltip="hud.tooltip.autodig" picking-mode="Position">
            <ui:Label name="AutoDigLabel" class="hud-toggle-btn-label"  text="" picking-mode="Ignore" />
        </ui:Button>

        <!-- ════════════ ПРОГРАММАТОР (снизу слева) ═════════════ -->
        <!-- Кнопки чата в HUD больше нет: чат открывается и закрывается по TAB
             (см. GlobalChatUI.Update), панель - широкая полоса справа от
             мини-карты (см. .gchat-panel в Chat.uss). -->
        <ui:Button name="ProgrammatorButton" class="hud-btn-action hud-programmator-button"  text="" picking-mode="Position" />
        <ui:Button name="ProgramRunButton" class="hud-btn-action hud-program-run-btn" text="▶" tooltip="hud.tooltip.program_start" picking-mode="Position" />

        <!-- ════════════ КНОПКИ ВЕРХНЕГО РЯДА: FAQ / ЗДАНИЯ / РЕСПАВН / MCONSOLE ════════════ -->
        <!-- Порядок от правого верхнего угла влево: Помощь, Мои здания, Респаун, Серверная консоль.
             Размер 32x32 и спрайты заданы в HUD.uss, классами hud-btn-top-row, текста нет. -->
        <ui:Button name="FaqButton" class="hud-btn-action hud-btn-top-row hud-btn-top-row--faq" picking-mode="Position" />
        <ui:Button name="BuildingsButton" class="hud-btn-action hud-btn-top-row hud-btn-top-row--buildings" picking-mode="Position" />
        <ui:Button name="RespawnButton" class="hud-btn-action hud-btn-top-row hud-btn-top-row--respawn" picking-mode="Position" />
        <ui:Button name="MConsoleButton" class="hud-btn-action hud-btn-top-row hud-btn-top-row--mconsole" tooltip="hud.tooltip.mconsole" picking-mode="Position" />

        <!-- ════════════ НАВЫКИ И ПРОГРЕСС (справа снизу) ════════════ -->
        <ui:VisualElement name="SkillContainer" class="hud-skill-container" picking-mode="Ignore" />

        <ui:VisualElement name="MobileControls" class="hud-mobile-controls" picking-mode="Ignore">
            <ui:VisualElement name="MobileMovePad" class="hud-mobile-move-pad" picking-mode="Position">
                <ui:VisualElement class="hud-mobile-move-ring" picking-mode="Ignore" />
                <ui:VisualElement name="MobileMoveKnob" class="hud-mobile-move-knob" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="hud-touch-system" picking-mode="Ignore">
                <ui:Button name="TouchFastMoveButton" class="hud-touch-system-btn" text="⇧" tooltip="settings.controls.key_move" />
                <ui:Button name="TouchMapButton" class="hud-touch-system-btn" text="hud.world_map" />
                <ui:Button name="TouchChatButton" class="hud-touch-system-btn" text="chat.channel.global" />
                <ui:Button name="TouchSayButton" class="hud-touch-system-btn" text="…" />
                <ui:Button name="TouchMenuButton" class="hud-touch-system-btn" text="☰" tooltip="pause.title" />
            </ui:VisualElement>
            <ui:VisualElement class="hud-mobile-right-dock" picking-mode="Ignore">
                <ui:VisualElement class="hud-mobile-build-actions" picking-mode="Ignore">
                    <ui:Button name="MobileBuildCyanButton" class="hud-mobile-action hud-mobile-build-action hud-mobile-build-action--cyan" text="C" tooltip="settings.controls.key_build_cyan" />
                    <ui:Button name="MobileBuildGrayButton" class="hud-mobile-action hud-mobile-build-action hud-mobile-build-action--gray" text="G" tooltip="settings.controls.key_build_gray" />
                    <ui:Button name="MobileBuildGreenButton" class="hud-mobile-action hud-mobile-build-action hud-mobile-build-action--green" text="Z" tooltip="settings.controls.key_build_green" />
                    <ui:Button name="MobileBuildWhiteButton" class="hud-mobile-action hud-mobile-build-action hud-mobile-build-action--white" text="W" tooltip="settings.controls.key_build_white" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-mobile-actions" picking-mode="Ignore">
                    <ui:Button name="MobileGeoButton" class="hud-mobile-action" text="settings.controls.key_geo" />
                    <ui:Button name="MobileHealButton" class="hud-mobile-action" text="settings.controls.key_heal" />
                    <ui:Button name="MobileDigButton" class="hud-mobile-action hud-mobile-action--primary" text="settings.controls.key_dig" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- ════════════ ТЕКУЩАЯ МИССИЯ (сверху по центру) ════════════ -->
        <ui:VisualElement name="MissionPanel" class="sci-fi-panel sci-fi-panel--tech hud-mission-panel is-hidden">
            <ui:VisualElement class="hud-mission-header">
                <ui:Label class="sci-fi-badge-gold" text="hud.mission_badge" />
                <ui:Label name="MissionTitleLabel" class="hud-mission-title" text="---" />
            </ui:VisualElement>
            <ui:VisualElement class="hud-mission-body">
                <ui:VisualElement name="MissionImage" class="hud-mission-image is-hidden" picking-mode="Ignore" />
                <ui:Label name="MissionDescLabel" class="hud-mission-desc" text="---" />
            </ui:VisualElement>
            <ui:VisualElement class="sci-fi-bar-track hud-mission-track">
                <ui:VisualElement name="MissionProgressFill" class="sci-fi-bar-fill-cyan" />
            </ui:VisualElement>
            <ui:Label name="MissionProgressLabel" class="hud-mission-progress-text" text="0 / 0" />
        </ui:VisualElement>
        </ui:VisualElement>

        <!-- ════════════ КАРТА МИРА (WorldMapRenderer) ════════════ -->
        <ui:VisualElement name="WorldMapOverlay" class="world-map-overlay is-hidden" picking-mode="Position">
            <ui:VisualElement name="WorldMapWindow" class="world-map-window">
                <ui:VisualElement class="world-map-header">
                    <ui:Label class="world-map-title" text="hud.world_map" />
                    <ui:Button name="WorldMapFollowPlayerButton" class="world-map-follow" text="hud.map_follow_player" />
                    <ui:Button name="WorldMapCloseButton" class="world-map-close" text="×" />
                </ui:VisualElement>
                <ui:Label name="WorldMapStatus" class="world-map-status is-hidden" text="hud.map_preparing" picking-mode="Ignore" />
                <ui:VisualElement name="WorldMapViewport" class="world-map-viewport">
                    <ui:Image name="WorldMapImage" class="world-map-image" picking-mode="Position" />
                    <ui:VisualElement name="WorldMapPlayerMarker" class="world-map-player-marker is-hidden" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ════════════ ПОПАПЫ ════════════ -->
        <!-- Респавн -->
        <ui:VisualElement name="RespawnPopup" class="popup-overlay">
            <ui:VisualElement class="popup-dimmer" picking-mode="Ignore" />
            <ui:VisualElement class="popup-panel">
                <ui:Label class="popup-title" text="hud.respawn" />
                <ui:VisualElement class="popup-btn-row">
                    <ui:Button name="RespawnConfirmButton" class="popup-btn" text="hud.ok" />
                    <ui:Button name="RespawnCancelButton" class="popup-btn" text="hud.back" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- «Мои здания» и FAQ — серверные окна (OpenBuildingsClickPacket/OpenHelpClickPacket),
             локальных попапов у них больше нет. -->

    </ui:VisualElement>
</ui:UXML>
