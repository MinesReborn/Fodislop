/* Инвентарь HUD — макет visual/kern-ui (css/hud.css .inventory, .inv-slots, .inv-expand, .item-hint; micro.css, systems.css).
   ПК: правый нижний угол; ячейки 64 в четыре строки с зазором 4, первый предмет снизу, столбцы прирастают влево;
   полоса раскрытия 18 справа. Пустое место ячейки и выбранная ячейка — штриховка (KernVector, --hatch-color). */

.inv-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.inventory {
    position: absolute;
    right: var(--margin);
    bottom: var(--margin);
    flex-direction: row;
    align-items: stretch;
}

/* Ряд столбцов растёт влево; в столбце первый предмет снизу */
.inv-slots {
    flex-direction: row-reverse;
    align-items: flex-end;
}

.inv-slot-column {
    flex-direction: column-reverse;
    margin-left: 4px;
}

.inv-scroll {
    flex-grow: 0;
    flex-shrink: 0;
}

.inv-slot {
    width: var(--ctl-xxl);
    height: var(--ctl-xxl);
    margin-top: 4px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: var(--seam);
    background-color: rgba(17, 16, 24, 0.88);
    transition-property: background-color, border-color;
    transition-duration: var(--dur-fast);
}

.inv-slot.is-hover {
    border-color: var(--seam-strong);
}

.inv-slot.is-on {
    border-color: var(--bone);
    --hatch-color: rgba(216, 213, 238, 0.1);
    --hatch-step: 4;
}

.inv-slot__icon {
    width: var(--ctl-l);
    height: var(--ctl-l);
    -unity-background-scale-mode: scale-to-fit;
}

/* Номер ячейки — место предмета в списке: «01» */
.inv-slot__index {
    position: absolute;
    left: 4px;
    top: 2px;
    margin: 0;
    padding: 0;
    -unity-font-definition: var(--face-mono);
    font-size: var(--t-0);
    -unity-font-style: normal;
    color: var(--dim);
}

.inv-slot__qty {
    position: absolute;
    right: 5px;
    bottom: 3px;
    margin: 0;
    padding: 0;
    -unity-font-definition: var(--face-mono);
    font-size: var(--t-4);
    -unity-font-style: normal;
    letter-spacing: 2px;
    color: var(--bone);
}

/* Полоса раскрытия: справа у края экрана, список раскрывается влево */
.inv-expand {
    width: 18px;
    margin: 4px 0 0 4px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-radius: 0;
    border-color: var(--seam);
    background-color: rgba(17, 16, 24, 0.88);
    background-image: none;
    --hatch-color: rgba(216, 213, 238, 0.1);
    --hatch-step: 4;
    transition-property: background-color, border-color;
    transition-duration: var(--dur-fast);
}

.inv-expand:hover {
    border-color: var(--seam-strong);
    background-color: rgba(17, 16, 24, 0.88);
}

.inv-expand:active {
    background-color: var(--well);
}

.inv-expand > .ico {
    width: 14px;
    height: 14px;
}

.inv-expand:hover > .ico {
    -unity-background-image-tint-color: var(--bone);
}

.inv-expand > .ico.is-flipped {
    scale: -1 1;
}

/* Подсказка выбранного предмета — над игроком по центру */
.item-hint {
    position: absolute;
    left: 50%;
    top: 168px;
    translate: -50% 0;
    margin: 0;
    padding: 6px 14px;
    border-width: 1px;
    border-color: var(--seam);
    background-color: rgba(17, 16, 24, 0.88);
    color: var(--bone);
    font-size: var(--t-body);
    white-space: nowrap;
}
