<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Инвентарь HUD — макет visual/kern-ui (.inventory, ПК): правый нижний угол, ячейки 64 в четыре строки,
         первый предмет снизу, столбцы прирастают влево; справа полоса раскрытия (видна, если предметов больше
         четырёх). Ячейки собирает код (InventorySlotCollection) из OrderedTypes модели.
         Корень в picking-mode="Ignore": пустое поле экрана не перехватывает клики мира; интерактивное
         внутри явно возвращает Position. -->
    <ui:VisualElement name="InventoryRoot" class="inv-root" picking-mode="Ignore">
        <ui:VisualElement name="HotbarContainer" class="inventory" picking-mode="Position">
            <!-- Короткий список: первые четыре предмета -->
            <ui:VisualElement name="HotbarSlots" class="inv-slots" picking-mode="Position" />

            <!-- Полный список: все предметы, та же раскладка. Прокрутка — для сенсорного окна (Touch.uss) -->
            <ui:ScrollView name="InventoryScroll" class="inv-scroll is-hidden" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" picking-mode="Position">
                <ui:VisualElement name="InventoryGrid" class="inv-slots is-hidden" picking-mode="Position" />
            </ui:ScrollView>

            <ui:Button name="InventoryToggleBtn" class="inv-expand" tooltip="inventory.open" picking-mode="Position">
                <ui:VisualElement name="InventoryToggleIcon" class="ico ico--chevron" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>

        <!-- Выбранный предмет: «Геопак: Enter — применить, Esc — отмена» (макет .item-hint) -->
        <ui:Label name="ItemHint" class="item-hint" text="" picking-mode="Ignore" style="display: none;" />
    </ui:VisualElement>
</ui:UXML>
