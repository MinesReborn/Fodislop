<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Главное меню — экран menu и спуск (descent) макета visual/kern-ui/index.html. Фон экранов вне игры,
         шапка со знаком, заголовок и главное действие слева, связь и выход справа, строка сборки внизу.
         Вход и онбординг — слой MenuGate поверх этого дерева (Gateway.uxml). Окна меню — ниже, в ModalOverlay. -->
    <ui:VisualElement name="MainMenuRoot" class="mm-root screen-space screen--menu">
        <ui:VisualElement class="screen-space__dots" picking-mode="Ignore" />
        <ui:VisualElement class="menu-shade" picking-mode="Ignore" />

        <ui:VisualElement class="menu-top">
            <ui:VisualElement class="brand">
                <ui:VisualElement class="brand__mark" />
                <ui:Label class="wordmark" text="Project Kern" />
                <ui:Label class="brand-sub caps" text="mainmenu.brand_sub" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Главный блок: заголовок, описание игры, «Играть» и «Настройки» -->
        <ui:VisualElement name="MainMenuContainer" class="menu-main">
            <ui:Label class="menu-title lh-100" text="mainmenu.title" />
            <ui:Label class="menu-lead lh-150" text="mainmenu.tagline" />
            <ui:VisualElement class="menu-actions">
                <ui:Button name="PlayButton" class="btn btn--primary btn--hero" text="menu.play"><ui:VisualElement class="ico ico--arrows btn__arrows" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="SideSettingsButton" class="btn btn--big menu-settings" text="menu.settings" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Спуск: пояснение фазы, шкала ступенями, фаза и счёт, список этапов, совет сервера, повтор после отказа (MenuLoaderPanel / MenuLoaderProgress) -->
        <ui:VisualElement name="LoaderContainer" class="menu-main descent is-hidden">
            <ui:VisualElement name="LoaderContent" class="descent__content">
                <ui:Label class="menu-title descent__title" text="mainmenu.descent_title" />
                <ui:Label name="LoaderExplain" class="descent-explain lh-150" />
                <ui:VisualElement class="descent-progress">
                    <ui:VisualElement class="meter-quant">
                        <ui:VisualElement name="LoaderProgressFill" class="meter-quant__fill" />
                    </ui:VisualElement>
                    <ui:VisualElement class="descent-meta">
                        <ui:Label name="LoaderPhaseLabel" class="descent-meta__phase" />
                        <ui:Label name="LoaderPhaseCount" class="descent-meta__count" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="LoaderPhaseList" class="phases" />
                <ui:Label name="LoaderTip" class="descent-tip lh-150 is-hidden" />
                <ui:Button name="RetryDescentButton" class="btn btn--primary btn--wide is-hidden" text="menu.retry_descent"><ui:VisualElement class="ico ico--arrows btn__arrows" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="CancelDescentButton" class="btn btn--wide" text="menu.cancel_descent" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Связь и выход: справа, по центру высоты -->
        <ui:VisualElement class="menu-rail">
            <ui:Button name="SideDiscordButton" class="rail-btn">
                <ui:VisualElement class="rail-btn__icon rail-btn__icon--discord" />
                <ui:Label class="rail-btn__label" text="Discord" />
            </ui:Button>
            <ui:Button name="SideTelegramButton" class="rail-btn">
                <ui:VisualElement class="rail-btn__icon rail-btn__icon--telegram" />
                <ui:Label class="rail-btn__label" text="Telegram" />
            </ui:Button>
            <ui:Button name="SideVkButton" class="rail-btn">
                <ui:VisualElement class="rail-btn__icon rail-btn__icon--vk" />
                <ui:Label class="rail-btn__label" text="mainmenu.vk" />
            </ui:Button>
            <ui:VisualElement class="rail-sep" />
            <ui:Button name="SideExitButton" class="rail-btn">
                <ui:VisualElement class="rail-btn__icon rail-btn__icon--exit" />
                <ui:Label class="rail-btn__label" text="menu.exit" />
            </ui:Button>
        </ui:VisualElement>

        <!-- Строка сборки: в сети, версия, сборка -->
        <ui:VisualElement class="menu-foot">
            <ui:VisualElement class="menu-meta menu-online">
                <ui:VisualElement class="menu-online__dot" />
                <ui:Label class="menu-meta__key caps" text="mainmenu.online" />
                <ui:Label name="MainMenuOnlineBadge" class="menu-meta__value" />
            </ui:VisualElement>
            <ui:VisualElement class="menu-meta">
                <ui:Label class="menu-meta__key caps" text="mainmenu.version_key" />
                <ui:Button name="FooterVersionButton" class="menu-meta__value menu-meta__link" text="" />
            </ui:VisualElement>
            <ui:VisualElement name="FooterBuild" class="menu-meta">
                <ui:Label class="menu-meta__key caps" text="mainmenu.build_key" />
                <ui:Label name="FooterBuildHash" class="menu-meta__value" />
                <ui:VisualElement name="FooterBuildBars" class="idcode" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
