<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="PauseOverlay" class="pause-overlay ui-overlay ui-overlay--modal">
        <ui:VisualElement name="Dimmer" class="pause-dimmer" />

        <ui:VisualElement name="MainPage" class="pause-panel pause-page">
            <ui:Label name="PauseTitle"  text="" class="pause-title" />
            <ui:ScrollView name="MainPageScroll" class="pause-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                <ui:Button name="ResumeButton"  text="" class="pause-btn" />
                <ui:Button name="SettingsButton"  text="" class="pause-btn" />
                <ui:Button name="MainMenuButton"  text="" class="pause-btn" />
                <ui:Button name="QuitButton"  text="" class="pause-btn" />
            </ui:ScrollView>
        </ui:VisualElement>

        <ui:VisualElement name="SettingsPage" class="pause-panel pause-page pause-settings">
            <ui:Label name="SettingsTitle"  text="" class="pause-title" />
            <ui:VisualElement class="settings-layout">
                <ui:VisualElement name="SettingsNavigation" class="settings-navigation">
                    <ui:Button name="GraphicsTab"  text="" class="settings-tab settings-tab--active" />
                    <ui:Button name="DisplayTab"  text="" class="settings-tab" />
                    <ui:Button name="EffectsTab"  text="" class="settings-tab" />
                    <ui:Button name="AudioTab"  text="" class="settings-tab" />
                    <ui:Button name="InterfaceTab"  text="" class="settings-tab" />
                    <ui:Button name="AdvancedTab"  text="" class="settings-tab settings-tab--advanced" />
                </ui:VisualElement>
                <ui:VisualElement name="SettingsContent" class="settings-content">
                    <ui:ScrollView name="GraphicsScroll" class="pause-scroll settings-page" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                        <ui:VisualElement name="GraphicsSection" class="settings-section">
                            <ui:Label class="settings-section__title" text="settings.graphics.section_title" />
                            <ui:Label class="settings-section__description" text="settings.graphics.section_desc" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                    <ui:ScrollView name="DisplayScroll" class="pause-scroll settings-page" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                        <ui:VisualElement name="DisplaySection" class="settings-section">
                            <ui:Label class="settings-section__title" text="settings.display.section_title" />
                            <ui:Label class="settings-section__description" text="settings.display.section_desc" />
                            <ui:VisualElement name="HDROutputGroup" class="pause-subsection">
                                <ui:Label class="pause-subsection-title" text="settings.display.hdr_output" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:ScrollView>
                    <ui:ScrollView name="EffectsScroll" class="pause-scroll settings-page" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                        <ui:VisualElement name="EffectsSection" class="settings-section settings-section--effects">
                            <ui:Label class="settings-section__title" text="settings.post_process.section_title" />
                            <ui:Label class="settings-section__description" text="settings.post_process.section_desc" />
                            <ui:VisualElement name="EffectsGroupBloom" class="pause-subsection">
                                <ui:Label class="pause-subsection-title" text="settings.post_process.glow" />
                            </ui:VisualElement>
                            <ui:VisualElement name="EffectsGroupCamera" class="pause-subsection">
                                <ui:Label class="pause-subsection-title" text="settings.post_process.camera_color" />
                                <ui:VisualElement class="pause-slider-container">
                                    <ui:Label name="PostProcessExposureLabel" class="pause-slider-label" text="settings.effects.exposure" />
                                    <ui:Slider name="PostProcessExposure" low-value="-2" high-value="2" />
                                </ui:VisualElement>
                                <ui:VisualElement class="pause-slider-container">
                                    <ui:Label name="PostProcessContrastLabel" class="pause-slider-label" text="settings.effects.contrast" />
                                    <ui:Slider name="PostProcessContrast" low-value="-0.5" high-value="0.5" />
                                </ui:VisualElement>
                                <ui:VisualElement class="pause-slider-container">
                                    <ui:Label name="PostProcessSaturationLabel" class="pause-slider-label" text="settings.effects.saturation" />
                                    <ui:Slider name="PostProcessSaturation" low-value="0" high-value="2" />
                                </ui:VisualElement>
                                <ui:VisualElement class="pause-slider-container">
                                    <ui:Label name="PostProcessWhitePointLabel" class="pause-slider-label" text="settings.effects.tone_mapping_white_point" />
                                    <ui:Slider name="PostProcessWhitePoint" low-value="0.25" high-value="8" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="EffectsGroupDetail" class="pause-subsection">
                                <ui:Label class="pause-subsection-title" text="settings.post_process.detail" />
                            </ui:VisualElement>
                            <ui:VisualElement name="EffectsGroupOptics" class="pause-subsection">
                                <ui:Label class="pause-subsection-title" text="settings.post_process.optical" />
                            </ui:VisualElement>
                            <ui:VisualElement name="EffectsGroupAtmosphere" class="pause-subsection">
                                <ui:Label class="pause-subsection-title" text="settings.post_process.atmosphere" />
                            </ui:VisualElement>
                            <ui:VisualElement name="EffectsGroupDisplay" class="pause-subsection">
                                <ui:Label class="pause-subsection-title" text="settings.post_process.display_physics" />
                            </ui:VisualElement>
                            <ui:VisualElement name="EffectsGroupTemporal" class="pause-subsection">
                                <ui:Label class="pause-subsection-title" text="Temporal" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:ScrollView>
                    <ui:ScrollView name="AudioScroll" class="pause-scroll settings-page" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                        <ui:VisualElement name="AudioSection" class="settings-section">
                            <ui:Label class="settings-section__title" text="settings.audio.section_title" />
                            <ui:Label class="settings-section__description" text="settings.audio.section_desc" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                    <ui:ScrollView name="InterfaceScroll" class="pause-scroll settings-page" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                        <ui:VisualElement name="InterfaceSection" class="settings-section">
                            <ui:Label class="settings-section__title" text="settings.interface.section_title" />
                            <ui:Label class="settings-section__description" text="settings.interface.section_desc" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                    <ui:ScrollView name="AdvancedScroll" class="pause-scroll settings-page" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                        <ui:Foldout name="AdvancedLightingSection" text="settings.lighting.section_title" value="true" class="settings-section settings-section--advanced">
                            <ui:VisualElement name="AdvancedGroupAmbient" class="pause-subsection">
                                <ui:Label class="pause-subsection-title" text="settings.lighting.ambient" />
                            </ui:VisualElement>
                            <ui:VisualElement name="AdvancedGroupDynamic" class="pause-subsection">
                                <ui:Label class="pause-subsection-title" text="settings.lighting.dynamic" />
                            </ui:VisualElement>
                            <ui:VisualElement name="AdvancedGroupExtinction" class="pause-subsection">
                                <ui:Label class="pause-subsection-title" text="settings.lighting.absorption" />
                            </ui:VisualElement>
                            <ui:VisualElement name="AdvancedGroupBounce" class="pause-subsection">
                                <ui:Label class="pause-subsection-title" text="settings.lighting.bounce" />
                            </ui:VisualElement>
                            <ui:VisualElement name="AdvancedGroupAO" class="pause-subsection">
                                <ui:Label class="pause-subsection-title" text="settings.lighting.ao" />
                            </ui:VisualElement>
                            <ui:VisualElement name="AdvancedGroupBounds" class="pause-subsection">
                                <ui:Label class="pause-subsection-title" text="settings.lighting.bounds" />
                            </ui:VisualElement>
                        </ui:Foldout>
                        <ui:VisualElement name="WorldMaterialsSection" class="settings-section settings-section--advanced">
                            <ui:Label class="settings-section__title" text="settings.world.section_title" />
                            <ui:Label class="settings-section__description" text="settings.world.section_desc" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="SettingsBack"  text="" class="pause-btn" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
