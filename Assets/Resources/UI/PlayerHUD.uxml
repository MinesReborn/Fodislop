<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="PlayerHUDRoot" class="hud-root" picking-mode="Ignore">

        <ui:VisualElement class="hud-top-pill-container" picking-mode="Ignore">
            <ui:VisualElement name="TopStatusPill" class="hud-top-pill" picking-mode="Position">
                <ui:Label name="BuildVersionLabel" class="hud-top-pill-version" text="" picking-mode="Ignore" />
                <ui:VisualElement class="hud-top-pill-divider" picking-mode="Ignore" />
                <ui:Label name="FPSCounterLabel" class="hud-top-pill-fps" text="" picking-mode="Ignore" />
                <ui:VisualElement class="hud-top-pill-divider" picking-mode="Ignore" />
                <ui:VisualElement name="AssetStatusPill" class="hud-top-pill-asset" picking-mode="Ignore">
                    <ui:VisualElement name="AssetStatusDot" class="hud-top-pill-dot" picking-mode="Ignore" />
                    <ui:Label name="AssetStatusLabel" class="hud-top-pill-asset-text" text="" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ════════════ ЕДИНАЯ ПАНЕЛЬ ИГРОКА (hud-panel): статус, валюта, корзина ════════════ -->
        <ui:VisualElement name="PlayerStatusPanel" class="hud-panel">
            <!-- Верхняя строка: Никнейм, Уровень, Клан -->
            <ui:VisualElement class="hud-title-row">
                <ui:Label name="NicknameLabel" class="hud-nickname" text="---" />
                <ui:Label name="LevelLabel" class="hud-level"  text="" />
                <ui:Button name="ClanButton" class="hud-clan-button" tooltip="hud.tooltip.clan" />
            </ui:VisualElement>

            <ui:VisualElement class="hud-separator" />

            <!-- Прочность (HP) -->
            <ui:VisualElement class="hud-hp-header">
                <ui:Label name="HPLabel" class="hud-stat"  text="" />
                <ui:Label name="HPPercentLabel" class="hud-stat-percent" text="100%" />
            </ui:VisualElement>
            <ui:VisualElement class="hud-hp-bar">
                <ui:VisualElement name="HPBarFill" class="hud-hp-fill" />
            </ui:VisualElement>

            <!-- Валюта -->
            <ui:Label name="MoneyLabel" class="hud-money" text="---" />
            <ui:Label name="CredsLabel" class="hud-creds" text="---" />
            <ui:Label name="GeologyLabel" class="hud-stat"  text="" />

            <ui:VisualElement class="hud-separator" />

            <!-- Корзина -->
            <ui:Label name="BasketPercentLabel" class="hud-basket"  text="" />
            <ui:VisualElement name="BasketContainer" class="hud-basket-container" />
        </ui:VisualElement>

        <!-- ════════════ СТАТУСНЫЕ ЛИНИИ (справа от панели игрока, под кнопкой бонуса) ════════════ -->
        <ui:VisualElement name="StatusPanel" class="hud-status-panel" style="display: none;" />

        <!-- ════════════ КНОПКА БОНУСА ════════════ -->
        <ui:Button name="BonusButton" class="hud-button-accent hud-bonus-button" text="hud.bonus" tooltip="hud.tooltip.bonus" />

        <!-- ════════════ ПАНЕЛЬ БОНУСОВ ════════════ -->
        <ui:VisualElement name="BonusPanel" class="hud-bonus-panel" style="display: none;">
            <ui:VisualElement class="hud-title-row">
                <ui:Label class="hud-stat" text="hud.bonus" />
                <ui:Button name="BonusCloseButton" class="hud-button-close" text="×" />
            </ui:VisualElement>
            <ui:Label name="BonusStatusLabel" class="hud-stat hud-stat-wrap"  text="" />
            <ui:Button name="BonusClaimButton" class="hud-button-claim" text="hud.bonus.claim" style="display: none;" />
        </ui:VisualElement>

        <!-- ════════════ ТУМБЛЕРЫ (снизу слева) ════════════ -->
        <ui:Button name="AutoDigButton" class="hud-button hud-toggle-btn hud-toggle-auto-dig" tooltip="hud.tooltip.autodig">
            <ui:VisualElement name="AutoDigIndicator" class="hud-mode-led" picking-mode="Ignore" />
            <ui:Label name="AutoDigLabel" class="hud-toggle-btn-label"  text="" picking-mode="Ignore" />
        </ui:Button>

        <ui:Button name="AggressionButton" class="hud-button hud-toggle-btn hud-toggle-aggression" tooltip="hud.tooltip.aggression">
            <ui:VisualElement name="AggressionIndicator" class="hud-mode-led" picking-mode="Ignore" />
            <ui:Label name="AggressionLabel" class="hud-toggle-btn-label"  text="" picking-mode="Ignore" />
        </ui:Button>

        <!-- ════════════ ЧАТ И ПРОГРАММАТОР (снизу слева) ════════════ -->
        <ui:Button name="ChatButton" class="hud-btn-action hud-chat-button" text="hud.chat" tooltip="hud.tooltip.chat" />
        <ui:Button name="ProgrammatorButton" class="hud-btn-action hud-programmator-button"  text="" />

        <!-- ════════════ КНОПКИ ВЕРХНЕГО РЯДА: РЕСПАВН / ЗДАНИЯ / FAQ ════════════ -->
        <ui:Button name="RespawnButton" class="hud-btn-action hud-btn-top-row hud-btn-top-row--respawn" text="hud.respawn" />
        <ui:Button name="BuildingsButton" class="hud-btn-action hud-btn-top-row hud-btn-top-row--buildings" text="hud.buildings" />
        <ui:Button name="FaqButton" class="hud-btn-action hud-btn-top-row hud-btn-top-row--faq" text="FAQ" />

        <!-- ════════════ НАВЫКИ И ПРОГРЕСС (справа снизу) ════════════ -->
        <ui:VisualElement name="SkillContainer" class="hud-skill-container" />

        <!-- ════════════ ТЕКУЩАЯ МИССИЯ (сверху по центру) ════════════ -->
        <ui:VisualElement name="MissionPanel" class="sci-fi-panel sci-fi-panel--tech hud-mission-panel" style="display: none;">
            <ui:VisualElement class="hud-mission-header">
                <ui:Label class="sci-fi-badge-gold" text="hud.mission_badge" />
                <ui:Label name="MissionTitleLabel" class="hud-mission-title" text="---" />
            </ui:VisualElement>
            <ui:Label name="MissionDescLabel" class="hud-mission-desc" text="---" />
            <ui:VisualElement class="sci-fi-bar-track hud-mission-track">
                <ui:VisualElement name="MissionProgressFill" class="sci-fi-bar-fill-cyan" />
            </ui:VisualElement>
            <ui:Label name="MissionProgressLabel" class="hud-mission-progress-text" text="0 / 0" />
        </ui:VisualElement>

        <!-- ════════════ КАРТА МИРА (WorldMapRenderer) ════════════ -->
        <ui:VisualElement name="WorldMapOverlay" class="world-map-overlay" picking-mode="Ignore" style="display: none;">
            <ui:Image name="WorldMapImage" class="world-map-image" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- ════════════ ПОПАПЫ ════════════ -->
        <!-- Респавн -->
        <ui:VisualElement name="RespawnPopup" class="popup-overlay">
            <ui:VisualElement class="popup-dimmer" picking-mode="Ignore" />
            <ui:VisualElement class="popup-panel">
                <ui:Label class="popup-title" text="hud.respawn" />
                <ui:VisualElement class="popup-btn-row">
                    <ui:Button name="RespawnConfirmButton" class="popup-btn" text="hud.ok" />
                    <ui:Button name="RespawnCancelButton" class="popup-btn" text="hud.back" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Мои здания -->
        <ui:VisualElement name="BuildingsPopup" class="popup-overlay">
            <ui:VisualElement class="popup-dimmer" picking-mode="Ignore" />
            <ui:VisualElement class="popup-panel">
                <ui:Label class="popup-title" text="hud.buildings" />
                <ui:Button name="BuildingsCloseButton" class="popup-close-btn" text="hud.close" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- FAQ -->
        <ui:VisualElement name="FaqPopup" class="popup-overlay">
            <ui:VisualElement class="popup-dimmer" picking-mode="Ignore" />
            <ui:VisualElement class="popup-panel">
                <ui:Label class="popup-title" text="FAQ" />
                <ui:Button name="FaqCloseButton" class="popup-close-btn" text="hud.close" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
