.packet-window-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--surface-scrim);
}

.packet-window-frame {
    max-width: 96%;
    max-height: 96%;
    min-width: 0;
    min-height: 0;
    padding: var(--space-6);
    background-color: var(--surface-panel);
    border-width: var(--border-width-thin);
    border-color: var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    overflow: hidden;
}

.packet-window-content {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
}

/* Белый крестик закрытия в правом верхнем углу окна: шлёт клик по индексу
   закрывающей кнопки ряда (PacketUI.ExitAction) — то же действие, что у
   видимой кнопки «ВЫЙТИ» и ESC. Крестик собран из двух повёрнутых полосок —
   вид не зависит от глифов шрифта. */
.packet-window-close {
    position: absolute;
    top: var(--radius-sharp);
    right: var(--radius-sharp);
    width: 22px;
    height: 22px;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: var(--radius-sm);
    background-color: transparent;
}

.packet-window-close:hover {
    background-color: var(--state-danger-wash);
}

.packet-window-close:active {
    background-color: var(--state-danger-glow);
}

.packet-window-close-bar {
    position: absolute;
    left: var(--radius-sm);
    top: var(--space-5);
    width: var(--space-6);
    height: var(--space-1);
    border-radius: 1px;
    background-color: var(--light-solid);
}

.packet-window-close-bar--a {
    rotate: 45deg;
}

.packet-window-close-bar--b {
    rotate: -45deg;
}

/* Кнопка действия — приём главного меню (mm-btn-outline): прозрачная,
   тонкая рамка, при наведении светлеет. Нижние кнопки окна («Продать всё»,
   «Продать») и кнопки списков выглядят как кнопки меню, а не дефолтные
   боксы Unity. */
.packet-window-action {
    min-height: 36px;
    padding: var(--space-3) var(--space-8);
    background-color: transparent;
    border-width: var(--border-width-thin);
    border-color: var(--border-subtle);
    border-radius: var(--radius-sharp);
    color: var(--text-primary);
    -unity-font-definition: var(--face-body);
    font-size: var(--size-base);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.packet-window-action:hover {
    background-color: var(--light-film);
    border-color: var(--light-solid);
    color: var(--light-solid);
}

/* Кнопка канваса: размер и позицию задаёт сервер через
   Canvas.X/Y/Width/Height, поэтому фикс-минимум и крупные отступы
   .packet-window-action сброшены — бокс обязан совпасть с сеткой
   координат автора канваса. */
.packet-window-action--canvas {
    min-height: 0;
    min-width: 0;
    padding: var(--space-1) var(--space-2);
    font-size: var(--size-sm);
    overflow: hidden;
}

.packet-scrollbar {
    background-color: var(--surface-shelf-solid);
}

.packet-scrollbar--vertical {
    width: var(--space-6);
    border-left-width: var(--border-width-thin);
    border-left-color: var(--border-subtle);
}

.packet-scrollbar--horizontal {
    height: var(--space-6);
    border-top-width: var(--border-width-thin);
    border-top-color: var(--border-subtle);
}

.packet-scrollbar .unity-slider__tracker {
    background-color: var(--surface-raised);
}

.packet-scrollbar .unity-slider__dragger {
    background-color: var(--border-cyan);
    border-color: var(--border-cyan);
}

.packet-scrollbar .unity-repeat-button {
    background-color: var(--surface-raised);
    color: var(--text-primary);
}

.packet-text--left { -unity-text-align: middle-left; }
.packet-text--center { -unity-text-align: middle-center; }
