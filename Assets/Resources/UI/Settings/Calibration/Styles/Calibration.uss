/* Калибровка дисплея — макет visual/kern-ui (css/screens.css .calib, systems.css, micro.css). Числа — по вычисленным
   стилям стенда. Фон прозрачный: под интерфейсом узор прохода вывода, вне узора он чёрный (как .calib { background: black }).
   Размеры узора (квадраты 78 % сцены, тройка по 22 %, сцена 16:7) ставит HDRCalibrationScreen по раскладке. */

.calib {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0);
    color: var(--bone);
}

.calib-top {
    height: 56px;
    flex-shrink: 0;
    padding: 0 12px 0 24px;
    flex-direction: row;
    align-items: center;
}

.calib-kicker {
    margin: 0 16px 0 0;
    padding: 0;
    -unity-font-definition: var(--face-mono);
    font-size: var(--t-small);
    -unity-font-style: normal;
    letter-spacing: 14px;
    color: var(--dim);
}

.calib-steps {
    flex-direction: row;
    margin-right: auto;
}

.calib-step-dot {
    width: 24px;
    height: 24px;
    margin: 0 6px 0 0;
    padding: 0;
    border-width: 1px;
    border-color: var(--seam);
    border-radius: 12px;
    -unity-text-align: middle-center;
    -unity-font-definition: var(--face-mono);
    font-size: var(--t-4);
    -unity-font-style: bold;
    color: var(--dim);
}

.calib-step-dot.is-done {
    border-color: var(--seam-strong);
    color: var(--bone);
}

.calib-step-dot.is-on {
    border-color: var(--bone);
    background-color: var(--bone);
    color: var(--void);
}

.calib-cancel {
    margin-left: auto;
    width: var(--hit);
    height: var(--hit);
}

.calib-cancel > .ico {
    -unity-background-image-tint-color: var(--ash);
}

.calib-stage {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.calib-pattern {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    display: none;
}

.calib-pattern.is-on {
    display: flex;
}

.calib-trio {
    flex-direction: row;
}

.calib-figure {
    align-items: center;
}

.calib-caption {
    margin: 12px 0 0 0;
    padding: 0;
    -unity-font-definition: var(--face-mono);
    font-size: var(--t-1);
    -unity-font-style: bold;
    letter-spacing: 14px;
    color: var(--dim);
}

/* Сцена белой точки: мир, карточка робота и лист бумаги (1.4 : 1, зазор 16) */
.calib-scene {
    flex-direction: row;
}

.calib-world {
    flex-grow: 1.4;
    flex-basis: 0;
    margin-right: 16px;
    background-color: rgb(58, 42, 26); /* --calib-sand */
    background-image: url("project://database/Assets/Textures/Cells/Sand/Yellow/YellowSand.png");
    background-size: 32px 32px;
    background-repeat: repeat repeat;
}

.calib-side {
    flex-grow: 1;
    flex-basis: 0;
}

/* Строки сетки макета: лишняя высота делится поровну, карточка прижата к низу своей строки */
.calib-card-row {
    flex-grow: 1;
    justify-content: flex-end;
    margin-bottom: 16px;
}

.calib-card {
    padding: 12px 14px;
    border-width: 1px;
    border-color: var(--seam);
    background-color: var(--graphite);
}

.calib-card__name {
    margin: 0 0 6px 0;
    padding: 0;
    -unity-font-definition: var(--face-display);
    font-size: var(--t-10);
    -unity-font-style: bold;
    color: var(--bone);
}

.calib-hp {
    height: 8px;
    margin-bottom: 6px;
    flex-direction: row;
    background-color: var(--well);
}

.calib-hp__cell {
    width: 5%;
    height: 8px;
    border-right-width: 2px;
    border-color: var(--graphite-solid);
    background-color: rgb(168, 230, 60); /* --calib-hp */
}

.calib-hp__cell.is-empty {
    background-color: rgba(0, 0, 0, 0);
}

.calib-card__money {
    margin: 0;
    padding: 0;
    -unity-font-definition: var(--face-mono);
    font-size: var(--t-6);
    color: rgb(126, 224, 160); /* --money */
}

.calib-paper {
    flex-grow: 1;
}

.calib-foot {
    flex-shrink: 0;
    padding: 12px 24px 20px;
    align-items: center;
}

.calib-title {
    margin: 0 0 8px 0;
    padding: 0;
    -unity-font-definition: var(--face-display);
    font-size: var(--t-12);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--bone);
}

.calib-text {
    max-width: 560px;
    margin: 0 0 8px 0;
    padding: 0;
    font-size: var(--t-6);
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--ash);
}

.calib-slider {
    width: 560px;
    height: var(--hit);
    margin: 6px 0 8px 0;
    flex-direction: row;
    align-items: center;
}

.calib-step {
    width: var(--hit);
    height: var(--hit);
    flex-shrink: 0;
    margin: 0;
    border-width: 1px;
    border-color: var(--seam);
    font-size: var(--t-11);
    color: var(--ash);
}

.calib-range {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 8px;
}

.calib-value {
    min-width: 84px;
    margin: 0 0 0 8px;
    padding: 0;
    -unity-font-definition: var(--face-mono);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: var(--bone);
}

.calib-actions {
    width: 560px;
    margin-top: 4px;
    flex-direction: row;
}

.calib-actions > .btn {
    height: var(--hit);
    min-width: 120px;
    margin-left: 8px;
}

.calib-actions > .calib-reset {
    margin-left: 0;
}

.calib-spacer {
    flex-grow: 1;
}
