/* ═══════════════════════════════════════════════════════════
   PauseMenu — стили меню паузы
   ═══════════════════════════════════════════════════════════ */

/* Затемнение под окном поверх игры — как .dialog-layer макета visual/kern-ui: scrim и точки сетки 16 */
.pause-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: var(--scrim-strong);
    --dots-color: rgba(216, 213, 238, 0.09);
    --dots-step: 16;
    --dots-size: 1;
}

/* Пауза на ПК (макет #menuDialog .dialog.pause): окно 320, заголовок, три клавиши во всю ширину */
.dialog.pause {
    width: 320px;
    padding: 20px 20px 16px;
    flex-direction: column;
    align-items: stretch;
}

.dialog.pause > .dialog__title {
    margin-bottom: 12px;
}

.pause-action {
    height: var(--hit);
    margin-bottom: 12px;
}

#MainMenuButton {
    margin-bottom: 0;
}



.pause-confirm-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--surface-inset);
    align-items: center;
    justify-content: center;
}

.pause-confirm-panel {
    background-color: var(--surface-panel);
    border-width: var(--border-width-thin);
    border-color: var(--border-cyan);
    border-radius: var(--radius-md);
    padding: var(--space-9) var(--space-13);
    flex-direction: column;
    align-items: center;
    min-width: 300px;
}

.pause-confirm-title {
    font-size: var(--size-lg);
    -unity-font-style: bold;
    color: var(--accent-gold);
    margin-bottom: var(--space-6);
}

.pause-confirm-desc {
    font-size: var(--size-md);
    color: var(--text-primary);
    white-space: normal;
    margin-bottom: var(--space-9);
    -unity-text-align: middle-center;
}

.pause-confirm-buttons {
    flex-direction: row;
    justify-content: center;
}

.pause-btn-confirm {
    background-color: var(--state-danger-glow);
    border-width: var(--border-width-thin);
    border-color: var(--state-magma-glow);
    border-radius: var(--radius-sm);
    padding: var(--space-4) var(--space-9);
    min-width: 100px;
    color: var(--text-primary);
    font-size: var(--size-md);
    -unity-text-align: middle-center;
    margin-right: var(--space-5);
}

.pause-btn {
    background-color: var(--surface-raised);
    border-width: var(--border-width-thin);
    border-color: var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-4) var(--space-9);
    min-width: 180px;
    margin-bottom: var(--space-5);
    color: var(--text-primary);
    font-size: var(--size-md);
    -unity-text-align: middle-center;
}

.pause-btn:hover {
    background-color: var(--accent-cyan-wash);
}
