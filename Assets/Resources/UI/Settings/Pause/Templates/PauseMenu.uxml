<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="PauseOverlay" class="pause-overlay ui-overlay">
        <!-- Пауза на ПК (макет visual/kern-ui #menuDialog): «Продолжить», «Настройки», «Выход в меню».
             Настройки — отдельное окно, общее с главным меню (Settings/Window/Templates/SettingsWindow.uxml). -->
        <ui:VisualElement name="MainPage" class="panel dialog pause">
            <ui:Label name="PauseTitle" text="" class="dialog__title caps" />
            <ui:Button name="ResumeButton" text="" class="btn btn--primary pause-action"><ui:VisualElement class="ico ico--arrows btn__arrows" picking-mode="Ignore" /></ui:Button>
            <ui:Button name="SettingsButton" text="" class="btn pause-action" />
            <ui:Button name="MainMenuButton" text="" class="btn pause-action" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
