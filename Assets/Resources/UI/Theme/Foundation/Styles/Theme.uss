/* Kern Theme */

:root {
    -unity-font-definition: var(--face-text);
    --cell-size: 50px;
    --icon-size: 36px;
}

/* ─── Шрифт текста по умолчанию — Onest (макет visual/kern-ui: --font-text). Внутренние элементы полей
       и переключателей наследуют его же; заголовки и числа назначают Exo 2 и JetBrains Mono классом ─── */
Label,
Button,
TextField,
.unity-text-element,
.unity-label,
.unity-button {
    -unity-font-definition: var(--face-text);
}

/* ─── Полноэкранный root-контейнер UXML-клонов ─── */
.ui-fullscreen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
}

.ui-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
}

.ui-overlay--modal {
    align-items: center;
    justify-content: center;
    background-color: var(--surface-inset);
}

.ui-panel {
    flex-direction: column;
    min-height: 0;
    min-width: 0;
    flex-shrink: 1;
    background-color: var(--surface-panel);
    border-color: var(--border-subtle);
    border-width: var(--border-width-thin);
    border-radius: var(--radius-md);
    padding: var(--space-6);
}

.ui-panel--modal {
    width: 70%;
    max-width: 520px;
    max-height: 85%;
}

.ui-scroll-viewport {
    width: 100%;
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.ui-scroll-viewport {
    overflow: hidden;
}

.ui-actions-row {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: center;
}

/* ═══════════════════════════════════════════════════════════
   ГЛАВНОЕ МЕНЮ (MAIN MENU) & LAUNCHER DESIGN SYSTEM
   ═══════════════════════════════════════════════════════════ */

.mm-root {
    flex-grow: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    /* Как .viewport в макете: планета и тени уходят за край, а не растягивают
       корень. Без этого крупные абсолютные элементы вылезают наружу панели. */
    overflow: hidden;

    /* Прозрачный: небо теперь рисует MenuDisplayBackdropCamera позади UI-оверлея.
       Непрозрачный фон здесь полностью закрыл бы её. PanelSettings не чистит
       цвет (m_ClearColor: 0), поэтому камера видна везде, где UI прозрачен. */
    background-color: transparent;
    /* Локальная палитра меню — тоже алиасы семантического слоя.
       mm-dim становится светлее прежнего rgb(90,107,124): тот давал
       контраст 3.2:1 и не проходил порог читаемости для мелкого текста. */
}

.mm-user-name {
    -unity-font-definition: var(--face-body);
    color: var(--light-solid);
    font-size: var(--size-base);
    -unity-font-style: bold;
}

.mm-user-rank {
    -unity-font-definition: url("project://database/Assets/Resources/Fonts/JetBrainsMono/JetBrainsMono_SDF.asset");
    color: var(--accent-gold);
    font-size: var(--size-2xs);
}

/* ── Правая боковая панель (8 кнопок) ── */
.mm-sidebar {
    position: absolute;
    right: var(--space-6);
    top: 90px;
    flex-direction: column;
    align-items: center;
}

/* Сервер недоступен: тот же бейдж в мягком красном — офлайн не должен
   выглядеть как рабочее соединение. */
.mm-server-badge--offline {
    background-color: var(--state-danger-wash);
    color: var(--state-danger);
    border-color: var(--state-danger-glow);
}

.mm-loader-progress-track {
    width: 100%;
    height: var(--radius-sm);
    background-color: var(--border-line);
    border-radius: var(--radius-sharp);
    overflow: hidden;
    margin-bottom: var(--space-4);
}

.mm-loader-phase-label--error {
    color: var(--state-danger);
    white-space: normal;
}

.mm-loader-phase-item {
    flex-direction: row;
    color: var(--text-tertiary);
    font-size: var(--size-base);
    margin-bottom: var(--space-3);
}

.mm-loader-phase-icon {
    width: var(--space-9);
    color: var(--text-tertiary);
}

.mm-loader-phase-item--done {
    color: var(--text-secondary);
}
.mm-loader-phase-item--done .mm-loader-phase-icon {
    color: var(--accent-cyan);
}
.mm-loader-phase-item--active {
    color: var(--light-solid);
}
.mm-loader-phase-item--active .mm-loader-phase-icon {
    color: var(--accent-gold);
}

.mm-ticker-text {
    -unity-font-definition: var(--face-body);
    color: var(--text-primary);
    font-size: var(--size-xs);
    overflow: hidden;
    white-space: nowrap;
    /* Обрезка без многоточия обрывает строку на полубукве и молчит об этом. */
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
    min-width: 0;
}

/* ── Настройки (2 колонки) ── */
.mm-settings-layout {
    flex-direction: row;
    /* Нижний предел, а не жёсткая высота: в макете колонка растёт под
       содержимое, а фиксированные 380px обрезали длинные разделы. */
    min-height: 480px;
    overflow: hidden;
}

.mm-profile-name {
    -unity-font-definition: var(--face-display);
    color: var(--light-solid);
    font-size: var(--size-lg);
    -unity-font-style: bold;
}

.mm-profile-clan {
    -unity-font-definition: var(--face-data);
    color: var(--accent-cyan);
    font-size: var(--size-xs);
    margin-top: var(--space-1);
}
