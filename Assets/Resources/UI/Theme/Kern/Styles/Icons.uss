/* Значки макета visual/kern-ui (SVG-спрайт index.html, <symbol id="i-…">) — векторные картинки Icons/Hud/<имя>.svg.
   Сгенерировано выгрузкой значков; руками не править. Цвет — -unity-background-image-tint-color (белый SVG). */

.ico {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ash);
}

.ico--arrows { background-image: resource("UI/Theme/Kern/Icons/Hud/arrows"); }
.ico--autodig { background-image: resource("UI/Theme/Kern/Icons/Hud/autodig"); }
.ico--box { background-image: resource("UI/Theme/Kern/Icons/Hud/box"); }
