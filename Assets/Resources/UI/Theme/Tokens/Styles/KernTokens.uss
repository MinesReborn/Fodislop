/* ФАЙЛ МАШИННЫЙ. Правки будут затёрты.
   Источник истины: visual/kern-ui/css/tokens.css → visual/kern-brand/tokens/export/tokens.uss (build-tokens.mjs).
   Генератор: tools/generators/Kern.DesignSystem emit-uss-tokens; --check сверяет файл с макетом.
   Что не переносится переменной (каналы палитры, тени, узоры, срезы, слои) — список в шапке tokens.uss. */
:root {
    /* color */
    --black: #000000; /* фон кадра и калибровки, тень отбивки */
    --white: #ffffff; /* цифра на значке, ядро метки на карте */
    --void: #06050a; /* самый тёмный слой: фон экранов вне игры, поле страниц бренда */
    --well-solid: #0a090f; /* непрозрачное углубление: поле ввода вне HUD */
    --graphite-solid: #111018; /* непрозрачный корпус панели вне HUD */
    --plate-solid: #1a1825; /* непрозрачная клавиша вне HUD */
    --well: #0a090f; /* углубление: полосы, поле ввода, клетка */
    --graphite: #111018; /* корпус панели */
    --plate: #1a1825; /* поле внутри панели, кнопка */
    --plate-hover: #242135; /* клавиша под курсором */
    --seam: #322f46; /* волосяная рамка */
    --seam-strong: #4a4668; /* рамка клавиши и поля, засечка нажимаемого */
    --seam-soft: rgba(50, 47, 70, 0.6); /* разделитель на фоне сцены */
    --float: rgba(17, 16, 24, 0.9); /* плашка: подсказка, служебная строка */
    --tag: rgba(10, 9, 15, 0.84); /* ярлык на мире и карте */
    --tag-soft: rgba(10, 9, 15, 0.62); /* ярлык поверх миникарты */
    --scrim: rgba(6, 5, 10, 0.62); /* затемнение под окном */
    --scrim-strong: rgba(6, 5, 10, 0.78); /* затемнение под окном поверх игры */
    --track-strong: rgba(139, 135, 166, 0.28); /* пустая часть тонкой шкалы */
    --scroll-track: rgba(216, 213, 238, 0.05); /* дорожка полосы прокрутки */
    --scroll-thumb: #6c6889; /* бегунок полосы прокрутки */
    --bone: #d8d5ee; /* основной */
    --mist: #b4b0d2; /* подпись под иконкой, пояснение */
    --ash: #8b87a6; /* вторичный */
    --dim: #6c6889; /* служебный: индексы, метки микрографики */
    --smoke: #575372; /* третичный, неактивный */
    --signal: #ff5a1f; /* главное действие и тревога — одно на окно */
    --signal-hover: #ff7a45; /* главное действие под курсором */
    --signal-soft: rgba(255, 90, 31, 0.14); /* подложка выбранного в списке чата и программатора */
    --signal-wash: rgba(255, 90, 31, 0.07); /* фон выбранной вкладки */
    --signal-line: rgba(255, 90, 31, 0.5); /* рамка выделенного */
    --signal-pressed: #2b1209; /* главное действие нажато */
    --on-signal: #160602; /* текст на сигнальной кнопке */
    --cobalt: #6270ff; /* ссылка на место: метка здания на карте */
    --danger: #ff3f6a; /* ошибка и разрушительное действие */
    --danger-hover: #ff6587; /* разрушительное действие под курсором */
    --ok: #7ee0a0; /* успех, деньги */
    --ok-soft: rgba(126, 224, 160, 0.16); /* подложка успеха */
    --live: #7bdc7e; /* в сети, свои, прибыль */

    /* size */
    --t-0: 8px; /* ступень 0 шкалы кеглей */
    --t-1: 9px; /* ступень 1 шкалы кеглей */
    --t-2: 10px; /* ступень 2 шкалы кеглей */
    --t-3: 11px; /* ступень 3 шкалы кеглей */
    --t-4: 12px; /* ступень 4 шкалы кеглей */
    --t-5: 13px; /* ступень 5 шкалы кеглей */
    --t-6: 14px; /* ступень 6 шкалы кеглей */
    --t-7: 15px; /* ступень 7 шкалы кеглей */
    --t-8: 16px; /* ступень 8 шкалы кеглей */
    --t-9: 17px; /* ступень 9 шкалы кеглей */
    --t-10: 18px; /* ступень 10 шкалы кеглей */
    --t-11: 20px; /* ступень 11 шкалы кеглей */
    --t-12: 22px; /* ступень 12 шкалы кеглей */
    --t-13: 24px; /* ступень 13 шкалы кеглей */
    --t-14: 28px; /* ступень 14 шкалы кеглей */
    --t-15: 32px; /* ступень 15 шкалы кеглей */
    --t-16: 48px; /* ступень 16 шкалы кеглей */
    --t-17: 60px; /* ступень 17 шкалы кеглей */
    --t-small: 13px; /* подписи */
    --t-body: 15px; /* значения, строки чата */
    --t-strong: 17px; /* ник, заголовок окна */
    --t-title: 22px; /* заголовок окна */

    /* font */
    --fw-normal: 400; /* обычный текст */
    --fw-semi: 500; /* подписи, кнопки */
    --fw-bold: 600; /* заголовки, выбранное */
    --fw-heavy: 700; /* название, крупные заголовки */

    /* size */
    --sp-1: 2px; /* 1 × шаг 2 px */
    --sp-2: 4px; /* 2 × шаг 2 px */
    --sp-3: 6px; /* 3 × шаг 2 px */
    --sp-4: 8px; /* 4 × шаг 2 px */
    --sp-5: 10px; /* 5 × шаг 2 px */
    --sp-6: 12px; /* 6 × шаг 2 px */
    --sp-7: 14px; /* 7 × шаг 2 px */
    --sp-8: 16px; /* 8 × шаг 2 px */
    --sp-9: 18px; /* 9 × шаг 2 px */
    --sp-10: 20px; /* 10 × шаг 2 px */
    --sp-11: 22px; /* 11 × шаг 2 px */
    --sp-12: 24px; /* 12 × шаг 2 px */
    --sp-14: 28px; /* 14 × шаг 2 px */
    --sp-16: 32px; /* 16 × шаг 2 px */
    --sp-18: 36px; /* 18 × шаг 2 px */
    --sp-20: 40px; /* 20 × шаг 2 px */
    --gap: 8px; /* зазор между соседними блоками */
    --margin: 24px; /* поле экрана */
    --col: 264px; /* левая колонка — одна ширина для всех блоков */
    --r-round: 50%; /* круг — только круглое по смыслу: навык, стик, кнопки геймпада */
    --ctl-xs: 28px; /* малая кнопка-иконка, чип */
    --ctl-s: 32px; /* ячейка иконки */
    --ctl-m: 36px; /* строка-кнопка и поле на мыши, колпачок клавиши */
    --ctl-l: 40px; /* поле чата, крупная иконка */
    --hit: 44px; /* минимальная цель касания */
    --ctl-xl: 48px; /* системная кнопка, широкая кнопка, шапка окна на телефоне */
    --ctl-xxl: 64px; /* слот инвентаря, портрет робота */
    --row: 36px; /* роль: строка-кнопка; на таче — --hit */
    --notch: 10px; /* срез правого верхнего угла панели */
    --tick: 6px; /* засечка-уголок */

    /* color */
    --tick-c: rgba(216, 213, 238, 0.55); /* цвет засечек */

    /* motion */
    --ease: ease-out; /* одна кривая для всех плавных переходов */
    --dur-fast: 0.08s; /* отклик: наведение, тон нажатия, перескок бегунка, закрытие окна */
    --dur: 0.12s; /* появление окна: линия рамки разворачивается в окно */
    --dur-slow: 0.2s; /* смена экрана через базальт, сдвиг HUD под чат */
    --step: 0.02s; /* шаг кванта: одна ячейка шкалы, одна точка прочности */
    --count: 0.25s; /* досчёт числа до нового значения */
    --flash: 0.12s; /* одна вспышка тревоги; тревога — две вспышки и ровный цвет */

    /* font */
    --face-display: url("project://database/Assets/Resources/Fonts/Exo2/Exo2_SDF.asset"); /* заголовки, название, ник */
    --face-text: url("project://database/Assets/Resources/Fonts/Onest/Onest_SDF.asset"); /* текст, подписи, кнопки */
    --face-mono: url("project://database/Assets/Resources/Fonts/JetBrainsMono/JetBrainsMono_SDF.asset"); /* числа, координаты, метки */
}
