   Расхождение ловит CI. */
:root {
    --space-1: 2px;
    --space-2: 4px;
    --space-3: 6px;
    --space-4: 8px;
    --space-5: 10px;
    --space-6: 12px;
    --space-7: 14px;
    --space-8: 16px;
    --space-9: 20px;
    --space-10: 24px;
    --space-11: 28px;
    --space-12: 32px;
    --space-13: 40px;
    --space-14: 48px;
    --border-width-thin: 1px;
    --border-width-strong: 2px;
    --border-width-bold: 3px;
    --radius-sharp: 3px;
    --radius-sm: 5px;
    --radius-md: 7px;
    --radius-pill: 50%;
    --modal-sm: 640px;
    --modal-md: 700px;
    --modal-lg: 800px;
    --modal-xl: 920px;
    --face-display: url("project://database/Assets/Resources/Fonts/Unbounded/Unbounded_SDF.asset");
    --face-body: url("project://database/Assets/Resources/Fonts/Exo2/Exo2_SDF.asset");
    --face-data: url("project://database/Assets/Resources/Fonts/JetBrainsMono/JetBrainsMono_SDF.asset");
    --size-micro: 9px;
    --size-2xs: 10px;
    --size-xs: 11px;
    --size-sm: 12px;
    --size-base: 13px;
    --size-md: 15px;
    --size-lg: 18px;
    --size-xl: 24px;
    --size-2xl: 32px;
    --size-3xl: 42px;
    --safe-screen: 48px;
    --safe-panel: 24px;
    --safe-box: 12px;
    --safe-tight: 6px;
    --leading-tight: 1.15;
    --leading-base: 1.4;
    --leading-loose: 1.6;
    --tracking-tight: 0;
    --weight-regular: 400;
    --weight-medium: 500;
    --weight-bold: 700;
    --weight-black: 800;
    --dur-instant: 0.1s;
    --dur-fast: 0.12s;
    --dur-base: 0.15s;
    --dur-slow: 0.2s;
    --dur-deliberate: 0.4s;
    --dur-cinematic: 0.8s;
    --ease-standard: ease;
    --ease-linear: linear;
    --ease-decelerate: ease-out-cubic;
    --ease-signature: ease-out-circ  /* подбор fit-easing.py, max-отклонение 0.129 */;
    --order-corona: 1;
    --order-orbit: 2;
    --order-planet: 3;
    --order-beacon: 10;
    --order-surface: 1;
    --order-magma: 2;
    --order-geogrid: 3;
    --order-night: 4;
    --order-atmosphere: 5;
    --order-target: 6;
    --order-mine-canvas: 1;
    --order-mine-robot: 5;
    --order-bead: 2;
    --blur-sm: 6px;
    --blur-md: 10px;
    --blur-lg: 16px;
    --blur-xl: 24px;
    --menu-column: 500px;
    --planet-disc: 860px;
    --menu-action-width: 380px;
    --accent-cyan-dense: rgba(100, 205, 221, 0.85);
    --accent-cyan-fill: rgba(100, 205, 221, 0.55);
    --accent-cyan-glow: rgba(100, 205, 221, 0.3);
    --accent-cyan-solid: rgb(100, 205, 221);
    --accent-cyan-tint: rgba(100, 205, 221, 0.08);
    --accent-cyan-wash: rgba(100, 205, 221, 0.12);
    --accent-gold-fill: rgba(236, 193, 99, 0.55);
    --accent-gold-glow: rgba(236, 193, 99, 0.3);
    --accent-gold-tint: rgba(236, 193, 99, 0.08);
    --accent-gold-wash: rgba(236, 193, 99, 0.12);
    --state-anomaly-glow: rgba(168, 85, 247, 0.4);
    --state-anomaly-wash: rgba(168, 85, 247, 0.15);
    --state-danger-glow: rgba(255, 85, 85, 0.4);
    --state-danger-wash: rgba(255, 85, 85, 0.15);
    --state-magma-tint: rgba(255, 122, 54, 0.08);
    --state-magma-glow: rgba(255, 122, 54, 0.4);
    --state-ok-tint: rgba(74, 222, 128, 0.08);
    --surface-abyss-dense: rgba(10, 19, 30, 0.9);
    --surface-abyss-solid: rgb(10, 19, 30);
    --surface-abyss-veil: rgba(10, 19, 30, 0.6);
    --surface-crisis-dense: rgba(16, 3, 3, 0.9);
    --surface-crisis-solid: rgb(16, 3, 3);
    --surface-ember-solid: rgb(26, 18, 6);
    --surface-shelf-dense: rgba(24, 42, 60, 0.9);
    --surface-shelf-solid: rgb(24, 42, 60);
    --surface-slate-dense: rgba(16, 29, 43, 0.9);
    --surface-slate-solid: rgb(16, 29, 43);
    --surface-slate-veil: rgba(16, 29, 43, 0.6);
    --surface-void-dense: rgba(5, 10, 17, 0.9);
    --surface-void-haze: rgba(5, 10, 17, 0.2);
    --surface-void-shade: rgba(5, 10, 17, 0.5);
    --surface-void-solid: rgb(5, 10, 17);
    --surface-void-veil: rgba(5, 10, 17, 0.6);
    --border-hairline: rgba(137, 184, 205, 0.08);
    --border-line: rgba(137, 184, 205, 0.15);
    --light-edge: rgba(255, 255, 255, 0.45);
    --light-film: rgba(255, 255, 255, 0.06);
    --light-gleam: rgba(255, 255, 255, 0.7);
    --light-sheen: rgba(255, 255, 255, 0.12);
    --light-solid: rgb(255, 255, 255);
    --shadow-solid: rgb(0, 0, 0);
    --surface-void: #050a11;
    --surface-solid: #0d1925;
    --surface-panel: rgba(10, 19, 30, 0.9);
    --surface-raised: rgba(16, 29, 43, 0.6);
    --surface-sunken: rgba(5, 10, 17, 0.6);
    --surface-inset: rgba(5, 10, 17, 0.5);
    --surface-scrim: rgba(5, 10, 17, 0.9);
    --border-subtle: rgba(137, 184, 205, 0.08);
    --border-strong: rgba(137, 184, 205, 0.15);
    --border-cyan: rgba(100, 205, 221, 0.55);
    --border-gold: rgba(236, 193, 99, 0.55);
    --border-danger: rgba(255, 85, 85, 0.4);
    --text-primary: #eef5f8;
    --text-secondary: #a3b5bf;
    --text-tertiary: #8298a5;
    --text-disabled: #526979;
    --text-on-gold: #07111a;
    --surface-on-accent: #07111a;
    --accent-gold: #ecc163;
    --accent-gold-hover: #f6d28a;
    --accent-cyan: #64cddd;
    --accent-cyan-hover: #9be3ed;
    --accent-cyan-deep: #2a7787;
    --state-ok: #4ade80;
    --state-warn: #ff7a36;
    --state-danger: #ff5555;
    --state-danger-hover: #ff7b7b;
    --state-anomaly: #a855f7;
    --state-ok-wash: rgba(74, 222, 128, 0.08);
    --state-warn-wash: rgba(255, 122, 54, 0.08);
    --rarity-common: #a3b5bf;
    --rarity-uncommon: #4ade80;
    --rarity-rare: #64cddd;
    --rarity-epic: #a855f7;
    --rarity-legendary: #ecc163;
    --focus-ring-color: #9be3ed;
    --focus-ring-width: 2px;
    --focus-ring-offset: 2px;
}

/* Тир задаётся классом на корневом элементе. */
.tier--compact {
    --size-md: 14px;
    --size-lg: 16px;
    --size-xl: 20px;
    --size-2xl: 26px;
    --size-3xl: 32px;
    --space-10: 20px;
    --space-11: 22px;
    --space-12: 24px;
    --space-13: 28px;
    --space-14: 32px;
    --planet-disc: 520px;
}

/* Тир задаётся классом на корневом элементе. */
