/* ═══════════════════════════════════════════════════════════
   Modal — стили модальных окон
   ═══════════════════════════════════════════════════════════ */

.modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--surface-inset);
    align-items: center;
    justify-content: center;
}

.modal-title {
    -unity-font-definition: var(--face-display);
    font-size: var(--size-lg);
    color: var(--accent-gold);
    margin-bottom: var(--space-6);
    -unity-text-align: middle-center;
}

/* ─── Тултип ─── */

.tooltip-panel {
    position: absolute;
    background-color: var(--surface-slate-dense);
    border-width: var(--border-width-thin);
    border-color: var(--text-disabled);
    padding: var(--space-3) var(--space-5);
    max-width: 250px;
}

.tooltip-label {
    font-size: var(--size-sm);
    color: var(--light-solid);
    white-space: normal;
}

/* ═══════════════════════════════════════════════════════════
   Индикатор загрузки ассетов (AssetLoadingIndicator.uxml)

   У классов .loadind-* не было стилей ни в одном файле проекта: разметка
   существовала, но выводилась дефолтным оформлением UI Toolkit — белый
   текст в левом верхнем углу без фона. Приведено к языку системы.
   ═══════════════════════════════════════════════════════════ */

.loadind-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.loadind-overlay {
    position: absolute;
    right: var(--space-9);
    bottom: var(--space-9);
    min-width: 260px;
    padding: var(--space-6) var(--space-8);
    background-color: var(--surface-panel);
    border-width: var(--border-width-thin);
    border-color: var(--border-cyan);
    border-radius: var(--radius-sm);
    flex-direction: column;
}

.loadind-title {
    -unity-font-definition: var(--face-data);
    font-size: var(--size-xs);
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--accent-cyan);
    margin-bottom: var(--space-3);
}

/* Крутится через C#: @keyframes в USS нет. */
.loadind-spinner {
    position: absolute;
    right: var(--space-8);
    top: var(--space-6);
    font-size: var(--size-md);
    color: var(--accent-cyan);
}

.loadind-status {
    -unity-font-definition: var(--face-body);
    font-size: var(--size-sm);
    color: var(--text-secondary);
    white-space: normal;
    margin-bottom: var(--space-2);
}

.loadind-progress {
    -unity-font-definition: var(--face-data);
    font-size: var(--size-2xs);
    color: var(--text-tertiary);
}
