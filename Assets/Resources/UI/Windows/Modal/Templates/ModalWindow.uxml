<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Сообщение сервера (ModalWindowPacket) — макет visual/kern-ui (#srvModal, css/events.css .srv-modal):
         картинка, заголовок, текст и подпись кнопки приходят из пакета. -->
    <ui:VisualElement name="ModalOverlay" class="dialog-layer is-hidden" picking-mode="Ignore">
        <ui:VisualElement name="ModalPanel" class="panel dialog srv-modal">
            <ui:VisualElement name="ModalIcon" class="srv-modal-icon is-hidden" />
            <ui:Label name="ModalTitle" class="dialog__title" />
            <ui:Label name="ModalDesc" class="dialog__text" />
            <ui:VisualElement class="dialog-actions">
                <ui:Button name="ModalOkButton" class="btn btn--primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
