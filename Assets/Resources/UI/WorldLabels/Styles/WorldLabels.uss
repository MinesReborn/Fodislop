.world-labels {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.world-label-name, .world-label-chat {
    position: absolute;
    left: 0;
    top: 0;
}

/* Метка уходит с экрана, но продолжает раскладываться.
 *
 * Скрывать через display:none нельзя: элемент выпадает из раскладки, ширина и
 * высота становятся NaN, и посчитать привязку по нижнему центру больше нечем.
 * Снять скрытие мог только ApplyVisible, а он выходил раньше, по
 * неизвестному размеру, — метка застревала скрытой навсегда, и переиспользованный
 * из пула пузырь не показывал сообщение никогда.
 *
 * visibility:hidden элемент раскладывается, поэтому повторный показ всегда знает
 * свой размер. Побочных эффектов на раскладку нет: метки position:absolute, в
 * поток не входят. Общий UIState.SetHidden с display:none не тронут.
 */
.world-label-offscreen {
    visibility: hidden;
}

/* Ник над роботом — макет visual/kern-ui (css/events.css .wl-name): 13 px, полужирный, отбивка тенью вниз */
.world-label-nickname {
    -unity-font-definition: var(--face-text);
    font-size: var(--t-5);
    -unity-font-style: bold;
    color: var(--bone);
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.9);
    margin: 0;
    padding: 0;
    white-space: nowrap;
    -unity-text-align: upper-left;
    transform-origin: 0% 0%;
}

/* Облако локального чата — макет (css/events.css .wl-chat, systems.css): рамка seam-strong,
   плотный графит, поля 2/6, строка 12 px высотой 16; под рамкой хвост — черта 1×6 в 5 px от левого края.
   Масштаб по зуму — style.scale на рамке от левого верхнего угла; якорь — нижний конец хвоста (WorldLabels.Entry). */
.world-label-chat {
    position: absolute;
    left: 0;
    top: 0;
    align-items: flex-start;
    padding: 2px 6px;
    border-width: 1px;
    border-color: var(--seam-strong);
    background-color: rgba(17, 16, 24, 0.92);
    transform-origin: 0% 0%;
}

/* Текст обрезается по ширине, а не переносится: облако — одна строка */
.world-label-chat-text {
    height: 16px;
    margin: 0;
    padding: 0;
    -unity-font-definition: var(--face-text);
    font-size: var(--t-4);
    -unity-font-style: normal;
    color: var(--bone);
    -unity-text-align: middle-left;
    -unity-text-overflow-position: end;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    max-width: 360px;
}

.world-label-chat__tail {
    position: absolute;
    left: 4px;
    top: 100%;
    width: 1px;
    height: 6px;
    background-color: var(--seam-strong);
}
