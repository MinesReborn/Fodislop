    <Compile Include="../../Assets/Scripts/World/Common/CoordinateUtils.cs" Link="Game/CoordinateUtils.cs" />
    <Compile Include="../../Assets/Scripts/World/Terrain/Mesh/TerrainVertex.cs" Link="Game/TerrainVertex.cs" />
    <Compile Include="../../Assets/Scripts/World/Terrain/Mesh/TerrainCellGeometry.cs" Link="Game/TerrainCellGeometry.cs" />
    <Compile Include="../../Assets/Scripts/World/Terrain/Mesh/TerrainPrecalculator.cs" Link="Game/TerrainPrecalculator.cs" />
