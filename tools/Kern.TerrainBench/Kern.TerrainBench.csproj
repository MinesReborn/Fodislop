<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Стиль проверяется в Unity и линтером; здесь чужие файлы игры собираются только ради замеров. -->
    <RunAnalyzers>false</RunAnalyzers>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ScriptAssemblies>../../Library/ScriptAssemblies</ScriptAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Данные сервера: Unity собирает их сам, ссылаются только на mscorlib. -->
    <Reference Include="MinesServer.Data">
      <HintPath>$(ScriptAssemblies)/MinesServer.Data.dll</HintPath>
    </Reference>
    <Reference Include="MinesServer.Networking">
      <HintPath>$(ScriptAssemblies)/MinesServer.Networking.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Настоящие файлы игры, без копий: бенчмарк меряет тот же код. -->
    <Compile Include="../../Assets/Scripts/Core/Interfaces/Contracts/ProjectRuntimeContracts.cs" Link="Game/ProjectRuntimeContracts.cs" />
    <Compile Include="../../Assets/Scripts/Core/Interfaces/Contracts/Settings/TerrainSettings.cs" Link="Game/TerrainSettings.cs" />
    <Compile Include="../../Assets/Scripts/Core/Configuration/Contracts/SettingAttributes.cs" Link="Game/SettingAttributes.cs" />
