<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AnalysisLevel>none</AnalysisLevel>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>kern-archlint</ToolCommandName>
    <PackageId>Kern.ArchitectureLinter</PackageId>
    <Version>1.0.0</Version>
    <Authors>Kern</Authors>
    <Description>Kern architecture linter — forbidden API, dead members, settings wiring, localization, USS, shader invariants.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/...</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <PropertyGroup>
    <UnityManagedPath Condition="Exists('/Applications/Unity/Hub/Editor/6000.6.0f1')">/Applications/Unity/Hub/Editor/6000.6.0f1/Unity.app/Contents/Resources/Scripting/Managed</UnityManagedPath>
    <UnityManagedPath Condition="Exists('/Applications/Unity/Hub/Editor/6000.6.0f1') AND '$(UnityManagedPath)' == ''">/Applications/Unity/Hub/Editor/6000.6.0f1/Unity.app/Contents/Resources/Scripting/Managed</UnityManagedPath>
    <DefineConstants Condition="'$(UnityManagedPath)' != ''">$(DefineConstants);KERN_SETTINGS_PROBE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(UnityManagedPath)' != ''">
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManagedPath)/UnityEngine/UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(UnityManagedPath)/UnityEngine/UnityEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.ScriptingModule">
      <HintPath>$(UnityManagedPath)/UnityEngine/UnityEngine.ScriptingModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UnityManagedPath)' != ''">
    <Compile Include="..\..\..\Assets\Scripts\Core\Configuration\Contracts\Schema\SettingAttributes.cs" />
    <Compile Include="..\..\..\Assets\Scripts\Core\Configuration\Contracts\Schema\SettingSchema.cs" />
    <Compile Include="..\..\..\Assets\Scripts\Infrastructure\Audio\Contracts\Mixing\AudioBusRegistry.cs" />
    <Compile Include="..\..\..\Assets\Scripts\Infrastructure\Audio\Contracts\Mixing\AudioLayer.cs" />
    <Compile Include="..\..\..\Assets\Scripts\World\Lighting\Quality\Contracts\LightingQualityMode.cs" />
    <Compile Include="..\..\..\Assets\Scripts\World\Lighting\Quality\Contracts\LightingQualityTuning.cs" />
    <Compile Include="..\..\..\Assets\Scripts\Rendering\Display\Contracts\Quality\GraphicsQualitySettings.cs" />
    <Compile Include="..\..\..\Assets\Scripts\World\Rendering\Contracts\Grid\RenderingConstants.cs" />
    <Compile Include="..\..\..\Assets\Scripts\World\Rendering\Contracts\Grid\PixelGrid.cs" />
    <Compile Include="..\..\..\Assets\Scripts\World\Rendering\Contracts\Sampling\PixelSamplingMode.cs" />
    <Compile Include="..\..\..\Assets\Scripts\World\Coordinates\Contracts\Grid\WorldGridDefaults.cs" />
    <Compile Include="..\..\..\Assets\Scripts\Core\Configuration\Contracts\Client\ClientConfig.cs" />
    <Compile Include="..\..\..\Assets\Scripts\Core\Configuration\Contracts\Management\IClientConfigManager.cs" />
    <Compile Include="..\..\..\Assets\Scripts\Core\Configuration\Contracts\Settings\*.cs" />
    <Compile Include="..\..\..\Assets\Scripts\Game\Rendering\Entities\Contracts\Coverage\WorldRenderConfigHolder.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SettingsProbe\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(UnityManagedPath)' != ''">
    <Compile Include="SettingsProbe\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\architecture-rules.html" Pack="true" PackagePath="docs\architecture-rules.html" />
  </ItemGroup>

</Project>
