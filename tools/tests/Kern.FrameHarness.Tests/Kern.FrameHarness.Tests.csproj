<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/Scripts/Diagnostics/Memory/Process/ProcessMemorySnapshot.cs" Link="ProcessMemorySnapshot.cs" />
    <Compile Include="../../../Assets/Scripts/Diagnostics/Memory/Allocations/MemoryAllocationGuard.cs" Link="MemoryAllocationGuard.cs" />
    <Compile Include="../../../Assets/Scripts/World/Lighting/Resources/Layout/LightingAllocationEstimate.cs" Link="LightingAllocationEstimate.cs" />
    <Compile Include="../../../Assets/Scripts/Rendering/WorldGrid/Contracts/WorldRenderGrid.cs" Link="WorldRenderGrid.cs" />
    <Compile Include="../../../Assets/Scripts/Rendering/PostProcessing/Pipeline/Data/PostProcessWorkload.cs" Link="PostProcessWorkload.cs" />
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
    </Reference>
    <Compile Include="../../../Assets/Scripts/Diagnostics/World/Frames/Telemetry/FrameTelemetry.cs" Link="FrameTelemetry.cs" />
    <Compile Include="../../../Assets/Scripts/Diagnostics/World/Frames/Telemetry/IFrameTelemetryProducerStamp.cs" Link="IFrameTelemetryProducerStamp.cs" />
    <Compile Include="../../../Assets/Scripts/Diagnostics/World/TextureUploads/Counters/TerrainTextureUploadCounters.cs" Link="TerrainTextureUploadCounters.cs" />
    <Compile Include="../../../Assets/Scripts/Diagnostics/World/TextureUploads/Capture/TerrainTextureUploadCaptureFields.cs" Link="TerrainTextureUploadCaptureFields.cs" />
    <ProjectReference Include="../../harness/Kern.FrameHarness/Kern.FrameHarness.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
