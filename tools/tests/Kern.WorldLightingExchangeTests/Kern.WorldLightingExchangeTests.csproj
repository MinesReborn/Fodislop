<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RunAnalyzers>false</RunAnalyzers>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <UnityRoot>../../../Assets/Scripts</UnityRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="VContainer">
      <HintPath Condition="Exists('../../../Library/ScriptAssemblies/VContainer.dll')">../../../Library/ScriptAssemblies/VContainer.dll</HintPath>
      <HintPath Condition="!Exists('../../../Library/ScriptAssemblies/VContainer.dll')">../../lib/VContainer.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath Condition="Exists('../../../Library/ScriptAssemblies/UnityEngine.CoreModule.dll')">../../../Library/ScriptAssemblies/UnityEngine.CoreModule.dll</HintPath>
      <HintPath Condition="!Exists('../../../Library/ScriptAssemblies/UnityEngine.CoreModule.dll')">../../lib/UnityEngine.CoreModule.dll</HintPath>
      <Aliases>UnityEngineRuntime</Aliases>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(UnityRoot)/World/Lighting/Exchange/Contracts/TerrainLightingContracts.cs" Link="Production/TerrainLightingContracts.cs" />
    <Compile Include="$(UnityRoot)/Bootstrap/WorldLighting/Exchange/TerrainLightingExchange.cs" Link="Production/TerrainLightingExchange.cs" />
    <Compile Include="$(UnityRoot)/World/Lighting/Exchange/Consumption/TerrainLightingChangePump.cs" Link="Production/TerrainLightingChangePump.cs" />
    <Compile Include="$(UnityRoot)/World/Lighting/Exchange/Consumption/TerrainLightingFramePump.cs" Link="Production/TerrainLightingFramePump.cs" />
    <Compile Include="$(UnityRoot)/World/Lighting/Exchange/Consumption/TerrainLightingChangeApplier.cs" Link="Production/TerrainLightingChangeApplier.cs" />
    <Compile Include="$(UnityRoot)/World/Lighting/Runtime/Invalidation/LightingRuntimeInvalidation.cs" Link="Production/LightingRuntimeInvalidation.cs" />
    <Compile Include="$(UnityRoot)/World/Lighting/Runtime/State/LightingRuntimeState.cs" Link="Production/LightingRuntimeState.cs" />
    <Compile Include="$(UnityRoot)/World/Lighting/Fields/AmbientOcclusion/LightingAmbientOcclusionUpdatePolicy.cs" Link="Production/LightingAmbientOcclusionUpdatePolicy.cs" />
    <Compile Include="$(UnityRoot)/Tests/Editor/World/Lighting/Fields/AmbientOcclusion/LightingAmbientOcclusionUpdatePolicyTests.cs" Link="Tests/LightingAmbientOcclusionUpdatePolicyTests.cs" />
    <Compile Include="$(UnityRoot)/World/Lighting/Fields/Regions/LightingRegionCalculator.cs" Link="Production/LightingRegionCalculator.cs" />
    <Compile Include="$(UnityRoot)/World/Lighting/Runtime/Invalidation/LightingRegionInvalidationPolicy.cs" Link="Production/LightingRegionInvalidationPolicy.cs" />
    <Compile Include="$(UnityRoot)/World/Lighting/Quality/Control/LightingQualityTransitionPolicy.cs" Link="Production/LightingQualityTransitionPolicy.cs" />
    <Compile Include="$(UnityRoot)/World/Lighting/Quality/Contracts/LightingQualityMode.cs" Link="Production/LightingQualityMode.cs" />
    <Compile Include="$(UnityRoot)/Core/Configuration/Contracts/Schema/SettingAttributes.cs" Link="Production/SettingAttributes.cs" />
    <Compile Include="$(UnityRoot)/World/Streaming/Planning/StreamingPolicy.cs" Link="Production/StreamingPolicy.cs" />
    <Compile Include="$(UnityRoot)/World/Terrain/Exchange/Viewport/TerrainLightingViewportPolicy.cs" Link="Production/TerrainLightingViewportPolicy.cs" />
    <Compile Include="$(UnityRoot)/World/Terrain/Exchange/Publication/TerrainContentRevisionJournal.cs" Link="Production/TerrainContentRevisionJournal.cs" />
    <Compile Include="$(UnityRoot)/Tests/Editor/Bootstrap/WorldLighting/Exchange/TerrainLightingExchangeTests.cs" Link="Tests/TerrainLightingExchangeTests.cs" />
    <Compile Include="$(UnityRoot)/Tests/Editor/World/Lighting/Quality/Control/LightingQualityTransitionPolicyTests.cs" Link="Tests/LightingQualityTransitionPolicyTests.cs" />
    <Compile Include="$(UnityRoot)/Tests/Editor/World/Terrain/Exchange/Publication/TerrainContentRevisionJournalTests.cs" Link="Tests/TerrainContentRevisionJournalTests.cs" />
  </ItemGroup>
</Project>
